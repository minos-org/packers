#!/bin/sh
#boot an ISO's live session in QEMU with KVM as a machine boots it, from a CD or from the ISO written to a
#USB stick, and use it as a person would: GRUB's menu boots its entry on its own, and once i3 is up (minos'
#wallpaper on the screen) a terminal (Win+Enter) runs a probe from a second CD as root (the live user's
#sudo asks no password). The probe writes on the serial port, as "probe: " lines in the format ci/verdict
#reads, what the live session says about itself: the boot (firmware, Secure Boot, kernel), the display (the
#card's driver, its modes), where the medium and its squashfs are mounted, what slim waited for, the plugins
#the image brought; then what every minos system must show, ci/probe-common, which the CD carries beside it
#(the network and whether names resolve, sudo, tmux, i3's configuration, slim, the units that failed).
#Then the installer's key opens its window, and how long its first screen takes to show is read off the
#screen; and, the desktop bare again, a click on the wallpaper opens the menu of the background, "Install
#minos" its first row, whose row Enter takes, and another menu, whose second row a click takes. A watcher
#the probe leaves behind says what shows (the installer's window, a terminal, the menu with its entries
#and its place), and the lines for ci/verdict.
#usage: [CABLE=no] live-check ISO FIRMWARE MEDIUM OUTPUT [MINUTES]
#  FIRMWARE    bios (SeaBIOS), uefi (OVMF) or secureboot (OVMF with Secure Boot on, Microsoft's keys)
#  MEDIUM      cd or usb
#  CABLE=no    the network card's cable out from power on: NAME gets -nocable, and nothing must wait for it
#  => in OUTPUT, for NAME=FIRMWARE-MEDIUM: NAME.serial.log (the probe) and the screen at GRUB's menu, on the
#     desktop, the probe's terminal, the installer's (Win+i: its first screen as it shows, and settled),
#     the menu and what its rows opened: NAME-{menu,desktop,terminal,installer-first,installer,
#     background-menu,menu-enter,menu-pointer,menu-click}.png; exit 0 when the
#     desktop came up within MINUTES (10), the probe found an address and resolved a name (no cable: none),
#     with secureboot Secure Boot was on, Win+i opened the installer, a click on the wallpaper opened the menu
#     with "Install minos" first, Enter on it opened the installer and a click on its Terminal a terminal
#needs qemu-system-x86_64, KVM, socat, xorriso and netpbm (pngtopnm, pnmtopng, pamfile, pamcut, pamchannel,
#pamsumm); OVMF
#for uefi and secureboot

set -eu
iso="${1:-}"; firmware="${2:-}"; medium="${3:-}"; out="${4:-}"; minutes="${5:-10}"
if [ ! -f "${iso}" ] || [ -z "${medium}" ] || [ -z "${out}" ]; then sed -n '14,23s/^#//p' "${0}" >&2; exit 2; fi
cable="${CABLE:-yes}"
name="${firmware}-${medium}"; [ "${cable}" = yes ] || name="${name}-nocable"

_die() { #message => on stderr, exit 1
    printf "%s\\n" "live-check: ${name}: ${*}" >&2
    exit 1
}

_step() { #message => one line on stdout, with the seconds since the start
    printf "%5ss  %s\\n" "$(($(date +%s) - start))" "${*}"
}

# shellcheck source=iso/qemu-lib
. "$(dirname "${0}")/qemu-lib"

_write_probe() { #dir => DIR/probe.iso, a CD labelled PROBE that carries the probe and ci/probe-common
    mkdir -p "${1}/probe"
    cp "$(dirname "${0}")/../ci/probe-common" "${1}/probe/probe-common" || _die "no ci/probe-common beside iso/"
    cat > "${1}/probe/probe" << 'E=O=F'
#!/bin/sh
#live-check's probe, run as root in the live session: what it says about itself, on the serial port as
#"probe: " lines in ci/verdict's format; first what a live session alone shows, then probe-common
_say() { printf "probe: %-34s %s\n" "${1}" "${2}" > /dev/ttyS0; }
hz="$(getconf CLK_TCK)"; btime="$(awk '$1 == "btime" {print $2}' /proc/stat)"
#the 22nd field of stat, the start in ticks since the kernel started; the 2nd may hold spaces
i3_start="$(($(cut -d')' -f2 "/proc/$(pgrep -o -x i3)/stat" | awk '{print $20}') / hz))"
_say "i3 started" "${i3_start} s after the kernel, at $((btime + i3_start)) (epoch); uptime $(cut -d' ' -f1 /proc/uptime) s"
secure="off"
for var in /sys/firmware/efi/efivars/SecureBoot-*; do
    [ -f "${var}" ] && [ "$(od -An -t u1 "${var}" | awk '{print $NF}')" = 1 ] && secure="on"
done
_say "firmware" "$([ -d /sys/firmware/efi ] && printf uefi || printf bios), Secure Boot ${secure}; $(dmesg | grep -m 1 -o 'Secure boot [a-z]*')"
_say "kernel command line" "$(wc -l < /proc/modules) modules loaded; $(cat /proc/cmdline)"
#the display: the drivers of virtual machines' cards the ISO carries (iso/build's _modules_wanted), where
#modprobe finds them; then each card's driver and the modes its outputs offer: the firmware's framebuffer
#(simple-framebuffer) has the one it was left in, a card's own driver has more. A driver renamed between
#kernels is a list of its names, the first one modprobe finds is said (cirrus became cirrus-qemu in 7.0)
drivers=""; missing=""
for names in vmwgfx vboxvideo virtio-gpu bochs hyperv_drm qxl cirrus,cirrus-qemu; do
    found=""
    for module in $(printf "%s" "${names}" | tr ',' ' '); do
        [ -n "${found}" ] || [ ! -f "$(modinfo -n "${module}" 2>/dev/null)" ] || found="${module}"
    done
    if [ -n "${found}" ]; then drivers="${drivers} ${found}"; else missing="${missing} ${names}"; fi
done
_say "display" "drivers${drivers}${missing:+, missing${missing}}; $(for card in /sys/class/drm/card[0-9]; do printf "%s %s, %s modes; " "${card##*/}" "$(basename "$(readlink "${card}/device/driver")")" "$(cat "${card}/${card##*/}"-*/modes 2>/dev/null | sort -u | wc -l)"; done)fb: $(tr '\n' ' ' < /proc/fb); X: $(grep -o -m 3 -E '(modeset|fbdev|vesa)\([0-9]\): [^,]*' /var/log/Xorg.0.log | tr '\n' ' ')"
_say "medium" "$(awk '$3 == "iso9660" || $3 == "squashfs" || $2 == "/" || $2 == "/cdrom" {printf "%s on %s (%s), ", $1, $2, $3}' /proc/mounts)"
_say "loops" "$(losetup -l -n -O NAME,BACK-FILE 2>/dev/null | tr '\n' ' ' | tr -s ' ')"
_say "root written (MiB)" "$(df -m / | awk 'NR == 2 {print $3}')"
#what slim waited for, the unit it started after first: a network that never comes would show here
_say "slim's chain" "$(systemd-analyze critical-chain slim.service 2>/dev/null | sed -n '/^slim\.service/,$p' | sed 's/^[^a-zA-Z]*//' | head -n 6 | paste -sd ',' - | sed 's/,/ <- /g')"
_say "live user" "$(id minos)"
#the vim, tmux and shell plugins of the live user, each manager among its own, and what minos-core-settings'
#login hook did about them: it marks a module once it has installed it, and a mark older than this session
#came with the image
installing=""
for module in vim tmux shundle; do
    mark="/home/minos/.minos/plugins/${module}"
    { [ -f "${mark}" ] && [ "$(stat -c %Y "${mark}")" -lt "$((btime + i3_start))" ]; } || installing="${installing} ${module}"
done
_say "plugins" "vim $(ls /home/minos/.vim/bundle 2>/dev/null | wc -l), tmux $(ls /home/minos/.tmux/plugins 2>/dev/null | wc -l), shundle $(ls /home/minos/.shundle/bundle 2>/dev/null | wc -l); login hook: $([ -z "${installing}" ] && printf "nothing to install" || printf "the image brought no%s" "${installing}")"
#what every minos system shows; probe-common waits up to a minute for an address and a name, since the
#desktop may come up before the lease (with no cable, the minute goes by)
sh "$(dirname "${0}")/probe-common" desktop minos > /tmp/probe-common 2>&1
sed 's/^/probe: /' /tmp/probe-common > /dev/ttyS0
if ! grep -q '^dns  *archive\.ubuntu\.com [0-9a-f:.][0-9a-f:.]* after' /tmp/probe-common; then
    networkctl list --no-legend 2>&1 | while read -r line; do _say "networkctl" "${line}"; done
    connmanctl services 2>&1 | while read -r line; do _say "connman" "${line}"; done
    journalctl -b -u systemd-networkd --no-pager -q -o short-monotonic | tail -n 25 |
        while read -r line; do _say "networkd" "${line}"; done
fi
journalctl -b -p err --no-pager -q | tail -n 10 | while read -r line; do _say "journal error" "${line}"; done
#what the check opens next is said as it shows, by a watcher that stays once this terminal is gone
setsid sh "$(dirname "${0}")/watch" < /dev/null > /dev/null 2>&1 &
_say "done" ""
E=O=F
    cat > "${1}/probe/watch" << 'E=O=F'
#!/bin/sh
#live-check's watcher: what shows on the desktop, said on the serial port when it changes, as "watch: "
#lines: the menu of the background, the installer's window, or a terminal (urxvt's window on the screen,
#the installer's aside). The menu's script is there while the menu is open, with the entries it was given, in their order
#(minos-menu, which m-menu, the name i3 calls, becomes), and rofi draws them: once both are there, the line
#ci/verdict reads, "menu of the background". Each time the menu shows, where rofi drew it on which screen,
#"watch: menu at WxH+X+Y of WxH", for a click on one of its rows
export DISPLAY=":0" XAUTHORITY="/home/minos/.Xauthority"
_terminal_shows() { #=> true when a terminal's window is on the screen: urxvt's, the installer's aside, and
    #not the one the session keeps hidden in i3's scratchpad, which is not mapped
    for window in $(xdotool search --onlyvisible --class '^URxvt$' 2>/dev/null); do
        xprop -id "${window}" WM_CLASS 2>/dev/null | grep -q '"minos-installer"' || return 0
    done
    return 1
}
last=""; told=""
while :; do
    now="nothing"
    pid="$(pgrep -o -f '/(m|minos)-menu ')"
    if [ -n "${pid}" ]; then
        now="menu"
        entries="$(tr '\0' '\n' < "/proc/${pid}/cmdline" 2>/dev/null | grep ' | ')"
        if [ -z "${told}" ] && pgrep -x rofi > /dev/null; then
            printf "probe: %-34s %s\n" "menu of the background" \
                "$(printf "%s\n" "${entries}" | grep -c .) entries, the first: $(printf "%s\n" "${entries}" | head -n 1); drawn by rofi" > /dev/ttyS0
            told="yes"
        fi
    elif pgrep -f 'urxvt -name minos-installer' > /dev/null; then
        now="installer"
    elif _terminal_shows; then
        now="terminal"
    fi
    [ "${now}" = "${last}" ] || { printf "watch: %s\n" "${now}" > /dev/ttyS0; last="${now}"; }
    if [ "${now}" = "menu" ] && [ "${pid}" != "${placed:-}" ]; then
        #rofi's window, a child of the root, once it is mapped (drawn at its size): its size and place are
        #the last two words but one of its line in the tree
        window="$(xwininfo -root -tree 2>/dev/null | awk '/\("rofi" "Rofi"\)/ {print $1, $(NF - 1); exit}')"
        geometry="${window#* }"
        if [ -n "${window}" ] && xwininfo -id "${window%% *}" 2>/dev/null | grep -q 'Map State: IsViewable'; then
            printf "watch: menu at %s of %s\n" "${geometry}" \
                "$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')" > /dev/ttyS0
            placed="${pid}"
        fi
    fi
    sleep 1
done
E=O=F
    xorriso -report_about WARNING -as mkisofs -V PROBE -J -r -o "${1}/probe.iso" "${1}/probe" 2>/dev/null ||
        _die "cannot write the probe's CD"
}

case "${firmware}" in
    bios) machine="q35"; firmware_options="" ;;
    uefi) machine="q35"
          firmware_options="-drive if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.fd"
          vars="/usr/share/OVMF/OVMF_VARS_4M.fd" ;;
    #Secure Boot needs the firmware's own memory (SMM) and its flash locked to it
    secureboot) machine="q35,smm=on"
          firmware_options="-global driver=cfi.pflash01,property=secure,value=on"
          firmware_options="${firmware_options} -drive if=pflash,format=raw,unit=0,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd"
          vars="/usr/share/OVMF/OVMF_VARS_4M.ms.fd" ;;
    *) _die "the firmware is bios, uefi or secureboot" ;;
esac
#the ISO is never written: snapshot=on keeps a stick's writes in a temporary file
case "${medium}" in
    cd)  medium_options="-drive if=none,id=boot,media=cdrom,readonly=on,format=raw,file=${iso} -device ide-cd,drive=boot,bus=ide.0,bootindex=0" ;;
    usb) medium_options="-drive if=none,id=boot,snapshot=on,format=raw,file=${iso} -device qemu-xhci -device usb-storage,drive=boot,removable=on,bootindex=0" ;;
    *) _die "the medium is cd or usb" ;;
esac
[ -c /dev/kvm ] || _die "no /dev/kvm"
mkdir -p "${out}"; out="$(cd "${out}" && pwd)"
run="$(mktemp -d)"; qemu=""
trap '[ -z "${qemu}" ] || kill "${qemu}" 2>/dev/null; rm -rf "${run}"' EXIT
trap 'exit 143' INT TERM HUP
start="$(date +%s)"
serial="${out}/${name}.serial.log"; rm -f "${serial}" "${out}/${name}"-*.png
_write_probe "${run}"
if [ "${firmware}" != bios ]; then
    cp "${vars}" "${run}/vars.fd"
    firmware_options="${firmware_options} -drive if=pflash,format=raw,unit=1,file=${run}/vars.fd"
fi

#the medium, the probe on the next SATA port, a network card, the serial port to a file
_step "booting the live session of $(basename "${iso}") (${firmware}, ${medium})"
# shellcheck disable=SC2086 # lists of options
qemu-system-x86_64 -enable-kvm -machine "${machine}" -cpu host -smp 2 -m 4096 ${firmware_options} ${medium_options} \
    -drive "if=none,id=probe,media=cdrom,readonly=on,format=raw,file=${run}/probe.iso" -device ide-cd,drive=probe,bus=ide.1 \
    -netdev user,id=net0 -device virtio-net-pci,netdev=net0,id=nic0 -vga std -display none -serial "file:${serial}" \
    -monitor "unix:${run}/monitor,server,nowait" -qmp "unix:${run}/qmp,server,nowait" -no-reboot -daemonize -pidfile "${run}/qemu.pid" -S
qemu="$(cat "${run}/qemu.pid")"
#the machine waits, stopped, for the cable to be pulled out or left in
[ "${cable}" = yes ] || _monitor "set_link nic0 off" >/dev/null
_monitor cont >/dev/null
#GRUB's menu boots its entry after 5 s: the firmware is through in a few
sleep 4
_screen menu
until _on_desktop; do
    kill -0 "${qemu}" 2>/dev/null || _die "the machine stopped"
    [ "$(($(date +%s) - start))" -lt "$((minutes * 60))" ] || { _screen timeout; _die "no desktop after ${minutes} min"; }
    sleep 2
done
_step "the desktop"
_screen desktop
#a terminal (Win+Enter), and in it the probe. The wallpaper may be painted before i3 takes the keyboard:
#a while first, and the terminal asked for again when the probe says nothing. Its first line says the
#terminal opened; its end may take minutes more (probe-common waits a minute for a network, which with
#no cable never comes), and is waited for apart: a slow probe is not a terminal that never opened
sleep 10
for _try in 1 2 3; do
    _press meta_l-ret
    sleep 5
    _type "sudo mount -r -L PROBE /mnt; sudo sh /mnt/probe"
    _press ret
    if _wait_serial "probe: " 60; then
        _wait_serial "probe: done" 300 || { _screen probe; _die "the probe began and did not end in 5 minutes"; }
        break
    fi
    _screen "probe-${_try}"
    [ "${_try}" != 3 ] || _die "the probe said nothing"
done
_screen terminal
#the installer's key, Win+i: its window, floating in the middle of the screen. How long a person looks at
#that window before its first screen is in it is read off the screen itself, kept again and again from
#the key on: its middle is dark (the probe's terminal, then the installer's window, empty; the pointer is
#all there is on it) until the installer draws. It is the first time the session opens the installer, with
#nothing of it read from the medium yet: the slowest a person meets
_middle_lit() { #file => how lit the middle of the screen kept in FILE (PPM) is, the sum of its points: 700
    #by 460 of them, inside the installer's window, which i3 centres above its bar, and clear of the
    #cursor a terminal shows in its first cell
    pamcut -left "$(( (screen_width - 700) / 2 ))" -width 700 -top "$(( (screen_height - 460) / 2 - 10 ))" \
        -height 460 "${1}" 2>/dev/null | pamsumm -sum -brief 2>/dev/null | cut -d. -f1
}
_now_ms() { #=> the time now, in milliseconds
    printf "%s" "$(($(date +%s%N) / 1000000))"
}
_first_screen() { #key => first_screen, the milliseconds from KEY, pressed here, to the first screen kept that
    #has the installer's in its middle, which was dark; "none in 10000" when it stays dark for ten seconds.
    #The screens are kept as QEMU has them, PPM: nothing to pack and unpack, so a look takes a few
    #hundredths of a second and the time read is that close
    _monitor "screendump ${run}/first.ppm" >/dev/null
    # shellcheck disable=SC2046 # the width and the height
    set -- "${1}" $(pamfile "${run}/first.ppm" 2>/dev/null | sed 's/.* \([0-9]*\) by \([0-9]*\) .*/\1 \2/')
    screen_width="${2:-0}"; screen_height="${3:-0}"
    _first_screen__dark="$(_middle_lit "${run}/first.ppm")"
    [ "${_first_screen__dark:-1000000}" -lt 200000 ] ||
        _die "the middle of the screen is not dark before the installer's key: ${_first_screen__dark:-not read}"
    _monitor "sendkey ${1}" >/dev/null
    _first_screen__key="$(_now_ms)"; _first_screen__looks=0; first_screen="none in 10000"
    while :; do
        _monitor "screendump ${run}/first.ppm" >/dev/null
        #the time once the screen is kept: the installer's was there by then
        _first_screen__at="$(($(_now_ms) - _first_screen__key))"; _first_screen__looks="$((_first_screen__looks + 1))"
        _first_screen__lit="$(_middle_lit "${run}/first.ppm")"
        if [ "${_first_screen__lit:-0}" -gt "$((_first_screen__dark + 500000))" ]; then
            first_screen="${_first_screen__at}"
            pnmtopng "${run}/first.ppm" > "${out}/${name}-installer-first.png" 2>/dev/null
            break
        fi
        [ "${_first_screen__at}" -lt 10000 ] || break
    done
    _step "the installer's first screen: ${first_screen} ms after its key (${_first_screen__looks} looks at the screen, $(($(_now_ms) - _first_screen__key)) ms)"
}
_first_screen meta_l-i
_wait_serial "watch: installer" 30 || { _screen installer; _die "Win+i opened no installer"; }
sleep 5
_screen installer
#the menu of the background. The installer is left and the terminal too, so the wallpaper is bare; a click
#on it, where the pointer has been all along, opens the menu, which on the ISO has "Install minos" as its
#first row: the watcher says what its script was given, and where rofi drew it. Then a row is taken twice,
#as a person takes one: Enter takes the row rofi marks, the first, and the installer's window opens; left
#again, a second menu, and a click on its second row, Terminal, opens a terminal. The machine's pointer is
#absolute (QEMU's vmmouse): the monitor's mouse_move never moves it, _point does (iso/qemu-lib)
_watch_last() { #=> the serial log's last "watch: " line
    grep '^watch: ' "${serial}" | tail -n 1 | tr -d '\r'
}
_installer_leave() { #=> the installer's window closed: q (this machine has no disk, and the screen that says
    #so closes on it; where it has one, q asks and y answers)
    _press q
    sleep 3
    [ "$(_watch_last)" != "watch: installer" ] || _press y
    _installer_leave__waited=0
    while [ "$(_watch_last)" = "watch: installer" ]; do
        _installer_leave__waited="$((_installer_leave__waited + 1))"
        [ "${_installer_leave__waited}" -le 15 ] || { _screen background-menu; _die "the installer did not close on q"; }
        sleep 1
    done
}
_bare() { #=> true when the wallpaper is bare, within 30 s: nothing on it, the sun in the middle
    _bare__waited=0
    until [ "$(_watch_last)" = "watch: nothing" ] && _on_desktop; do
        _bare__waited="$((_bare__waited + 3))"
        [ "${_bare__waited}" -le 30 ] || return 1
        sleep 2
    done
}
_installer_leave
_type "exit"; _press ret
_bare || { _screen background-menu; _die "the installer and the terminal, left, did not leave the wallpaper bare"; }
_click
_wait_serial "probe: menu of the background" 30 || { _screen background-menu; _die "a click on the wallpaper opened no menu"; }
_wait_serial_count "^watch: menu at " 1 30 || { _screen background-menu; _die "the menu's script ran, and rofi drew no window"; }
sleep 2
_screen background-menu
_step "the menu of the background: $(sed -n 's/^probe: menu of the background  *//p' "${serial}" | tr -d '\r' | head -n 1)"
_menu__installers="$(_count_serial '^watch: installer')"
_press ret
_wait_serial_count "^watch: installer" "$((_menu__installers + 1))" 30 ||
    { _screen menu-enter; _die "Enter on the menu, its first row marked, opened no installer"; }
sleep 3
_screen menu-enter
_step "a row by Enter: Install minos, the installer's window"
_installer_leave
_bare || { _screen menu-enter; _die "the installer, left, did not leave the wallpaper bare"; }
_click
_wait_serial_count "^watch: menu at " 2 30 || { _screen menu-click; _die "a second click on the wallpaper opened no menu"; }
#WxH+X+Y of the menu, the screen's width and height, and how many rows: the middle of the second
# shellcheck disable=SC2046 # six numbers
set -- $(grep '^watch: menu at ' "${serial}" | tail -n 1 | tr -d '\r' | tr 'x+' '  ' | sed 's/^watch: menu at //; s/ of / /')
[ "${#}" = 6 ] || _die "where rofi drew the menu is not WxH+X+Y of WxH: $(grep '^watch: menu at ' "${serial}" | tail -n 1)"
_menu__rows="$(sed -n 's/^probe: menu of the background  *\([0-9]*\) entries.*/\1/p' "${serial}" | head -n 1)"
#a row is a share of the window but its border (1 px) and its padding (2 px), above and below
_menu__x="$((${3} + ${1} / 2))"; _menu__y="$((${4} + 3 + (${2} - 6) * 3 / (2 * _menu__rows)))"
_menu__terminals="$(_count_serial '^watch: terminal')"
_point "${_menu__x}" "${_menu__y}" "${5}" "${6}"
sleep 1
_screen menu-pointer
_click
_wait_serial_count "^watch: terminal" "$((_menu__terminals + 1))" 30 ||
    { _screen menu-click; _die "a click on the menu's second row, Terminal, at ${_menu__x},${_menu__y}, opened no terminal"; }
sleep 3
_screen menu-click
_step "a row by a click: Terminal, at ${_menu__x},${_menu__y}, a terminal"
_monitor quit >/dev/null
qemu=""
#what the two rows did, seen above in the watcher's lines, and how long the installer's first screen took,
#read off the screen, as lines of the probe for ci/verdict (QEMU, gone, no longer writes the log). The
#first screen's line names the medium: from the stick the installer's start also reads the stick, its own
#programs and the partitions its engine looks at, through the USB storage QEMU gives the machine (some
#12 ms a read where it was measured: 2.6 s to the first screen, against 1.1 s from the CD on the same
#machine). That time is read apart
printf "probe: %-34s %s\r\n" "installer's first screen, ${medium}" "${first_screen} ms after its key" \
    "menu, a row by Enter" "Install minos: the window of the installer" \
    "menu, a row by a click" "Terminal: a terminal" >> "${serial}"
sed -n 's/^probe: //p' "${serial}"
if [ "${cable}" = yes ]; then
    { grep -q "^probe: network  *[a-z][a-z0-9]* [0-9.]*/[0-9]" "${serial}" &&
      grep -q "^probe: dns  *archive\.ubuntu\.com [0-9a-f:.][0-9a-f:.]* after" "${serial}"; } ||
        _die "no network in the live session: no address, or no name resolved"
else
    grep -q "^probe: network  *no address" "${serial}" || _die "an address with the cable out"
fi
[ "${firmware}" != secureboot ] || grep -q "^probe: firmware  *uefi, Secure Boot on" "${serial}" ||
    _die "booted by secureboot with Secure Boot off"
grep -q "^probe: menu of the background  *[0-9]* entries, the first: Install minos " "${serial}" ||
    _die "the menu of the background does not have \"Install minos\" first: $(sed -n 's/^probe: menu of the background  *//p' "${serial}" | tr -d '\r' | head -n 1)"
_step "checked: ${serial}"

# vim: set ts=8 sw=4 tw=0 ft=sh :
