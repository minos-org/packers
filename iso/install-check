#!/bin/sh
#install minos from an ISO's live session onto a disk, with no network, then boot that disk alone, in QEMU
#with KVM, by BIOS (SeaBIOS), UEFI (OVMF) or UEFI with Secure Boot on. The live session boots from a CD.
#The installer's key (Win+i) must open its window, which is kept as a screen and closed; then the
#installer is opened again with nothing moving on its own, and answered by its keys as a person answers
#it, each screen waited for by the name its window's title gives it: the intro, the plan the engine
#proposes (changed line by line when LAYOUT says so), the user and a password that starts with "-", the
#one confirmation, the install as it happens, and "Restart now", after which the live session must
#restart on its own. The password is typed by its keys with the keyboard the installer shows (changed
#there when KEYBOARD says so), and by the same keys at the disk's login: the disk has that keyboard, and
#the time zone the installer showed: minos' own, America/Mexico_City, which the live session's clock is
#in and the installer starts on, or the one chosen there when ZONE says so. Then
#the disk boots alone, still with no network, to slim, where the user logs in, and to i3, where it is
#asked its time zone (timedatectl and date, in a terminal), and stays up until minos-untrim has had its
#try, which must fail and leave the unit enabled.
#The disk is read here after each boot: the files dpkg --verify finds missing, what the copy left out, the
#boot loader, the boot's journal, the user's password, and what the plan was to keep.
#usage: [PHASES="install boot [untrim]"] [LAYOUT=empty|beside|home] [KEYBOARD=LAYOUT] [ZONE=ZONE] [INSTALLER=DIR] install-check ISO FIRMWARE DISK OUTPUT [MINUTES]
#  FIRMWARE    bios, uefi or secureboot
#  DISK        sata or nvme, the disk minos goes to
#  PHASES      install (the live session, the installer answered), boot (the disk alone, no network),
#              untrim (the disk alone with a network, read once minos-untrim is through). boot and untrim
#              alone use the disk OUTPUT/NAME.img an earlier run, or another installer, left; ISO is then
#              unused
#  LAYOUT      empty (the default): the disk has nothing, and the plan proposed, the whole disk, is taken
#              with Enter. beside: the disk holds a partition with a file (and, by UEFI, an EFI system
#              partition with another system's file) and free room; the plan proposed is changed in the
#              installer (the partition for minos made smaller than the room), and both files must be
#              there after the install; NAME gets -beside. home: the disk has nothing, and the plan
#              is changed to give /home a partition of its own, which the disk must then mount with
#              the user's home in it; NAME gets -home
#  KEYBOARD    latam: on the step of the user the keyboard is changed to it with the installer's key,
#              before the password is typed. The password is typed by its keys, the same ones here and
#              at the disk's login, whatever characters the layout makes of them; the disk must have
#              that keyboard, and without KEYBOARD the live session's own (us). NAME gets -KEYBOARD
#  ZONE        a time zone (Asia/Tokyo): chosen on the step of the user, its city typed into the
#              installer's list. The disk must be in that zone, by its files and by what it says once
#              booted; without ZONE, in America/Mexico_City. NAME gets the city, in lower case
#  INSTALLER   a directory with minos-installer and minos-installer-engine: they take the place of the
#              ISO's own in its live session, so a change to them is tried without building an ISO
#  => in OUTPUT, for NAME=FIRMWARE-DISK: NAME.img (the disk), NAME.serial.log (the probe in the live
#     session), NAME.facts (the disk read after each boot), the screens of the install
#     NAME-{desktop,installer,plan,zone,confirm,installing,installed}.png, NAME-{slim,i3,clock}.png of the disk's boot and
#     NAME-net-{slim,i3}.png of its boot with a network; exit 0 when the installer finished, the live
#     session restarted on its own, the disk came up to i3 by itself (on a copy of the ISO, with
#     minos-untrim failed and still enabled) and, with untrim, the packages minos-untrim reinstalls miss
#     no file and the unit disabled itself
#needs what live-check needs, qemu-img, sfdisk, mkfs.ext4, mkfs.vfat, losetup and mount (root) to make and
#read the disk

set -eu
iso="${1:-}"; firmware="${2:-}"; disk="${3:-}"; out="${4:-}"; minutes="${5:-15}"
phases="${PHASES:-install boot}"; layout="${LAYOUT:-empty}"
if [ -z "${firmware}" ] || [ -z "${disk}" ] || [ -z "${out}" ]; then sed -n '18,47s/^#//p' "${0}" >&2; exit 2; fi
name="${firmware}-${disk}"; [ "${layout}" = "empty" ] || name="${name}-${layout}"
[ -z "${KEYBOARD:-}" ] || name="${name}-${KEYBOARD}"
zone="${ZONE:-}"; city="$(printf "%s" "${zone##*/}" | tr '[:upper:]_' '[:lower:] ')"
[ -z "${zone}" ] || name="${name}-$(printf "%s" "${city}" | tr ' ' '-')"
#a password that starts with -: the installer hands it to setup on its standard input, where no command
#line reads it as an option
#the keys the password is typed with, as a us keyboard names them, in the installer and at the disk's
#login alike; and the password they make, which depends on the keyboard that is active when they are
#pressed: on latam the key that us has - on types an apostrophe
user="ana"; password_keys="-minos2026"; keyboard="${KEYBOARD:-}"
#the time zone an install starts on, minos' own: the live session's clock is in it, the installer shows
#it before anything is chosen, and a disk installed with nothing chosen is in it
default_zone="America/Mexico_City"
case "${keyboard}" in
    ""|us) password="-minos2026" ;;
    latam) password="'minos2026" ;;
    *) printf "%s\\n" "install-check: KEYBOARD is latam or nothing: the keyboards whose keys this check knows" >&2; exit 2 ;;
esac

_die() { #message => on stderr, exit 1
    printf "%s\\n" "install-check: ${name}: ${*}" >&2
    exit 1
}

_step() { #message => one line on stdout, with the seconds since the start
    printf "%5ss  %s\\n" "$(($(date +%s) - start))" "${*}"
}

# shellcheck source=iso/qemu-lib
. "$(dirname "${0}")/qemu-lib"

_write_probe() { #dir => DIR/probe.iso, a CD labelled PROBE: prepare sees the installer's window opened by
    #Win+i and closes it, opens the installer again with nothing moving on its own, and from then on says on
    #the serial port each name the window's title takes (the screen it shows); it leaves watch behind,
    #which says how the install ended and what was said
    mkdir -p "${1}/probe"
    if [ -n "${INSTALLER:-}" ]; then
        cp "${INSTALLER}/minos-installer" "${INSTALLER}/minos-installer-engine" "${1}/probe/" || _die "no installer in ${INSTALLER}"
    fi
    cat > "${1}/probe/prepare" << 'E=O=F'
#!/bin/sh
#install-check's probe, run as root in the live session: the installer's window, which Win+i must open
#once this says ready, seen and closed; then the installer opened as i3 opens it, with its effects off,
#and each screen it shows said on the serial port, from its window's title
_say() { printf "probe: %s\n" "${*}" > /dev/ttyS0; }
#typed again when the first time was slow to answer: once is enough
mkdir /tmp/probe.once 2>/dev/null || exit 0
i3="i3-msg -s /home/minos/.i3/ipc.sock"
#another installer than the ISO's own, when the check was given one
if [ -f /mnt/minos-installer ]; then
    cp /mnt/minos-installer /mnt/minos-installer-engine /usr/local/bin/ && _say "installer: the check's own, not the ISO's"
fi
_say "network: $(ip -4 -o address show scope global | awk '{print $2 " " $4}' | head -n 1) (none expected)"
_say "keyboard: $(grep '^XKBLAYOUT' /etc/default/keyboard)"
_say "keyboard active: $(sudo -u minos env DISPLAY=:0 setxkbmap -query 2>/dev/null | awk '$1 == "layout:" {print $2}')"
zone="$(readlink /etc/localtime 2>/dev/null | sed -n 's|^.*/zoneinfo/||p')"; [ -n "${zone}" ] || zone="$(cat /etc/timezone 2>/dev/null)"
_say "timezone: ${zone:-Etc/UTC}"
_say "clock: /etc/localtime -> $(readlink /etc/localtime 2>&1); /etc/timezone: $(cat /etc/timezone 2>&1); $(date)"
_say "ready"
waited=0
until pgrep -f "urxvt -name minos-installer" > /dev/null; do
    sleep 1; waited="$((waited + 1))"
    [ "${waited}" -lt 90 ] || { _say "installer: no window after ${waited} s"; exit 1; }
done
_say "installer: open"
#the screen is taken meanwhile
sleep 10
pkill -f "urxvt -name minos-installer"
while pgrep -f "urxvt -name minos-installer" > /dev/null; do sleep 1; done
_say "disk: $(lsblk -lnpo NAME,SIZE,TYPE,FSTYPE "${1}" | tr -s ' ' | tr '\n' ',')"
_say "engine: $(minos-installer-engine facts 2>&1 | tr '\n' ',')"
setsid sh /mnt/watch < /dev/null > /dev/null 2>&1 &
${i3} exec "env MINOS_INSTALLER_EFFECTS=off minos-installer --window" > /dev/null
last=""
while :; do
    title="$(${i3} -t get_tree 2>/dev/null | grep -o '"name":"minos installer[^"]*"' | head -n 1 | cut -d'"' -f4)"
    [ "${title}" = "${last}" ] || { _say "screen: ${title:-closed}"; last="${title}"; }
    sleep 1
done
E=O=F
    cat > "${1}/probe/watch" << 'E=O=F'
#!/bin/sh
#install-check's watcher: how the install ended, and what the engine and setup said, on the serial port
_say() { printf "probe: %s\n" "${*}" > /dev/ttyS0; }
until pgrep -f "/cdrom/minos/setup live" > /dev/null || [ -f /tmp/minos-installer.status ]; do sleep 1; done
_say "install: started"
waited=0
until [ -f /tmp/minos-installer.status ]; do
    sleep 5; waited="$((waited + 5))"
    [ "${waited}" -lt 3600 ] || { _say "install: no end after an hour"; exit 1; }
done
sync
#the password is on no command line while setup runs: looked for once it is through would find nothing,
#so what ps showed is not judged here; the log is, which must not hold it
sed 's/\x1b\[[0-9;]*m//g; s/\r/\n/g' /tmp/minos-installer.log | tr -d '\b' |
    while IFS= read -r line; do _say "log: ${line}"; done
_say "install: the engine exited $(cat /tmp/minos-installer.status) after ${waited} s"
_say "install: done"
E=O=F
    xorriso -report_about WARNING -as mkisofs -V PROBE -J -r -o "${1}/probe.iso" "${1}/probe" 2>/dev/null ||
        _die "cannot write the probe's CD"
}

_prepare_beside() { #=> the disk, before the install, as one that is in use: a partition with a file in it
    #and free room after it; by UEFI, before them, an EFI system partition with another system's file
    if [ "${firmware}" = "bios" ]; then
        printf "%s\\n" "label: dos" ",2G,L" | sfdisk -q "${image}"
        _prepare_beside__keep=1; _prepare_beside__esp=""
    else
        printf "%s\\n" "label: gpt" ",300M,U" ",2G,L" | sfdisk -q "${image}"
        _prepare_beside__keep=2; _prepare_beside__esp=1
    fi
    _prepare_beside__loop="$(losetup -f --show -P "${image}")"; mkdir -p "${run}/beside"
    sleep 1
    if [ -n "${_prepare_beside__esp}" ]; then
        mkfs.vfat -F 32 -n OTHER "${_prepare_beside__loop}p${_prepare_beside__esp}" > /dev/null
        mount "${_prepare_beside__loop}p${_prepare_beside__esp}" "${run}/beside"
        mkdir -p "${run}/beside/EFI/other"; printf "%s\\n" "another system's boot loader" > "${run}/beside/EFI/other/kept.txt"
        umount "${run}/beside"
    fi
    mkfs.ext4 -q -F -L kept "${_prepare_beside__loop}p${_prepare_beside__keep}"
    mount "${_prepare_beside__loop}p${_prepare_beside__keep}" "${run}/beside"
    printf "%s\\n" "a file of the system that was here" > "${run}/beside/kept.txt"
    umount "${run}/beside"
    losetup -d "${_prepare_beside__loop}"
}

_wait_screen() { #name seconds => true when the installer's window says it shows NAME within SECONDS
    _wait_serial "probe: screen: minos installer - ${1}" "${2}" || { _screen timeout; _die "the installer did not get to its screen \"${1}\": $(grep '^probe: screen: ' "${serial}" | tail -n 1)"; }
    #drawn, and its engine through
    sleep 1
}

_boot() { #network => the machine booted, KVM, 2 CPUs, 3 GiB, its firmware, the target disk and what
    #the phase adds in extra (the ISO, the probe), with a network card (user) or none (none), in the
    #background; its pid in qemu
    rm -f "${run}/qemu.pid" "${run}/monitor"
    # shellcheck disable=SC2046,SC2086 # lists of options
    qemu-system-x86_64 -enable-kvm -cpu host -smp 2 -m 3072 $(_firmware_options "${firmware}" "${vars}") \
        ${target} ${extra} -nic "${1}" -vga std -display none -serial "file:${serial}" \
        -monitor "unix:${run}/monitor,server,nowait" -no-reboot -daemonize -pidfile "${run}/qemu.pid"
    qemu="$(cat "${run}/qemu.pid")"
}

_halt() { #=> the machine powered off as by its button, waited for 3 minutes; then quit
    _monitor system_powerdown >/dev/null || :
    _halt__end="$(($(date +%s) + 180))"
    while kill -0 "${qemu}" 2>/dev/null; do
        if [ "$(date +%s)" -ge "${_halt__end}" ]; then
            _step "no power off after 3 minutes: quit"
            _monitor quit >/dev/null || :
            sleep 2
        fi
        sleep 2
    done
    qemu=""
}

_log_in() { #prefix => slim's login answered until i3 is up, within MINUTES: before each try the screen,
    #OUTPUT/NAME-PREFIXslim.png (the last one is slim's), and once i3 is up NAME-PREFIXi3.png. minos' slim
    #names the user (default_user) and asks only for the password (focus_password). The first try waits a
    #minute: keys pressed sooner reach the firmware or GRUB
    sleep 60
    until _on_desktop; do
        kill -0 "${qemu}" 2>/dev/null || _die "the machine stopped"
        [ "$(($(date +%s) - phase_start))" -lt "$((minutes * 60))" ] || { _screen "${1}timeout"; _die "no i3 after ${minutes} min"; }
        _screen "${1}slim"
        _type "${password_keys}"; _press ret; sleep 25
    done
    _step "i3 is up"
    sleep 10
    _screen "${1}i3"
}

_type_there() { #text => typed at the disk's own system, whose keyboard is the one the installer was left
    #with: letters, digits and spaces are on the same keys of both keyboards this check knows; the
    #hyphen is where latam has it, on the key us has / on
    case "${keyboard}" in
        latam) _type "$(printf "%s" "${1}" | tr '-' '/')" ;;
        *) _type "${1}" ;;
    esac
}

_ask_clock() { #=> the disk's own system, booted and logged in, asked what time zone it is in: a terminal
    #opened with i3's key, timedatectl and date run in it for the screen OUTPUT/NAME-clock.png, and
    #again with their answers sent to the journal (systemd-cat), where _read_disk finds them once the
    #machine is off: it has no network and no serial port of its own to say them through. The terminal
    #is there once it hides the wallpaper: i3 gives the first window the whole screen
    _ask_clock__tries=0
    while _on_desktop; do
        _ask_clock__tries="$((_ask_clock__tries + 1))"
        [ "${_ask_clock__tries}" -le 3 ] || { _screen clock; _die "no terminal opened on the disk's own desktop, to ask it its time zone"; }
        _press meta_l-ret; sleep 8
    done
    _type "timedatectl"; _press ret; sleep 3
    _type "date"; _press ret; sleep 1
    _type_there "systemd-cat -t timedatectl timedatectl"; _press ret; sleep 3
    _type_there "systemd-cat -t date date"; _press ret; sleep 2
    _screen clock
    _step "the disk's own system asked its time zone"
}

_written() { #=> the bytes the machine has written to the target disk
    _monitor "info blockstats" | tr -d '\r' | awk '$1 == "target:" {for (i = 2; i <= NF; i++) if ($i ~ /^wr_bytes=/) {sub(/^wr_bytes=/, "", $i); print $i}}'
}

_read_disk() { #title => NAME.facts gets TITLE and what the disk holds: the files dpkg --verify misses,
    #what only the live session needed, the user, fstab, the boot loader, minos-untrim and the last boot's
    #journal
    _read_disk__loop="$(losetup -f --show -P "${image}")"
    _read_disk__root="${run}/disk"; mkdir -p "${_read_disk__root}"
    sleep 1
    #the partition of minos is the one the installer's engine labelled so; the EFI system partition, the
    #one its fstab mounts on /boot/efi
    _read_disk__part="$(blkid -t LABEL=minos -o device "${_read_disk__loop}"p* | head -n 1)"
    [ -n "${_read_disk__part}" ] || { losetup -d "${_read_disk__loop}"; _die "no partition labelled minos on the disk"; }
    mount "${_read_disk__part}" "${_read_disk__root}"
    _read_disk__esp="$(awk '$2 == "/boot/efi" {sub(/^UUID=/, "", $1); print $1}' "${_read_disk__root}/etc/fstab")"
    [ -z "${_read_disk__esp}" ] || _read_disk__esp="$(blkid -t UUID="${_read_disk__esp}" -o device "${_read_disk__loop}"p* | head -n 1)"
    esp_number="${_read_disk__esp##*p}"
    [ -z "${_read_disk__esp}" ] || mount "${_read_disk__esp}" "${_read_disk__root}/boot/efi"
    mount -t proc proc "${_read_disk__root}/proc"
    {   printf "\n== %s\n" "${1}"
        #each partition: its number, its size, and what it holds, read from it (a loop device has no udev here)
        printf "partitions: %s\n" "$(for _read_disk__each in "${_read_disk__loop}"p*; do
            printf "%s %sM %s %s, " "${_read_disk__each##*p}" "$(($(blockdev --getsize64 "${_read_disk__each}") / 1048576))" \
                "$(blkid -o value -s TYPE "${_read_disk__each}")" "$(blkid -o value -s LABEL "${_read_disk__each}")"
        done | tr -s ' ' | sed 's/ ,/,/g; s/, $//')"
        _read_disk__verify="$(chroot "${_read_disk__root}" dpkg --verify 2>/dev/null || :)"
        #missing: the kernel modules and firmware the ISO left out, the documentation it leaves out
        #(minos-docs, which the copy keeps), anything else
        printf "%s\n" "${_read_disk__verify}" | awk '
            $1 == "missing" {missing++
                if ($NF ~ /^\/(usr\/)?lib\/(modules|firmware)\//) trimmed++
                else if ($NF ~ /^\/usr\/share\/(doc|man|groff|info|lintian|linda)\// && $NF !~ /^\/usr\/share\/doc\/[^\/]*\/copyright$/ ||
                         $NF ~ /^\/usr\/share\/locale\/.*\/LC_MESSAGES\/.*\.mo$/) docs++
                else other[++others] = $NF}
            END {printf "dpkg --verify: %d files missing, %d of them kernel modules or firmware, %d documentation, %d else\n",
                     missing, trimmed, docs, others
                 for (i = 1; i <= others && i <= 10; i++) printf "  missing, neither: %s\n", other[i]}'
        printf "%s\n" "${_read_disk__verify}" | awk '$1 != "missing" && NF' | head -n 5 | sed 's/^/  dpkg --verify: /'
        # shellcheck disable=SC2016 # dpkg-query's format, not the shell's
        printf "casper: %s\n" "$(chroot "${_read_disk__root}" dpkg-query -W -f='${db:Status-Abbrev}${Version}' casper 2>/dev/null || printf "not installed")"
        for _read_disk__path in /etc/dpkg/dpkg.cfg.d/minos-live /var/lib/minos/live-only /usr/local/bin/minos-installer \
            /usr/local/bin/minos-installer-engine /etc/netplan/90-minos-live.yaml /etc/casper.conf /etc/systemd/system/systemd-networkd-wait-online.service \
            /var/lib/minos/live-trimmed /etc/dpkg/dpkg.cfg.d/minos-docs; do
            if [ -e "${_read_disk__root}${_read_disk__path}" ] || [ -L "${_read_disk__root}${_read_disk__path}" ]; then
                printf "present: %s\n" "${_read_disk__path}"
            else
                printf "absent: %s\n" "${_read_disk__path}"
            fi
        done
        printf "slim: %s\n" "$(grep -E '^(default_user|auto_login)' "${_read_disk__root}/etc/slim.conf" | tr -s ' ' | tr '\n' ',')"
        #i3's configuration is a link of the settings package, absolute: followed inside the disk, where
        #it leads to that package's file, not from here, where it would lead into this machine
        if chroot "${_read_disk__root}" test -e /etc/i3/config; then
            printf "i3 config: %s lines naming minos-installer\n" "$(chroot "${_read_disk__root}" grep -c minos-installer /etc/i3/config || :)"
        elif [ -L "${_read_disk__root}/etc/i3/config" ]; then
            printf "i3 config: a link to %s, which is missing on the disk\n" "$(readlink "${_read_disk__root}/etc/i3/config")"
        else
            printf "%s\n" "i3 config: absent"
        fi
        #what every system setup's live mode makes carries: the services it purges, the upgraders
        printf "packages: %s\n" "$(for _read_disk__package in rsyslog cron networkd-dispatcher dbus-user-session \
            unattended-upgrades ubuntu-release-upgrader-core; do
                # shellcheck disable=SC2016 # dpkg-query's format, not the shell's
                printf "%s %s, " "${_read_disk__package}" "$(chroot "${_read_disk__root}" dpkg-query -W \
                    -f='${db:Status-Abbrev}' "${_read_disk__package}" 2>/dev/null | tr -d ' ' || :)"
            done | sed 's/ ,/ absent,/g; s/, $//')"
        printf "user: %s; groups: %s\n" "$(grep "^${user}:" "${_read_disk__root}/etc/passwd")" \
            "$(awk -F: -v user="${user}" '$4 ~ "(^|,)" user "(,|$)" {printf "%s ", $1}' "${_read_disk__root}/etc/group")"
        #the password typed into the installer is the one the disk checks: hashed again by the disk's own
        #crypt, with the salt and the method of the one it keeps
        # shellcheck disable=SC2016 # perl's variables, not the shell's
        printf "password: %s\n" "$(PASSWORD="${password}" NAME="${user}" chroot "${_read_disk__root}" perl -e '
            open(my $shadow, "<", "/etc/shadow") or die; my $kept = "";
            while (<$shadow>) { my @field = split /:/; $kept = $field[1] if $field[0] eq $ENV{NAME}; }
            print $kept ne "" && crypt($ENV{PASSWORD}, $kept) eq $kept ? "the one typed" : "another than the one typed";' 2>&1)"
        #a partition of its own for /home, when the plan made one: the one the engine labelled so, which
        #the disk's fstab mounts on /home, with the user's home in it
        if [ "${layout}" = "home" ]; then
            _read_disk__home="$(blkid -t LABEL=home -o device "${_read_disk__loop}"p* | head -n 1)"
            mkdir -p "${run}/home"
            if [ -n "${_read_disk__home}" ] && mount -r "${_read_disk__home}" "${run}/home" 2>/dev/null; then
                printf "home: its own partition, %sM, mounted on %s by fstab; in it: %s\n" "$(($(blockdev --getsize64 "${_read_disk__home}") / 1048576))" \
                    "$(awk -v uuid="UUID=$(blkid -o value -s UUID "${_read_disk__home}")" '$1 == uuid {print $2}' "${_read_disk__root}/etc/fstab")" \
                    "$(for _read_disk__each in "${run}/home"/*; do
                        [ "${_read_disk__each##*/}" = "lost+found" ] || printf "%s " "${_read_disk__each##*/}"; done)"
                umount "${run}/home"
            else
                printf "%s\n" "home: no partition of its own"
            fi
        fi
        #what the plan was to keep: the file of the partition beside minos, and of the EFI system partition
        if [ "${layout}" = "beside" ]; then
            _read_disk__kept="$(blkid -t LABEL=kept -o device "${_read_disk__loop}"p* | head -n 1)"
            mkdir -p "${run}/kept"
            if [ -n "${_read_disk__kept}" ] && mount -r "${_read_disk__kept}" "${run}/kept" 2>/dev/null; then
                printf "kept: the partition beside minos: %s\n" "$(cat "${run}/kept/kept.txt" 2>/dev/null || printf "its file is gone")"
                umount "${run}/kept"
            else
                printf "%s\n" "kept: the partition beside minos: gone"
            fi
            [ -z "${_read_disk__esp}" ] || printf "kept: the EFI system partition: %s\n" \
                "$(cat "${_read_disk__root}/boot/efi/EFI/other/kept.txt" 2>/dev/null || printf "the other system's file is gone")"
        fi
        #where the disk's apt fetches from, as ci/probe-common says it: the Ubuntu archive itself, whatever
        #mirror built the ISO
        printf "apt sources: %s\n" "$(chroot "${_read_disk__root}" apt-get -o Debug::NoLocking=1 update --print-uris 2>/dev/null |
            sed -n "s|^'\\(.*/\\)dists/\\([^/]*\\)/InRelease'.*|\\1 \\2|p" | sort -u |
            awk '$1 != uri {printf "%s%s", (n++ ? "; " : ""), $1; uri = $1} {printf " %s", $2} END {print ""}')"
        printf "hostname: %s; keyboard: %s\n" "$(cat "${_read_disk__root}/etc/hostname")" \
            "$(grep '^XKBLAYOUT' "${_read_disk__root}/etc/default/keyboard")"
        _read_disk__zone="$(readlink "${_read_disk__root}/etc/localtime" | sed 's|.*/zoneinfo/||')"
        printf "timezone: %s; localtime: %s\n" "$(cat "${_read_disk__root}/etc/timezone" 2>/dev/null)" "${_read_disk__zone}"
        #what that zone is called and how far from UTC it is now, by the disk's own zone files
        printf "clock: zone file: %s (%s)\n" "${_read_disk__zone}" "$(chroot "${_read_disk__root}" env TZ="${_read_disk__zone}" date '+%Z, %z' 2>&1)"
        sed 's/^/fstab: /' "${_read_disk__root}/etc/fstab"
        printf "boot: %s\n" "$(cd "${_read_disk__root}/boot" && find . -maxdepth 2 \( -name 'vmlinuz-*' -o -name 'initrd.img-*' -o -path ./grub/grub.cfg \) | sort | tr '\n' ' ')"
        [ -z "${esp_number}" ] || printf "esp: %s\n" "$(cd "${_read_disk__root}/boot/efi" && find . -type f | sort | tr '\n' ' ')"
        printf "kernels: %s\n" "$(find "${_read_disk__root}/usr/lib/modules" -mindepth 1 -maxdepth 1 -printf '%f ')"
        printf "minos-untrim.service: %s\n" "$([ -L "${_read_disk__root}/etc/systemd/system/multi-user.target.wants/minos-untrim.service" ] && printf enabled || printf disabled)"
        #the last boot's journal, read with the disk's own journalctl
        _read_disk__boot="$(chroot "${_read_disk__root}" journalctl -D /var/log/journal --list-boots --no-pager -q 2>/dev/null | awk 'END {print $2}')"
        if [ -n "${_read_disk__boot}" ]; then
            # shellcheck disable=SC2086 # a command and its options
            _read_disk__journal="chroot ${_read_disk__root} journalctl -D /var/log/journal -b ${_read_disk__boot} --no-pager -q -o short-monotonic"
            ${_read_disk__journal} -k | grep -i -m 2 -E 'secure boot|Command line' | sed 's/^/journal: /'
            ${_read_disk__journal} | grep -E 'Started (slim|minos-untrim)|Finished minos-untrim|Failed to start|minos-untrim\.service: (Failed|Main process|Deactivated|Scheduled)|Reached target (graphical|network-online)' |
                head -n 30 | sed 's/^/journal: /'
            ${_read_disk__journal} -u minos-untrim | grep -E 'minos-untrim:|^E:|^W:|Err|Fetched|upgraded,' | tail -n 15 | sed 's/^/untrim: /'
            ${_read_disk__journal} -p err | tail -n 10 | sed 's/^/journal error: /'
            #what the system said of its time zone when it was asked, booted (_ask_clock)
            for _read_disk__tool in timedatectl date; do
                chroot "${_read_disk__root}" journalctl -D /var/log/journal -b "${_read_disk__boot}" --no-pager -q -o cat -t "${_read_disk__tool}" |
                    sed "s/^ */clock: ${_read_disk__tool}: /"
            done
        else
            printf "%s\n" "journal: none on the disk"
        fi
    } >> "${facts}"
    umount "${_read_disk__root}/proc"
    [ -z "${_read_disk__esp}" ] || umount "${_read_disk__root}/boot/efi"
    umount "${_read_disk__root}"
    losetup -d "${_read_disk__loop}"
}

esp_number=""
case "${layout}" in empty|beside|home) ;; *) _die "the layout is empty, beside or home" ;; esac
case "${disk}" in
    sata) device="sda"; target_device="ide-hd,drive=target,bus=ide.2,serial=MINOS0001" ;;
    nvme) device="nvme0n1"; target_device="nvme,drive=target,serial=MINOS0001" ;;
    *) _die "the disk is sata or nvme" ;;
esac
[ -c /dev/kvm ] || _die "no /dev/kvm"
mkdir -p "${out}"; out="$(cd "${out}" && pwd)"
image="${out}/${name}.img"; vars="${out}/${name}.vars.fd"; facts="${out}/${name}.facts"
run="$(mktemp -d)"; qemu=""
trap '[ -z "${qemu}" ] || kill "${qemu}" 2>/dev/null; rm -rf "${run}"' EXIT
trap 'exit 143' INT TERM HUP
start="$(date +%s)"

case " ${phases} " in *" install "*)
    [ -f "${iso}" ] || _die "no ISO ${iso}"
    rm -f "${image}" "${vars}" "${facts}" "${out}/${name}"*.png "${out}/${name}.serial.log"
    qemu-img create -q -f raw "${image}" 12G
    [ "${layout}" != "beside" ] || _prepare_beside
    _write_probe "${run}"
    serial="${out}/${name}.serial.log"; phase_start="$(date +%s)"
    target="-drive if=none,id=target,format=raw,file=${image} -device ${target_device}"
    extra="-drive if=none,id=boot,media=cdrom,readonly=on,format=raw,file=${iso} -device ide-cd,drive=boot,bus=ide.0,bootindex=0"
    extra="${extra} -drive if=none,id=probe,media=cdrom,readonly=on,format=raw,file=${run}/probe.iso -device ide-cd,drive=probe,bus=ide.1"
    _step "the live session of $(basename "${iso}") (${firmware}), no network, a ${disk} disk, ${layout}"
    _boot none
    until _on_desktop; do
        kill -0 "${qemu}" 2>/dev/null || _die "the machine stopped"
        [ "$(($(date +%s) - phase_start))" -lt "$((minutes * 60))" ] || { _screen timeout; _die "no desktop after ${minutes} min"; }
        sleep 2
    done
    _step "the desktop"
    _screen desktop
    sleep 10
    for _try in 1 2 3; do
        _press meta_l-ret
        sleep 5
        _type "sudo mount -r -L PROBE /mnt; sudo sh /mnt/prepare /dev/${device}"
        _press ret
        ! _wait_serial "probe: ready" 60 || break
        _screen "probe-${_try}"
        [ "${_try}" != 3 ] || _die "the probe said nothing"
    done
    #the session's clock is in the zone an install starts on: the bar and the installer tell the same hour
    _live__zone="$(sed -n 's/^probe: timezone: //p' "${serial}" | tr -d '\r' | head -n 1)"
    [ "${_live__zone}" = "${default_zone}" ] ||
        _die "the live session is in ${_live__zone:-no time zone it says}, not in ${default_zone}: $(grep '^probe: clock: ' "${serial}" | tr -d '\r' | head -n 1)"
    _step "the installer's window (Win+i)"
    _press meta_l-i
    _wait_serial "probe: installer: open" 100 || { _screen timeout; _die "Win+i opened no installer"; }
    sleep 5
    _screen installer
    #the installer, answered by its keys. With one disk it can go to, it asks for none
    _wait_screen "intro ready" 60
    _step "the installer, opened again: its intro"
    _press ret
    _wait_screen "plan" 60
    if [ "${layout}" = "beside" ]; then
        #the plan proposed takes the free room and deletes nothing. Changed line by line: p; down to the
        #line of the free room (after the line of what is used and the lines of the partitions there);
        #Enter opens its choices; the next one, a partition for minos of a size of its own; twice smaller
        _press p; sleep 1
        if [ "${firmware}" = "bios" ]; then _press j j; else _press j j j; fi
        _press ret; sleep 1
        _press j ret; sleep 3
        _press minus; sleep 3
        _press minus; sleep 3
        _screen plan
        _press n
    elif [ "${layout}" = "home" ]; then
        #the plan proposed, the whole disk, changed line by line: p; down to the line of /home (after what
        #is used, what the firmware starts from and the partition of minos); Enter opens its choices; the
        #next one, a partition of its own
        _press p; sleep 1
        _press j j j
        _press ret; sleep 1
        _press j ret; sleep 3
        _screen plan
        _press n
    else
        _screen plan
        _press ret
    fi
    _wait_screen "user" 60
    #before anything is chosen, the step shows the zone an install starts on
    grep '^probe: screen: minos installer - user' "${serial}" | head -n 1 | tr -d '\r' | grep -q " ${default_zone}\$" ||
        { _screen timeout; _die "the installer does not start on ${default_zone}: $(grep '^probe: screen: minos installer - user' "${serial}" | head -n 1)"; }
    if [ -n "${keyboard}" ]; then
        #the installer's key moves to the next keyboard of minos' list: pressed until its window says the
        #one wanted is the active one
        _keyboard__tries=0
        until grep '^probe: screen: minos installer - user' "${serial}" | tail -n 1 | tr -d '\r' | grep -q "user ${keyboard} "; do
            _keyboard__tries="$((_keyboard__tries + 1))"
            [ "${_keyboard__tries}" -le 4 ] || { _screen timeout; _die "the installer's key did not get to the keyboard ${keyboard}: $(grep '^probe: screen: ' "${serial}" | tail -n 1)"; }
            _press f2; sleep 4
        done
        _step "the keyboard changed in the installer: ${keyboard}"
    fi
    if [ -n "${zone}" ]; then
        #the installer's list of time zones, narrowed by the city typed until its window says the cursor
        #is on the zone wanted; Enter takes it, and the step says it
        _press f4
        _wait_screen "zone " 30
        _type "${city}"; sleep 3
        grep '^probe: screen: ' "${serial}" | tail -n 1 | tr -d '\r' | grep -q -x "probe: screen: minos installer - zone ${zone}" ||
            { _screen timeout; _die "\"${city}\" typed into the installer's list of time zones did not find ${zone}: $(grep '^probe: screen: ' "${serial}" | tail -n 1)"; }
        _screen zone
        _press ret
        _wait_serial "probe: screen: minos installer - user [a-z]* ${zone}" 30 ||
            { _screen timeout; _die "the installer did not take the time zone ${zone}: $(grep '^probe: screen: ' "${serial}" | tail -n 1)"; }
        _step "the time zone chosen in the installer: ${zone}"
    fi
    _type "${user}"; _press ret; sleep 2
    _type "${password_keys}"; _press ret; sleep 2
    _type "${password_keys}"; _press ret
    _wait_screen "confirm" 60
    _screen confirm
    #the button that goes back holds the cursor: the other one, then Enter
    _press l ret
    _wait_serial "probe: install: started" 120 || { _screen timeout; _die "the installer did not start the install: $(grep '^probe: screen: ' "${serial}" | tail -n 1)"; }
    _step "confirmed; the plan applied so far, setup runs"
    sleep 20
    _screen installing
    _wait_serial "probe: install: done" "$((minutes * 120))" || { _screen timeout; _die "the install did not end"; }
    sed -n 's/^probe: \(install: \|disk: \|engine: \|keyboard: \|keyboard active: \|timezone: \|clock: \)/\1/p; s/^probe: log:   \(table\|partition\|format\|esp\|root\|home\) /plan: \1 /p' "${serial}"
    grep -q "^probe: install: the engine exited 0 " "${serial}" ||
        { grep '^probe: log: ' "${serial}" | tail -n 30 >&2; _die "the install failed, see ${serial}"; }
    ! grep -F -q -e "${password}" "${serial}" || _die "the password is in what the install said, see ${serial}"
    _wait_screen "end" 60
    _screen installed
    #Restart now, the button that holds the cursor: the live session restarts on its own, with nobody to
    #press a key for it (QEMU, told not to restart, ends when the machine does)
    _press ret
    _step "installed; Restart now"
    _restart__end="$(($(date +%s) + 120))"
    while kill -0 "${qemu}" 2>/dev/null; do
        if [ "$(date +%s)" -ge "${_restart__end}" ]; then
            _screen timeout
            _die "the live session did not restart on its own in 2 minutes after Restart now"
        fi
        sleep 1
    done
    qemu=""
    _step "the live session restarted on its own"
    ;;
esac

[ -f "${image}" ] || _die "no disk ${image}"
target="-drive if=none,id=target,format=raw,file=${image} -device ${target_device},bootindex=0"; extra=""
serial="${run}/serial.log"

case " ${phases} " in *" boot "*)
    _step "the disk alone, no network"
    phase_start="$(date +%s)"
    _boot none
    _log_in ""
    _ask_clock
    #with no network, network-online.target comes when connman-wait-online gives up, 2 minutes into the
    #boot, and only then does minos-untrim have its try on a copy of the ISO: the machine stays up for it
    while [ "$(($(date +%s) - phase_start))" -lt 180 ]; do sleep 5; done
    _halt
    _read_disk "${name}: the disk alone, no network"
    _step "read: ${facts}"
    ;;
esac

case " ${phases} " in *" untrim "*)
    _step "the disk alone, with a network: minos-untrim"
    phase_start="$(date +%s)"
    _boot user,model=virtio-net-pci
    _log_in "net-"
    #minos-untrim writes the kernel modules and firmware, hundreds of MiB: it is through once the disk
    #has taken them and nothing more is written for a minute, or after MINUTES
    _untrim__last=0; _untrim__still=0
    while [ "$(($(date +%s) - phase_start))" -lt "$((minutes * 60))" ]; do
        _untrim__now="$(_written)"
        if [ "$((_untrim__now - _untrim__last))" -lt 1048576 ]; then _untrim__still="$((_untrim__still + 1))"; else _untrim__still=0; fi
        _untrim__last="${_untrim__now}"
        [ "${_untrim__now}" -lt 419430400 ] || [ "${_untrim__still}" -lt 2 ] || break
        sleep 30
    done
    _step "$((_untrim__last / 1048576)) MiB written to the disk"
    _halt
    _read_disk "${name}: the disk alone, with a network, minos-untrim through"
    _step "read: ${facts}"
    ;;
esac

cat "${facts}"
#each reading: the disk reads the Ubuntu archive and security.ubuntu.com, besides them the minos archive alone
awk '/^apt sources: / {n++; sub(/^apt sources: /, ""); k = split($0, source, "; "); archive = security = other = 0
        for (i = 1; i <= k; i++) {
            if (source[i] ~ /^http:\/\/archive\.ubuntu\.com\/ubuntu\/ /) archive++
            else if (source[i] ~ /^http:\/\/security\.ubuntu\.com\/ubuntu\/ [a-z]+-security$/) security++
            else if (source[i] !~ /^https?:\/\/ppa\.launchpad(content)?\.net\/minos-archive\/main\/ubuntu\/ /) other++
        }
        if (!archive || !security || other) bad++}
    END {exit !(n && !bad)}' "${facts}" ||
    _die "the disk reads another archive than archive.ubuntu.com, security.ubuntu.com and the minos one"
#each reading: the password the disk keeps is the one typed into the installer; i3's configuration names
#the installer on no line (its key was the live session's alone); what the plan kept is there
awk '/^password: / {n++; if ($0 != "password: the one typed") bad++} END {exit !(n && !bad)}' "${facts}" ||
    _die "the disk's password for ${user} is not the one its keys make with the keyboard ${keyboard:-of the live session}"
#the disk has the keyboard that was active when the password was typed (the one the installer was changed
#to, or the live session's own, as the probe said it) and the time zone the installer showed (the one
#chosen there, or the one an install starts on)
if [ -f "${out}/${name}.serial.log" ]; then
    _expected__keyboard="${keyboard:-$(sed -n 's/^probe: keyboard active: //p' "${out}/${name}.serial.log" | tr -d '\r' | head -n 1)}"
    _expected__zone="${zone:-${default_zone}}"
    awk -v want="hostname: minos; keyboard: XKBLAYOUT=\"${_expected__keyboard}\"" '/^hostname: / {n++; if ($0 != want) bad++} END {exit !(n && !bad)}' "${facts}" ||
        _die "the disk's keyboard is not ${_expected__keyboard}, the one the password was typed with: $(grep '^hostname: ' "${facts}" | tail -n 1)"
    #/etc/localtime names it, and /etc/timezone, on a release whose tzdata still writes one, the same
    awk -v want="${_expected__zone}" '/^timezone: / {n++; if ($0 != "timezone: " want "; localtime: " want && $0 != "timezone: ; localtime: " want) bad++}
        END {exit !(n && !bad)}' "${facts}" ||
        _die "the disk's time zone is not ${_expected__zone}, the one the installer showed: $(grep '^timezone: ' "${facts}" | tail -n 1)"
    #and its own system, booted, says so: timedatectl names that zone, as far from UTC as the disk's zone
    #files put it, and date tells the time by that zone's name
    case " ${phases} " in *" boot "*)
        _expected__clock="$(sed -n "s|^clock: zone file: \(${_expected__zone} (.*)\)\$|\1|p" "${facts}" | head -n 1)"
        [ -n "${_expected__clock}" ] || _die "the disk's zone files do not say what ${_expected__zone} is: $(grep '^clock: zone file: ' "${facts}" | head -n 1)"
        grep -q -x -F "clock: timedatectl: Time zone: ${_expected__clock}" "${facts}" ||
            _die "the disk's own system, booted, does not say its time zone is ${_expected__clock}: $(grep '^clock: timedatectl: Time zone' "${facts}" | head -n 1)"
        _expected__letters="${_expected__clock#*\(}"; _expected__letters="${_expected__letters%%,*}"
        grep -q "^clock: date: .* ${_expected__letters} [0-9]*\$" "${facts}" ||
            _die "the disk's own system, booted, does not tell the time in ${_expected__letters}: $(grep '^clock: date: ' "${facts}" | head -n 1)"
        ;;
    esac
fi
awk '/^i3 config: / {n++; if ($0 != "i3 config: 0 lines naming minos-installer") bad++} END {exit !(n && !bad)}' "${facts}" ||
    _die "the disk's i3 configuration is missing, or still names the installer"
if [ "${layout}" = "beside" ]; then
    grep -q "^kept: the partition beside minos: a file of the system that was here" "${facts}" ||
        _die "the partition beside minos lost its file"
    [ "${firmware}" = "bios" ] || grep -q "^kept: the EFI system partition: another system's boot loader" "${facts}" ||
        _die "the EFI system partition lost the other system's file"
fi
if [ "${layout}" = "home" ]; then
    grep -q "^home: its own partition, [0-9]*M, mounted on /home by fstab; in it: ${user} " "${facts}" ||
        _die "/home is not on a partition of its own with ${user}'s home in it"
fi
case " ${phases} " in *" boot "*)
    #the reading after the boot with no network: on a copy of the ISO, minos-untrim tried, failed for want
    #of an archive, and stays enabled to try again
    awk -v title="== ${name}: the disk alone, no network" '$0 == title {s = ""; on = 1; next} /^== / {on = 0}
        on {s = s $0 "\n"} END {printf "%s", s}' "${facts}" > "${run}/offline"
    if grep -q "^present: /var/lib/minos/live-trimmed" "${run}/offline"; then
        grep -q "^untrim: .*minos-untrim: no package list" "${run}/offline" ||
            _die "with no network, minos-untrim did not try, or did not say it reached no archive"
        grep -q "^journal: .*minos-untrim.service: Main process exited, code=exited, status=1/FAILURE" "${run}/offline" ||
            _die "with no network, minos-untrim did not fail"
        grep -q "^minos-untrim.service: enabled" "${run}/offline" ||
            _die "with no network, minos-untrim.service disabled itself"
    fi
    ;;
esac
case " ${phases} " in *" untrim "*)
    #the last reading, after minos-untrim
    awk '/^== / {last = ""} {last = last $0 "\n"} END {printf "%s", last}' "${facts}" > "${run}/last"
    grep -q "^dpkg --verify: [0-9]* files missing, 0 of them kernel modules or firmware" "${run}/last" ||
        _die "kernel modules or firmware still missing after minos-untrim"
    grep -q "^minos-untrim.service: disabled" "${run}/last" || _die "minos-untrim.service is still enabled"
    ;;
esac
_step "checked: ${facts}"

