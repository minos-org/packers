#!/bin/sh
#the engine of the minos ISO's installer: what it knows of this machine (the firmware it started by, its
#disks and what each holds), a plan to put minos on a disk (what will be done, in order, as text), and
#that plan applied, once. It asks nothing and draws nothing: an interface (minos-installer, beside it)
#shows what the engine says, asks the person, has the engine make or change the plan and has it applied.
#Nothing is written to a disk before apply. minos itself is installed by the minos installer the medium
#carries (setup live desktop), which copies the live system and needs no network.
#usage: minos-installer-engine [--try] [--firmware uefi|bios] VERB [ARGUMENT...]
#  facts                    what plans are made for here, "name value" a line: firmware (uefi, bios),
#                           root-mib (the least a partition for minos takes), esp-mib (the EFI system
#                           partition the engine makes), system-mib (what is copied), medium (the disk
#                           the session runs from, or -), try (yes, no), log (where apply keeps what was
#                           said), progress (where it keeps how far it is), applying (the process of an
#                           apply that is running, or -), timezone (the one the installed system
#                           takes unless another is chosen: the timezone verb's)
#  disks [PID]              the machine's disks, a line each, tab-separated: device, size, model, why
#                           minos cannot go to it (- when it can), what it holds (empty, or its partitions);
#                           with PID, read only while that process lives: once it is gone, exit 1, the rest
#                           unread (an interface that reads them in the background, and is closed)
#  partitions [DISK]        the partitions of DISK, or of every disk minos can go to, a line each,
#                           tab-separated: device, size, what it can be for minos (root, esp, small: too
#                           small for it, or -), what it holds, its type
#  show DISK                what DISK holds, for people
#  needs                    what this firmware needs of partitions made by hand, for people
#  plan whole DISK          a plan that takes the whole of DISK, erased
#  plan partitions ROOT [ESP] [keep]
#                           a plan that takes partitions that exist: ROOT for minos, formatted unless
#                           it is ext4 and keep is said; on UEFI the EFI system partition ESP, formatted
#                           unless it is FAT already
#  edit DISK FILE [CHOICE...]
#                           the plan the CHOICEs make for DISK, written to FILE; with none, the plan the
#                           engine suggests. On stdout, rows for an interface (below): the choices as
#                           the engine took them, the lines of the plan that can be changed and what
#                           each can be changed to, and the rows of review
#  review PLAN [DISK]       PLAN as rows for an interface (below): what stops it, DISK (the disk minos
#                           goes to) now and once it is applied, what is done in words, what is lost,
#                           and the name of the deed
#  check PLAN               what stops PLAN (a file) from being applied here, a line each; exit 1 then
#  describe PLAN            PLAN for people: what is done, in order, and what is lost
#  user NAME                why minos takes no user of that name; nothing, and exit 0, when it does
#  password                 the same for a password, read from stdin, a line
#  apply PLAN USER          PLAN applied, in order, and minos installed for USER, whose password is
#                           read from stdin, a line. What is said also goes to /tmp/minos-installer.log,
#                           how far it is to /tmp/minos-installer.progress, and how it ended (the exit
#                           status) to /tmp/minos-installer.status
#  empty DISK               with --try: DISK left with no partition table and no file system
#  keyboard                 the keyboard that is active, "layout variant where": where is x when it is
#                           the X session's, as setxkbmap says it (also after a key of the desktop
#                           changed it), or system when there is no X: the one the system was set to
#                           (/etc/default/keyboard), which is the console's. Needs no root
#  keyboard set LAYOUT [VARIANT]
#                           LAYOUT made the keyboard of the X session, by the user it is run as. The
#                           console's is not changed from here: it is said so, and exit 1
#  keyboard keys            what each key of the X session's keyboard says, as xmodmap -pke lists it:
#                           a line a key, its keysyms by group and level. Exit 1 with no X session or
#                           no xmodmap. Needs no root
#  keyboards                the layouts to choose from, a line each, tab-separated: layout, its name,
#                           own or other: minos' own list first (minos-config keyboard-layouts), then
#                           every layout xkb knows. Needs no root
#  timezone                 the time zone an install starts on: the first of minos' own that this
#                           system has, and this session's when it has none of them. Needs no root
#  timezones                the time zones to choose from, a line each, tab-separated: zone, own or
#                           other: minos' own first, in their order, then every other zone this system's
#                           tzdata knows and has a file for, as its own index says them. Needs no root
#  filesystems              the file systems a partition for minos or for /home is made with, a line
#                           each, tab-separated: name, default or -, the package of its tools, here or
#                           missing (its mkfs on this system: a missing one is not offered), and what it
#                           is good at, for people. Needs no root
#  --try        on a machine that is not the live session: apply writes the disk for real, then says
#               the setup command it would run, and does not run it
#  --firmware   with --try, the firmware plans are for, whatever this machine started by
#a plan is text, an action a line, applied from the top (# starts a comment):
#  table DISK gpt|dos            a new, empty partition table on DISK: all it holds goes
#  partition PART SIZE TYPE [START]
#                                PART made: SIZE in MiB, or rest (the last one of a new table); TYPE esp,
#                                linux or bios-boot. On a disk that got a table, after the ones before
#                                it; on a disk that keeps its table, in free room, START MiB into the disk
#  format PART fat32|FS          a new file system on PART: what it holds goes. FS is one of the
#                                filesystems verb's: ext4, btrfs, xfs
#  esp PART                      the EFI system partition the boot loader goes to (UEFI)
#  root PART                     the partition minos is copied to
#  home PART                     the partition that is /home (none: /home is in the one of minos)
#  keyboard LAYOUT [VARIANT]     the keyboard of the installed system: the one the password was typed
#                                with (none: setup takes the one of the system it runs from)
#  timezone ZONE                 the time zone of the installed system (none: setup takes the one of
#                                the system it runs from)
#a choice is a word, KEY=VALUE:
#  use=whole|parts               the whole disk, erased, or the partitions and free room it has
#  root=new[:MIB]                (whole) minos takes the room there is, or MIB
#  root=none|PART|free:START[:MIB]
#                                (parts) minos goes to a partition that exists, or to a new one in the
#                                free room that starts START MiB into the disk, all of it or MIB
#  rootfs=format|keep            a partition that exists is formatted, or keeps its ext4 and its files
#  roottype=FS                   the file system the partition for minos is made with, when it is made
#                                or formatted: one the filesystems verb offers (the default when not)
#  home=none|new:MIB|PART|free:START[:MIB]    homefs=format|keep    hometype=FS    the same for /home
#  esp=auto|PART  espfs=auto|format           the EFI system partition: the one found, formatted only
#                                when it is not FAT; or PART, or formatted whatever it holds
#  keyboard=LAYOUT[:VARIANT]     the keyboard of the installed system
#  timezone=ZONE                 the time zone of the installed system
#rows are tab-separated, the first field says what the row is, and no field is empty (- stands for none):
#  choices WORDS                             the choices as taken, to give back changed
#  disk DEVICE SIZE MODEL HOLDS              the disk the plan is for
#  line ID LABEL VALUE NOTE TONE             a line of the plan: TONE plain, new, erase or off
#  option ID WORDS TEXT current|-            what line ID can be instead: WORDS are the choices to add
#  size ID KEY MIB LEAST MOST STEP           line ID has a size: KEY followed by a number of MiB, a choice
#  fs ID HEADING                             line ID (roottype, hometype) is the file system of a
#                                            partition: HEADING says which, for people. Its options are
#                                            the file systems offered, none when it is kept with its files
#  problem TEXT                              what stops the plan
#  now|after DEVICE MIB SIZE KIND HOLDS NAME FATE MOUNT
#                                            a partition or a free room (DEVICE free) of the disk, in
#                                            order: KIND esp, bios-boot, frame, data or free; FATE kept,
#                                            erased or gone (now), new, formatted or kept (after)
#  action erase|make|keep|copy TEXT          what is done, in order
#  loss none|some TEXT                       what is lost
#  button plain|danger TEXT                  the name of the deed, for the one confirmation
#runs as root; needs lsblk, findmnt, blkid, wipefs, blockdev and swapoff (util-linux), sfdisk (fdisk),
#mkfs.ext4 (e2fsprogs), udevadm, and mkfs.vfat (dosfstools) or busybox's mkdosfs; mkfs.btrfs
#(btrfs-progs) and mkfs.xfs (xfsprogs) for those two to be offered

set -u
LC_ALL=C; export LC_ALL
setup="/cdrom/minos/setup"; log="/tmp/minos-installer.log"; status="/tmp/minos-installer.status"
progress="/tmp/minos-installer.progress"; pidfile="/tmp/minos-installer.pid"
#the EFI system partition made on a whole disk: the boot loader takes 10M of it, firmware updates more
esp_mib=512
#the least a partition of its own for /home is worth
home_mib=256
#the file systems a partition for minos or for /home is made with, a line each, tab-separated: its name,
#the package of its tools, the mkfs that makes one (the label follows it, then the partition), and what
#it is good at, for people; the first is the default. Nothing else names them: the ISO's build installs
#their tools (the filesystems verb), and setup's live mode writes the fstab line of each one it knows
filesystems="ext4	e2fsprogs	mkfs.ext4 -q -F -L	mature, quick to check, what Ubuntu installs
btrfs	btrfs-progs	mkfs.btrfs -q -f -L	snapshots, checksums; slower with databases and VM disks
xfs	xfsprogs	mkfs.xfs -q -f -L	large files, parallel writes; it grows but never shrinks"
#the one a partition that exists keeps with its files, minos copied over them: setup's live mode copies
#onto what it mounts, and a btrfs or an xfs kept would need a decision of its own (which subvolume)
kept_fs="ext4"
#minos' own time zones, in their order: an install starts on the first, and the three head the list of
#zones. Nothing else names them: the ISO's build asks for the first one here (the timezone verb)
timezones_own="America/Mexico_City America/Caracas America/New_York"
#the types the firmware looks for, as blkid says them: the EFI system partition's on a GPT and on an MBR,
#and the partition GRUB keeps itself in when BIOS starts a GPT disk
esp_types="c12a7328-f81f-11d2-ba4b-00a0c93ec93b 0xef"
bios_boot_type="21686148-6449-6e6f-744e-656564454649"
tab="$(printf '\t')"

_die() { #message => on stderr, exit 1
    printf "%s\n" "minos-installer-engine: ${*}" >&2
    exit 1
}

_usage() { #=> the usage, on stderr, exit 2
    sed -n '8,114s/^#//p' "${0}" >&2
    exit 2
}

_say() { #message => a line of the engine's own among what the tools say
    printf "\n[minos installer] %s\n" "${*}"
}

_applying() { #=> the process of an apply that is running; nothing when none is
    _applying__pid="$(cat "${pidfile}" 2>/dev/null)"
    [ -z "${_applying__pid}" ] || [ ! -d "/proc/${_applying__pid}" ] || printf "%s" "${_applying__pid}"
}

_fs_default() { #=> the name of the file system a partition is made with unless another is chosen
    printf "%s" "${filesystems%%"${tab}"*}"
}

_fs_field() { #name number => field NUMBER of the line of the file system NAME; nothing when it is none
    printf "%s\n" "${filesystems}" | awk -F '\t' -v name="${1}" -v n="${2}" '$1 == name {print $n; exit}'
}

_fs_offered() { #=> the names of the file systems this system can make, a line each, in their order: the
    #ones whose mkfs is here
    printf "%s\n" "${filesystems}" | while IFS="${tab}" read -r _fs_offered__name _ _fs_offered__mkfs _; do
        ! command -v "${_fs_offered__mkfs%% *}" >/dev/null 2>&1 || printf "%s\n" "${_fs_offered__name}"
    done
}

_is_offered() { #name => true when NAME is a file system this system can make
    _fs_offered | grep -qxF -e "${1}"
}

_fs_words() { #=> the names of the file systems, for people: ext4, btrfs or xfs
    printf "%s\n" "${filesystems}" | awk -F '\t' '{name[NR] = $1}
        END {for (i = 1; i <= NR; i++) printf "%s%s", name[i], (i == NR ? "" : (i == NR - 1 ? " or " : ", "))}'
}

_fs_list() { #=> the filesystems verb
    printf "%s\n" "${filesystems}" | while IFS="${tab}" read -r _fs_list__name _fs_list__package _ _fs_list__text; do
        _row "${_fs_list__name}" "$([ "${_fs_list__name}" != "$(_fs_default)" ] || printf default)" "${_fs_list__package}" \
            "$(_is_offered "${_fs_list__name}" && printf here || printf missing)" "${_fs_list__text}"
    done
}

_or_dash() { #text => TEXT, or - when there is none: no field of a line is ever empty
    printf "%s" "${1:--}"
}

_human() { #MiB => the size as lsblk says sizes: 512M, 15.5G, 1.8T
    awk -v mib="${1}" 'BEGIN {
        if (mib < 1024) printf "%dM", mib
        else if (mib < 1048576) printf "%.1fG", mib / 1024
        else printf "%.1fT", mib / 1048576 }'
}

_row() { #field... => a row: the fields, tab-separated
    _row__line="${1}"; shift
    for _row__field; do _row__line="${_row__line}${tab}${_row__field:--}"; done
    printf "%s\n" "${_row__line}"
}

################################################################################
# The machine: its disks and what they hold
################################################################################

_watched() { #=> nothing while the process the disks are read for lives (or none was named); once it is
    #gone, the engine exits. Looked at before each disk and each partition: what reads one is the most
    #that runs on after it
    [ -z "${watched}" ] || [ -d "/proc/${watched}" ] || exit 1
}

_mib() { #device => its size in MiB, as the kernel has it
    { read -r _mib__sectors < "/sys/class/block/${1#/dev/}/size"; } 2>/dev/null || _mib__sectors=0
    printf "%s" "$((_mib__sectors / 2048))"
}

_is_disk() { #device => true when it is a whole disk
    [ -b "${1}" ] && [ "$(lsblk -dno TYPE "${1}" 2>/dev/null | tr -d ' ')" = "disk" ]
}

_is_partition() { #device => true when it is a partition that exists
    [ -b "${1}" ] && [ -f "/sys/class/block/${1#/dev/}/partition" ]
}

_model() { #disk => its model, as people read it on its label; nothing when it says none
    lsblk -dno MODEL "${1}" 2>/dev/null | tr -cd ' -~' | sed 's/^ *//; s/ *$//; s/  */ /g'
}

_describe_disk() { #disk [most] => its model, size and name: VBOX HARDDISK 16G (sdb); the model cut at MOST
    #characters
    _describe_disk__model="$(_model "${1}" | cut -c1-"${2:-40}" | sed 's/ *$//')"
    printf "%s%s (%s)" "${_describe_disk__model:+${_describe_disk__model} }" \
        "$(lsblk -dno SIZE "${1}" | tr -d ' ')" "${1#/dev/}"
}

_disk_refusal() { #disk => why minos cannot go to it, in a few words; nothing when it can. Swap in use on
    #it is no reason: the live session turns on every swap partition it finds (casper), and apply turns
    #off the ones in its way
    if [ "${1#/dev/}" = "${medium}" ]; then
        printf "%s" "this live session runs from it"
    elif [ "$(lsblk -dno RO "${1}" | tr -d ' ')" != "0" ]; then
        printf "%s" "it cannot be written"
    elif [ "$(_mib "${1}")" = "0" ]; then
        printf "%s" "there is no medium in it"
    else
        lsblk -lno NAME,MOUNTPOINT "${1}" | awk '
            $2 != "" && $2 != "[SWAP]" {printf "it is in use: %s is mounted on %s", $1, $2; exit}'
    fi
}

_whole_disks() { #=> every disk of the machine, a /dev name a line: no CD, no loop, no memory device
    lsblk -dnpo NAME,TYPE | while read -r _whole_disks__name _whole_disks__type; do
        [ "${_whole_disks__type}" = "disk" ] || continue
        case "${_whole_disks__name}" in /dev/zram*|/dev/ram*|/dev/fd*) continue ;; esac
        printf "%s\n" "${_whole_disks__name}"
    done
}

_partition_name() { #disk number => the name the kernel gives that partition of it: sda1, nvme0n1p1
    case "${1}" in
        *[0-9]) printf "%sp%s" "${1}" "${2}" ;;
        *) printf "%s%s" "${1}" "${2}" ;;
    esac
}

_partition_number() { #partition => its number, by its name
    printf "%s" "${1}" | sed 's/.*[^0-9]\([0-9][0-9]*\)$/\1/'
}

_disk_of() { #partition => its disk: of one that exists, as the kernel has it; of one a plan is to make,
    #by its name
    if [ -f "/sys/class/block/${1#/dev/}/partition" ]; then
        _disk_of__dir="$(dirname "$(readlink -f "/sys/class/block/${1#/dev/}")")"
        printf "/dev/%s" "${_disk_of__dir##*/}"
    else
        _disk_of__name="$(printf "%s" "${1}" | sed 's/[0-9]*$//')"
        case "${_disk_of__name}" in *[0-9]p) _disk_of__name="${_disk_of__name%p}" ;; esac
        printf "%s" "${_disk_of__name}"
    fi
}

_scan() { #=> map, a file: every partition of the machine's disks, a line each, tab-separated, in the
    #order of the disk: 1 device, 2 its disk, 3 its number, 4 where it starts and 5 its size (MiB),
    #6 where it ends (MiB, rounded up), 7 what it is to the firmware (esp, bios-boot, frame: an MBR's
    #extended partition, or data), 8 its file system and 9 its label, both read from the device (- for
    #none), 10 its type's name. Read once: every question about a partition is answered from it
    : > "${map}"
    _watched
    for _scan__disk in $(_whole_disks); do
        _watched
        _scan__names="$(lsblk -lnpo NAME,PARTTYPENAME "${_scan__disk}" 2>/dev/null)"
        for _scan__file in "/sys/block/${_scan__disk#/dev/}"/*/partition; do
            [ -f "${_scan__file}" ] || continue
            _watched
            _scan__dir="${_scan__file%/partition}"; _scan__part="/dev/${_scan__dir##*/}"
            read -r _scan__number < "${_scan__file}"
            read -r _scan__start < "${_scan__dir}/start"
            read -r _scan__size < "${_scan__dir}/size"
            _scan__type=""; _scan__fs=""; _scan__label=""
            # shellcheck disable=SC2162 # blkid escapes spaces and quotes with a backslash: read takes it out
            while IFS="=" read _scan__key _scan__value; do
                case "${_scan__key}" in
                    TYPE) _scan__fs="${_scan__value}" ;;
                    LABEL) _scan__label="${_scan__value}" ;;
                    PART_ENTRY_TYPE) _scan__type="${_scan__value}" ;;
                esac
            done << E=O=F
$(blkid -p -o export "${_scan__part}" 2>/dev/null)
E=O=F
            _scan__type="$(printf "%s" "${_scan__type}" | tr 'A-F' 'a-f')"
            _scan__kind="data"
            case " ${esp_types} " in *" ${_scan__type} "*) _scan__kind="esp" ;; esac
            case "${_scan__type}" in
                "${bios_boot_type}") _scan__kind="bios-boot" ;;
                0x5|0xf|0x85) _scan__kind="frame" ;;
            esac
            _row "${_scan__part}" "${_scan__disk}" "${_scan__number}" "$((_scan__start / 2048))" \
                "$((_scan__size / 2048))" "$(((_scan__start + _scan__size + 2047) / 2048))" "${_scan__kind}" \
                "${_scan__fs}" "$(printf "%s" "${_scan__label}" | tr -cd ' -~' | cut -c1-24)" \
                "$(printf "%s\n" "${_scan__names}" | awk -v part="${_scan__part}" '$1 == part {$1 = ""; sub(/^ /, ""); print; exit}')" >> "${map}"
        done
    done
    sort -t "${tab}" -k 2,2 -k 4,4n -k 3,3n -o "${map}" "${map}"
}

_of() { #partition field => that field of its line in map (the numbers of _scan); nothing when it is not there
    awk -F '\t' -v device="${1}" -v field="${2}" '$1 == device {print $field; exit}' "${map}"
}

_partitions() { #disk => its partitions, a /dev name a line, in the order of the disk
    awk -F '\t' -v disk="${1}" '$2 == disk {print $1}' "${map}"
}

_table_now() { #disk => the partition table it has, gpt or dos; nothing when it has none
    blkid -p -o value -s PTTYPE "${1}" 2>/dev/null
}

_disk_fs() { #disk => the file system, or other signature, a disk with no partition table holds on the whole
    #of itself (a stick formatted whole, an LVM or LUKS volume); nothing when it has none
    [ -n "$(_table_now "${1}")" ] || blkid -p -o value -s TYPE "${1}" 2>/dev/null
}

_file_system() { #partition => the file system on it; nothing when it has none
    _file_system__type="$(_of "${1}" 8)"
    [ "${_file_system__type:--}" = "-" ] || printf "%s" "${_file_system__type}"
}

_kind_now() { #partition => what it is to the firmware, by its type: esp, bios-boot, frame or data
    _of "${1}" 7
}

_holds() { #partition => what is on it, for people: ext4 "label", or that it holds no file system
    _holds__type="$(_file_system "${1}")"; _holds__label="$(_of "${1}" 9)"
    if [ -z "${_holds__type}" ]; then
        printf "%s" "no file system"
    elif [ "${_holds__label:--}" = "-" ]; then
        printf "%s" "${_holds__type}"
    else
        printf "%s \"%s\"" "${_holds__type}" "${_holds__label}"
    fi
}

_name_now() { #partition => what people call it: its label, or what it is (boot, grub, swap, its file
    #system), or blank when it holds nothing
    _name_now__label="$(_of "${1}" 9)"; _name_now__type="$(_file_system "${1}")"
    case "$(_kind_now "${1}")" in
        esp) printf "%s" "boot"; return 0 ;;
        bios-boot) printf "%s" "grub"; return 0 ;;
        frame) printf "%s" "extended"; return 0 ;;
    esac
    if [ "${_name_now__label:--}" != "-" ]; then
        printf "%s" "${_name_now__label}"
    else
        printf "%s" "${_name_now__type:-blank}"
    fi
}

_holds_summary() { #disk => what it holds, in a few words: empty, or its partitions by their names
    _holds_summary__fs="$(_disk_fs "${1}")"
    [ -z "${_holds_summary__fs}" ] || { printf "%s\n" "${_holds_summary__fs} on the whole disk"; return 0; }
    awk -F '\t' -v disk="${1}" '
        $2 == disk && $7 != "frame" {n++; if (n <= 3) names = names (n > 1 ? ", " : "") ($7 == "esp" ? "boot" : ($7 == "bios-boot" ? "grub" : ($9 != "-" ? $9 : ($8 != "-" ? $8 : "blank"))))}
        END {if (!n) print "empty"; else printf "%s%s\n", names, (n > 3 ? ", " n - 3 " more" : "")}' "${map}"
}

_free() { #disk => its free rooms a partition can be made in, of 2M or more, "start mib" a line: none on
    #a disk with no table, none on an MBR whose four partitions are taken
    case "$(_table_now "${1}")" in
        "") return 0 ;;
        dos) [ "$(awk -F '\t' -v disk="${1}" '$2 == disk && $3 <= 4' "${map}" | grep -c .)" -lt 4 ] || return 0 ;;
    esac
    _layout "${1}" now | awk '$1 == "free" {print $3, $2}'
}

_list_disks() { #=> the disks verb
    for _list_disks__disk in $(_whole_disks); do
        _watched
        _row "${_list_disks__disk}" "$(lsblk -dno SIZE "${_list_disks__disk}" | tr -d ' ')" \
            "$(_model "${_list_disks__disk}")" "$(_disk_refusal "${_list_disks__disk}")" \
            "$(_holds_summary "${_list_disks__disk}")"
    done
}

_usable_disks() { #=> the disks minos can go to, a line each
    for _usable_disks__disk in $(_whole_disks); do
        [ -n "$(_disk_refusal "${_usable_disks__disk}")" ] || printf "%s\n" "${_usable_disks__disk}"
    done
}

_list_partitions() { #[disk] => the partitions verb
    if [ -n "${1}" ]; then
        _list_partitions__disks="${1}"
    else
        _list_partitions__disks="$(_usable_disks)"
    fi
    for _list_partitions__disk in ${_list_partitions__disks}; do
        for _list_partitions__partition in $(_partitions "${_list_partitions__disk}"); do
            case "$(_kind_now "${_list_partitions__partition}")" in
                esp) _list_partitions__use="esp" ;;
                data) _list_partitions__use="root"
                      [ "$(_mib "${_list_partitions__partition}")" -ge "${root_mib}" ] || _list_partitions__use="small" ;;
                *) _list_partitions__use="-" ;;
            esac
            _row "${_list_partitions__partition}" "$(_human "$(_mib "${_list_partitions__partition}")")" \
                "${_list_partitions__use}" "$(_holds "${_list_partitions__partition}")" \
                "$(_of "${_list_partitions__partition}" 10)"
        done
    done
}

_show_disk() { #disk => the show verb: a line a partition, or that it has none
    if [ -z "$(_partitions "${1}")" ]; then
        printf "%s\n" "$(_describe_disk "${1}") is empty: it has no partitions."
        return 0
    fi
    printf "%s\n" "$(_describe_disk "${1}") holds now:" ""
    _list_partitions "${1}" | awk -F '\t' '
        {printf "  %-10s %6s  %-22s %s\n", substr($1, 6), $2, substr($4, 1, 22), substr($5, 1, 24)}'
}

_show_needs() { #=> the needs verb
    if [ "${firmware}" = "uefi" ]; then
        printf "%s\n" "This computer started by UEFI. minos needs two partitions:" "" \
            "  an EFI system partition: $(_human "${esp_mib}"), of type \"EFI System\"" \
            "  one for minos: $(_human "${root_mib}") or more, of type \"Linux filesystem\"" "" \
            "On an empty disk, the partition table (the label) to make is gpt."
    else
        printf "%s\n" "This computer started by BIOS. minos needs one partition, of" \
            "$(_human "${root_mib}") or more and of type \"Linux\"." "" \
            "On an empty disk, the partition table (the label) to make is dos." \
            "With gpt, GRUB needs one partition more: 1M, of type \"BIOS boot\"."
    fi
}

################################################################################
# The keyboard: the one that is active, and the ones there are
################################################################################

_keyboard_layouts() { #=> every layout xkb knows, "layout<TAB>name" a line, as its rules list them
    awk '/^! layout/ {on = 1; next} /^!/ {on = 0}
        on && NF {layout = $1; $1 = ""; sub(/^ +/, ""); printf "%s\t%s\n", layout, $0}' /usr/share/X11/xkb/rules/base.lst 2>/dev/null
}

_keyboard_now() { #=> the keyboard that is active, "layout variant where". In an X session, what the X
    #server has (setxkbmap -query; the first layout when it holds several): a key of the desktop may
    #have changed it since any file was written. With no X, what the system was set to, the console's
    if [ -n "${DISPLAY:-}" ] && command -v setxkbmap >/dev/null 2>&1 && _keyboard_now__query="$(setxkbmap -query 2>/dev/null)"; then
        printf "%s\n" "${_keyboard_now__query}" | awk '
            $1 == "layout:" {layout = $2; sub(/,.*/, "", layout)} $1 == "variant:" {variant = $2; sub(/,.*/, "", variant)}
            END {printf "%s %s x\n", (layout == "" ? "us" : layout), (variant == "" ? "-" : variant)}'
    else
        (   XKBLAYOUT=""; XKBVARIANT=""
            # shellcheck source=/dev/null # the system's own file, shell assignments
            [ ! -f /etc/default/keyboard ] || . /etc/default/keyboard
            XKBLAYOUT="${XKBLAYOUT%%,*}"; XKBVARIANT="${XKBVARIANT%%,*}"
            printf "%s %s system\n" "${XKBLAYOUT:-us}" "${XKBVARIANT:--}" )
    fi
}

_keyboard_set() { #layout [variant] => LAYOUT made the keyboard of the X session; false, and why on stderr,
    #when it is no layout or there is no X session to set it in
    _keyboard_layouts | cut -f1 | grep -qxF "${1}" || { printf "%s\n" "${1} is no keyboard layout xkb knows." >&2; return 1; }
    case "${2:-}" in *[!a-zA-Z0-9_-]*) printf "%s\n" "${2} is no variant of a keyboard layout." >&2; return 1 ;; esac
    if [ -n "${DISPLAY:-}" ] && command -v setxkbmap >/dev/null 2>&1; then
        setxkbmap "${1}" ${2:+-variant "${2}"}
    else
        printf "%s\n" "The console's keyboard is not changed from the installer: the installed system takes the one this system was set to." >&2
        return 1
    fi
}

_keyboard_list() { #=> the keyboards verb: minos' own layouts, in their order, then the others
    _keyboard_list__own="$(minos-config keyboard-layouts 2>/dev/null | tr ',' ' ')"
    _keyboard_list__all="$(_keyboard_layouts)"
    for _keyboard_list__layout in ${_keyboard_list__own}; do
        printf "%s\n" "${_keyboard_list__all}" | awk -F '\t' -v layout="${_keyboard_list__layout}" '$1 == layout {printf "%s\t%s\town\n", $1, $2}'
    done
    printf "%s\n" "${_keyboard_list__all}" | awk -F '\t' -v own=" ${_keyboard_list__own} " 'NF == 2 && index(own, " " $1 " ") == 0 {printf "%s\t%s\tother\n", $1, $2}'
}

_timezone_now() { #=> the time zone of this system: the one its clock really follows, the zone /etc/localtime
    #links to, under the name it was set by; /etc/timezone when that is no link; Etc/UTC when neither says
    _timezone_now__zone="$(readlink /etc/localtime 2>/dev/null | sed -n 's|^.*/zoneinfo/||p')"
    [ -n "${_timezone_now__zone}" ] || _timezone_now__zone="$(cat /etc/timezone 2>/dev/null)"
    printf "%s" "${_timezone_now__zone:-Etc/UTC}"
}

_timezone_default() { #=> the timezone verb: the zone an install starts on, the first of minos' own that
    #this system has; this session's when it has none of them
    for _timezone_default__zone in ${timezones_own}; do
        [ ! -f "/usr/share/zoneinfo/${_timezone_default__zone}" ] || { printf "%s" "${_timezone_default__zone}"; return 0; }
    done
    _timezone_now
}

_timezone_list() { #=> the timezones verb, "zone<TAB>own|other" a line: minos' own first, in their order,
    #then every other zone this system's tzdata knows, as its own index says them (tzdata.zi: a Z line
    #a zone, an L line another name of one). From 24.04 on the index still lists the old names
    #(US/Pacific, Mexico/General), which live in another package: a name with no file is left out.
    #Factory, the zone of a clock nobody set, is no choice
    for _timezone_list__zone in ${timezones_own}; do
        [ ! -f "/usr/share/zoneinfo/${_timezone_list__zone}" ] || printf "%s\town\n" "${_timezone_list__zone}"
    done
    awk '$1 == "Z" && $2 != "Factory" {print $2} $1 == "L" {print $3}' /usr/share/zoneinfo/tzdata.zi 2>/dev/null | sort -u |
        while IFS= read -r _timezone_list__zone; do
            [ -f "/usr/share/zoneinfo/${_timezone_list__zone}" ] || continue
            case " ${timezones_own} " in *" ${_timezone_list__zone} "*) continue ;; esac
            printf "%s\tother\n" "${_timezone_list__zone}"
        done
}

_is_timezone() { #zone => true when ZONE is the name of a zone this system has
    case "${1}" in ""|*[!a-zA-Z0-9_+/-]*|/*) return 1 ;; esac
    [ -f "/usr/share/zoneinfo/${1}" ]
}

################################################################################
# The plan
################################################################################

_plan() { #action [device] => the lines of plan (a file) that are ACTION, about DEVICE when one is named:
    #their words after the action
    awk -v action="${1}" -v device="${2:-}" '
        $1 == action && (device == "" || $2 == device) {$1 = ""; sub(/^ /, ""); print}' "${plan}"
}

_plan_one() { #action => the device of the first line of plan that is ACTION; nothing when there is none
    _plan "${1}" | awk 'NR == 1 {print $1}'
}

_whole_table() { #disk => the table a whole disk gets for this firmware: UEFI reads a GPT, BIOS an MBR,
    #which cannot hold a disk over 2T
    if [ "${firmware}" = "uefi" ] || [ "$(_mib "${1}")" -gt 2097152 ]; then
        printf "%s" gpt
    else
        printf "%s" dos
    fi
}

_plan_whole() { #disk [root-mib [home-mib [root-fs [home-fs]]]] => a plan for the whole of DISK and this
    #firmware: what the firmware starts from (an EFI system partition; on a GPT that BIOS starts, the
    #partition GRUB needs for itself), the partition for minos, of ROOT-MIB or (-) the room there is, and
    #with HOME-MIB one for /home, which then takes what minos leaves; each made ROOT-FS and HOME-FS, the
    #default file system when not said
    _is_disk "${1}" || _die "${1} is not a disk"
    _plan_whole__table="$(_whole_table "${1}")"; _plan_whole__n=0; _plan_whole__fixed=0; _plan_whole__esp=""
    printf "%s\n" "table ${1} ${_plan_whole__table}"
    if [ "${firmware}" = "uefi" ]; then
        _plan_whole__n=1; _plan_whole__fixed="${esp_mib}"; _plan_whole__esp="$(_partition_name "${1}" 1)"
        printf "%s\n" "partition ${_plan_whole__esp} ${esp_mib} esp"
    elif [ "${_plan_whole__table}" = "gpt" ]; then
        _plan_whole__n=1; _plan_whole__fixed=1
        printf "%s\n" "partition $(_partition_name "${1}" 1) 1 bios-boot"
    fi
    _plan_whole__root="$(_partition_name "${1}" "$((_plan_whole__n + 1))")"
    _plan_whole__size="${2:--}"; _plan_whole__home=""
    if [ "${3:--}" != "-" ]; then
        _plan_whole__home="$(_partition_name "${1}" "$((_plan_whole__n + 2))")"
        if [ "${_plan_whole__size}" = "-" ]; then
            printf "%s\n" "partition ${_plan_whole__root} $(($(_mib "${1}") - 2 - _plan_whole__fixed - ${3})) linux" \
                "partition ${_plan_whole__home} rest linux"
        else
            printf "%s\n" "partition ${_plan_whole__root} ${_plan_whole__size} linux" "partition ${_plan_whole__home} ${3} linux"
        fi
    elif [ "${_plan_whole__size}" = "-" ]; then
        printf "%s\n" "partition ${_plan_whole__root} rest linux"
    else
        printf "%s\n" "partition ${_plan_whole__root} ${_plan_whole__size} linux"
    fi
    [ -z "${_plan_whole__esp}" ] || printf "%s\n" "format ${_plan_whole__esp} fat32"
    printf "%s\n" "format ${_plan_whole__root} ${4:-$(_fs_default)}"
    [ -z "${_plan_whole__home}" ] || printf "%s\n" "format ${_plan_whole__home} ${5:-$(_fs_default)}"
    [ -z "${_plan_whole__esp}" ] || printf "%s\n" "esp ${_plan_whole__esp}"
    printf "%s\n" "root ${_plan_whole__root}"
    [ -z "${_plan_whole__home}" ] || printf "%s\n" "home ${_plan_whole__home}"
}

_plan_partitions() { #root [esp] [keep] => a plan for partitions that exist
    _plan_partitions__root="${1}"; shift
    _plan_partitions__esp=""; _plan_partitions__keep=""
    for _plan_partitions__word; do
        case "${_plan_partitions__word}" in
            keep) _plan_partitions__keep="yes" ;;
            *) _plan_partitions__esp="${_plan_partitions__word}" ;;
        esac
    done
    if [ -z "${_plan_partitions__keep}" ] || [ "$(_file_system "${_plan_partitions__root}")" != "${kept_fs}" ]; then
        printf "%s\n" "format ${_plan_partitions__root} $(_fs_default)"
    fi
    if [ -n "${_plan_partitions__esp}" ]; then
        [ "$(_file_system "${_plan_partitions__esp}")" = "vfat" ] || printf "%s\n" "format ${_plan_partitions__esp} fat32"
        printf "%s\n" "esp ${_plan_partitions__esp}"
    fi
    printf "%s\n" "root ${_plan_partitions__root}"
}

_table_of() { #disk => the partition table plan gives it, gpt or dos; nothing when it keeps its own
    _plan table "${1}" | cut -d' ' -f2
}

_made_on() { #disk => the partitions plan makes on it, "name size type [start]" a line, in order
    _plan partition | while read -r _made_on__name _made_on__rest; do
        [ "$(_disk_of "${_made_on__name}")" != "${1}" ] || printf "%s\n" "${_made_on__name} ${_made_on__rest}"
    done
}

_mib_in_plan() { #partition => its size in MiB: the one plan gives it, or the one it has. The rest of a
    #disk is what its other partitions leave, less the 2M the table and its alignment take
    _mib_in_plan__size="$(_plan partition "${1}" | cut -d' ' -f2)"
    case "${_mib_in_plan__size}" in
        "") _mib "${1}" ;;
        rest) _mib_in_plan__disk="$(_disk_of "${1}")"
              printf "%s" "$(($(_mib "${_mib_in_plan__disk}") - 2 - $(_made_on "${_mib_in_plan__disk}" |
                  awk '$2 != "rest" {sum += $2} END {print sum + 0}')))" ;;
        *) printf "%s" "${_mib_in_plan__size}" ;;
    esac
}

_kind_in_plan() { #partition => what it is to the firmware once plan is applied: esp, bios-boot, frame or data
    case "$(_plan partition "${1}" | cut -d' ' -f3)" in
        esp) printf "%s" esp ;;
        bios-boot) printf "%s" bios-boot ;;
        linux) printf "%s" data ;;
        *) _kind_now "${1}" ;;
    esac
}

_holds_in_plan() { #partition => the file system on it once plan is applied: fat32, ext4, btrfs, another,
    #or none
    _holds_in_plan__as="$(_plan format "${1}" | cut -d' ' -f2)"
    case "${_holds_in_plan__as}" in
        ?*) printf "%s" "${_holds_in_plan__as}" ;;
        *) if [ -n "$(_plan partition "${1}")" ]; then
               printf "%s" none
           else
               case "$(_file_system "${1}")" in
                   vfat) printf "%s" fat32 ;;
                   "") printf "%s" none ;;
                   *) _file_system "${1}" ;;
               esac
           fi ;;
    esac
}

_in_plan() { #partition => true when it is there once plan is applied: plan makes it, or it exists on a
    #disk that keeps its table
    [ -n "$(_plan partition "${1}")" ] ||
        { _is_partition "${1}" && [ -z "$(_table_of "$(_disk_of "${1}")")" ]; }
}

_role() { #partition => what plan makes of it: root, home, esp, or nothing
    for _role__action in root home esp; do
        [ "$(_plan_one "${_role__action}")" != "${1}" ] || { printf "%s" "${_role__action}"; return 0; }
    done
}

_name_in_plan() { #partition => what people call it once plan is applied
    case "$(_role "${1}")" in
        root) printf "%s" "minos" ;;
        home) printf "%s" "home" ;;
        esp) printf "%s" "boot" ;;
        *) if [ -n "$(_plan partition "${1}")" ]; then
               case "$(_kind_in_plan "${1}")" in bios-boot) printf "%s" "grub" ;; esp) printf "%s" "boot" ;; *) printf "%s" "blank" ;; esac
           else
               _name_now "${1}"
           fi ;;
    esac
}

_plan_disks() { #=> the disks plan touches, a line each
    {   _plan table | cut -d' ' -f1
        for _plan_disks__part in $( { _plan partition; _plan format; _plan esp; _plan root; _plan home; } | cut -d' ' -f1); do
            _disk_of "${_plan_disks__part}"; printf "\n"
        done
    } | sort -u
}

_check_holds() { #partition what => what stops PARTITION from holding WHAT (minos, /home): formatted, one of
    #the file systems; kept with its files, the one kept so
    _check_holds__fs="$(_holds_in_plan "${1}")"
    if [ -n "$(_plan format "${1}")" ]; then
        [ -n "$(_fs_field "${_check_holds__fs}" 1)" ] ||
            printf "%s\n" "${1#/dev/} is formatted as ${_check_holds__fs}: ${2} goes on $(_fs_words)."
    else
        [ "${_check_holds__fs}" = "${kept_fs}" ] ||
            printf "%s\n" "${1#/dev/} has to be formatted: ${2} keeps the files of an ${kept_fs} alone."
    fi
}

_check() { #=> the check verb: what stops plan, a line each
    awk -v kinds=" fat32 $(printf "%s\n" "${filesystems}" | cut -f1 | tr '\n' ' ')" '/^[ \t]*(#|$)/ {next}
        $1 == "table" && NF == 3 && $3 ~ /^(gpt|dos)$/ {next}
        $1 == "partition" && (NF == 4 || NF == 5 && $5 ~ /^[0-9]+$/) && $3 ~ /^([1-9][0-9]*|rest)$/ && $4 ~ /^(esp|linux|bios-boot)$/ {next}
        $1 == "format" && NF == 3 && index(kinds, " " $3 " ") {next}
        ($1 == "esp" || $1 == "root" || $1 == "home") && NF == 2 {next}
        $1 == "keyboard" && (NF == 2 || NF == 3) && $2 ~ /^[a-z0-9_]+$/ && $3 ~ /^[a-zA-Z0-9_-]*$/ {next}
        $1 == "timezone" && NF == 2 {next}
        {print "line " NR " is no action of a plan: " $0}' "${plan}"
    for _check__zone in $(_plan timezone); do
        _is_timezone "${_check__zone}" || printf "%s\n" "${_check__zone} is no time zone this system has."
    done
    _plan format | while read -r _check__part _check__as; do
        [ "${_check__as}" = "fat32" ] || [ -z "$(_fs_field "${_check__as}" 1)" ] || _is_offered "${_check__as}" ||
            printf "%s\n" "${_check__part#/dev/} cannot be made ${_check__as} here: there is no $(_fs_field "${_check__as}" 3 | cut -d' ' -f1) (package $(_fs_field "${_check__as}" 2))."
    done

    #the disks: each one touched must be free, and a new table holds what is made on it
    for _check__disk in $(_plan_disks); do
        if ! _is_disk "${_check__disk}"; then
            printf "%s\n" "${_check__disk} is not a disk of this computer."
            continue
        fi
        _check__refusal="$(_disk_refusal "${_check__disk}")"
        [ -z "${_check__refusal}" ] || printf "%s\n" "minos cannot go to ${_check__disk#/dev/}: ${_check__refusal}."
    done
    for _check__disk in $(_plan table | cut -d' ' -f1); do
        _is_disk "${_check__disk}" || continue
        _made_on "${_check__disk}" | awk -v disk="${_check__disk#/dev/}" -v total="$(_mib "${_check__disk}")" \
            -v table="$(_table_of "${_check__disk}")" -v first="$(_partition_name "${_check__disk}" 1)" '
            {   n++; name = first; sub(/1$/, n, name)
                if ($1 != name) printf "%s: partition %d of %s is %s.\n", $1, n, disk, name
                if (rest) printf "%s comes after the partition that takes the rest of %s.\n", $1, disk
                if ($2 == "rest") rest = 1; else sum += $2
                if (NF > 3) printf "%s: on a new table a partition comes after the one before it, and this one says where it starts.\n", $1
                if ($3 == "bios-boot" && table != "gpt") printf "%s: a BIOS boot partition goes on a gpt table.\n", $1
                if (table == "dos" && n > 4) printf "%s: an MBR table holds four partitions.\n", $1
            }
            END {if (sum + 2 > total) printf "%s is too small for the partitions planned: %dM of %dM.\n", disk, sum + 2, total}'
    done
    #a partition made on a disk that keeps its table: in free room, under a number that is free
    for _check__disk in $(_plan partition | cut -d' ' -f1 | while read -r _check__part; do _disk_of "${_check__part}"; printf "\n"; done | sort -u); do
        [ -z "$(_table_of "${_check__disk}")" ] || continue
        _is_disk "${_check__disk}" || continue
        _check__table="$(_table_now "${_check__disk}")"
        if [ -z "${_check__table}" ]; then
            printf "%s\n" "${_check__disk#/dev/} has no partition table to add a partition to: it takes the whole disk."
            continue
        fi
        _check__free="$(_free "${_check__disk}")"
        _made_on "${_check__disk}" | while read -r _check__part _check__size _check__type _check__start; do
            _check__name="${_check__part#/dev/}"
            if [ -z "${_check__start}" ] || [ "${_check__size}" = "rest" ]; then
                printf "%s\n" "${_check__name}: a partition added to a table that stays says its size and where it starts."
                continue
            fi
            ! _is_partition "${_check__part}" || printf "%s\n" "${_check__name} is a partition of ${_check__disk#/dev/} already."
            [ "${_check__table}" != "dos" ] || [ "$(_partition_number "${_check__part}")" -le 4 ] ||
                printf "%s\n" "${_check__disk#/dev/} has an MBR table with its four partitions taken: no other can be made on it."
            [ "${_check__type}" != "bios-boot" ] || [ "${_check__table}" = "gpt" ] ||
                printf "%s\n" "${_check__name}: a BIOS boot partition goes on a gpt table."
            printf "%s\n" "${_check__free}" | awk -v start="${_check__start}" -v size="${_check__size}" '
                NF == 2 && start >= $1 && start + size <= $1 + $2 {found = 1} END {exit !found}' ||
                printf "%s\n" "${_check__name}: ${_check__disk#/dev/} has no free room of $(_human "${_check__size}") there."
        done
        _made_on "${_check__disk}" | awk 'NF == 4 && $2 != "rest" {print $4, $4 + $2, $1}' | sort -n | awk '
            $1 < end {printf "%s takes room another partition of the plan takes.\n", substr($3, 6)} {end = $2}'
    done
    for _check__part in $( { _plan format; _plan esp; _plan root; _plan home; } | cut -d' ' -f1 | sort -u); do
        _in_plan "${_check__part}" || printf "%s\n" "${_check__part#/dev/} is not a partition: none is there, and the plan makes none."
    done

    #the partition for minos
    _check__root="$(_plan root | cut -d' ' -f1)"
    case "$(printf "%s\n" "${_check__root}" | grep -c .)" in
        0) printf "%s\n" "No partition for minos is chosen."; _check__root="" ;;
        1) ;;
        *) printf "%s\n" "minos goes to one partition, and the plan names several."; _check__root="" ;;
    esac
    if [ -n "${_check__root}" ] && _in_plan "${_check__root}"; then
        [ "$(_kind_in_plan "${_check__root}")" = "data" ] ||
            printf "%s\n" "${_check__root#/dev/} is the firmware's own partition, not one for minos."
        _check_holds "${_check__root}" minos
        [ "$(_mib_in_plan "${_check__root}")" -ge "${root_mib}" ] ||
            printf "%s\n" "${_check__root#/dev/} is too small: it has $(_human "$(_mib_in_plan "${_check__root}")"), and minos needs $(_human "${root_mib}")."
    fi

    #the partition for /home
    _check__home="$(_plan home | cut -d' ' -f1)"
    case "$(printf "%s\n" "${_check__home}" | grep -c .)" in
        0|1) ;;
        *) printf "%s\n" "/home is one partition, and the plan names several."; _check__home="" ;;
    esac
    if [ -n "${_check__home}" ] && _in_plan "${_check__home}"; then
        [ "${_check__home}" != "${_check__root}" ] ||
            printf "%s\n" "${_check__home#/dev/} is the partition of minos: /home is in it without being named."
        [ "$(_kind_in_plan "${_check__home}")" = "data" ] ||
            printf "%s\n" "${_check__home#/dev/} is the firmware's own partition, not one for /home."
        _check_holds "${_check__home}" /home
        [ "$(_mib_in_plan "${_check__home}")" -ge "${home_mib}" ] ||
            printf "%s\n" "${_check__home#/dev/} is too small for /home: it has $(_human "$(_mib_in_plan "${_check__home}")")."
    fi

    #what the firmware starts from
    _check__esp="$(_plan esp | cut -d' ' -f1)"
    if [ "${firmware}" = "uefi" ]; then
        case "$(printf "%s\n" "${_check__esp}" | grep -c .)" in
            0) printf "%s\n" "This computer starts by UEFI, from an EFI system partition, and the plan has none: $(_human "${esp_mib}") of free room make one."
               _check__esp="" ;;
            1) ;;
            *) printf "%s\n" "The boot loader goes to one EFI system partition, and the plan names several."; _check__esp="" ;;
        esac
        if [ -n "${_check__esp}" ] && _in_plan "${_check__esp}"; then
            [ "$(_kind_in_plan "${_check__esp}")" = "esp" ] ||
                printf "%s\n" "${_check__esp#/dev/} is not an EFI system partition: its type has to be \"EFI System\"."
            [ "$(_holds_in_plan "${_check__esp}")" = "fat32" ] ||
                printf "%s\n" "${_check__esp#/dev/} has to be formatted: an EFI system partition is FAT."
        fi
    else
        [ -z "${_check__esp}" ] ||
            printf "%s\n" "An EFI system partition is for UEFI, and this computer started by BIOS."
        if [ -n "${_check__root}" ] && _in_plan "${_check__root}"; then
            _check__disk="$(_disk_of "${_check__root}")"
            _check__table="$(_table_of "${_check__disk}")"
            _check__boot="$(_made_on "${_check__disk}" | awk '$3 == "bios-boot"')"
            if [ -z "${_check__table}" ]; then
                _check__table="$(_table_now "${_check__disk}")"
                _check__boot="${_check__boot}$(awk -F '\t' -v disk="${_check__disk}" '$2 == disk && $7 == "bios-boot" {print $1}' "${map}")"
            fi
            if [ "${_check__table}" = "gpt" ] && [ -z "${_check__boot}" ]; then
                printf "%s\n" "${_check__disk#/dev/} has a gpt table, and BIOS starts from one only through a partition of GRUB's own: 1M of free room make it."
            fi
        fi
    fi
}

################################################################################
# The plan for an interface: rows
################################################################################

_layout() { #disk now|after => what DISK holds now, or once plan is applied: its partitions and free
    #rooms in the order of the disk, "device mib start" a line (device free for a room; whole for a disk
    #that is one file system, with no table)
    _layout__total="$(_mib "${1}")"
    if [ "${2}" = "after" ] && [ -n "$(_table_of "${1}")" ]; then
        #a new table: one partition after the other, from the first MiB
        _made_on "${1}" | while read -r _layout__part _; do
            printf "%s %s\n" "${_layout__part}" "$(_mib_in_plan "${_layout__part}")"
        done | awk -v total="${_layout__total}" '
            BEGIN {at = 1} {print $1, $2, at; at += $2} END {if (total - 1 - at >= 2) print "free", total - 1 - at, at}'
        return 0
    fi
    if [ -n "$(_disk_fs "${1}")" ]; then
        printf "%s %s %s\n" "whole" "${_layout__total}" 0
        return 0
    fi
    _layout__dos="$([ "$(_table_now "${1}")" != "dos" ] || printf 1)"
    {   awk -F '\t' -v disk="${1}" '$2 == disk {print $4, $6, $1, $5, $3}' "${map}"
        [ "${2}" = "now" ] || _made_on "${1}" | awk 'NF == 4 {print $4, $4 + $2, $1, $2, 0}'
    } | sort -n | awk -v total="${_layout__total}" -v dos="${_layout__dos}" '
        #free room is what the primary partitions and the ones made leave: an extended partition is
        #told by its logical ones, and the room inside it is not offered. The first MiB is the
        #table\047s, and so is the last (a GPT\047s second copy)
        BEGIN {at = 1}
        {   if (!(dos && $5 > 4)) {
                if ($1 - at >= 2) print "free", $1 - at, at
                if ($2 > at) at = $2
            }
            print $3, $4, $1
        }
        END {if (total - 1 - at >= 2) print "free", total - 1 - at, at}'
}

_rows() { #disk now|after => the now or after rows of DISK
    _rows__gets="$(_table_of "${1}")"
    _layout "${1}" "${2}" | while read -r _rows__part _rows__mib _; do
        if [ "${_rows__part}" = "free" ]; then
            _rows__name="free"; [ -n "$(_partitions "${1}")" ] || [ "${2}" = "after" ] || _rows__name="empty"
            _row "${2}" free "${_rows__mib}" "$(_human "${_rows__mib}")" free - "${_rows__name}" kept -
            continue
        fi
        if [ "${_rows__part}" = "whole" ]; then
            #a disk that is one file system: it goes with a new table, the only way minos takes such a disk
            _row "${2}" "${1}" "${_rows__mib}" "$(_human "${_rows__mib}")" data "$(_disk_fs "${1}")" "$(_disk_fs "${1}")" \
                "$([ -n "${_rows__gets}" ] && printf gone || printf kept)" -
            continue
        fi
        if [ "${2}" = "now" ]; then
            if [ -n "${_rows__gets}" ]; then _rows__fate="gone"
            elif [ -n "$(_plan format "${_rows__part}")" ]; then _rows__fate="erased"
            else _rows__fate="kept"; fi
            _row now "${_rows__part}" "${_rows__mib}" "$(_human "${_rows__mib}")" "$(_kind_now "${_rows__part}")" \
                "$(_file_system "${_rows__part}")" "$(_name_now "${_rows__part}")" "${_rows__fate}" -
        else
            if [ -n "$(_plan partition "${_rows__part}")" ]; then _rows__fate="new"
            elif [ -n "$(_plan format "${_rows__part}")" ]; then _rows__fate="formatted"
            else _rows__fate="kept"; fi
            case "$(_role "${_rows__part}")" in
                root) _rows__mount="/" ;; home) _rows__mount="/home" ;; esp) _rows__mount="/boot/efi" ;; *) _rows__mount="-" ;;
            esac
            _rows__holds="$(_holds_in_plan "${_rows__part}")"; [ "${_rows__holds}" != "none" ] || _rows__holds="-"
            _row after "${_rows__part}" "${_rows__mib}" "$(_human "${_rows__mib}")" "$(_kind_in_plan "${_rows__part}")" \
                "${_rows__holds}" "$(_name_in_plan "${_rows__part}")" "${_rows__fate}" "${_rows__mount}"
        fi
    done
}

_part_words() { #partition => it for people, as it is now: sdb3 (130.0G, ntfs "Data")
    printf "%s (%s, %s)" "${1#/dev/}" "$(_human "$(_mib "${1}")")" "$(_holds "${1}")"
}

_actions() { #=> the action rows of plan, the loss row and the button row: what is done in words, what is
    #lost, and the name of the deed. They read the plan through what check and the layout read it
    #through, so the words and the picture say one thing
    _actions__root="$(_plan_one root)"; _actions__home="$(_plan_one home)"; _actions__esp="$(_plan_one esp)"
    _actions__lost=""; _actions__whole=""
    for _actions__disk in $(_plan table | cut -d' ' -f1); do
        _actions__count="$(_partitions "${_actions__disk}" | grep -c .)"
        if [ -n "$(_disk_fs "${_actions__disk}")" ]; then
            _row action erase "Delete everything on $(_describe_disk "${_actions__disk}"): $(_holds_summary "${_actions__disk}")"
            _actions__lost="${_actions__lost}${_actions__lost:+, }the whole of ${_actions__disk#/dev/} ($(_holds_summary "${_actions__disk}"))"
        elif [ "${_actions__count}" = 0 ]; then
            _row action make "Make a new partition table on $(_describe_disk "${_actions__disk}"), which is empty"
        else
            _row action erase "Delete everything on $(_describe_disk "${_actions__disk}"): its ${_actions__count} partition(s), $(_holds_summary "${_actions__disk}")"
            _actions__lost="${_actions__lost}${_actions__lost:+, }the whole of ${_actions__disk#/dev/} ($(_holds_summary "${_actions__disk}"))"
        fi
        _actions__whole="${_actions__disk}"
    done
    _actions__made=""
    for _actions__part in $(_plan partition | cut -d' ' -f1); do
        _actions__size="$(_human "$(_mib_in_plan "${_actions__part}")")"
        case "$(_kind_in_plan "${_actions__part}")" in
            esp) _actions__what="a boot partition (${_actions__part#/dev/}, ${_actions__size}, EFI)" ;;
            bios-boot) _actions__what="a partition for GRUB (${_actions__part#/dev/}, ${_actions__size})" ;;
            *) case "${_actions__part}" in
                   "${_actions__root}") _actions__what="a partition for minos (${_actions__part#/dev/}, ${_actions__size}, $(_holds_in_plan "${_actions__part}"))" ;;
                   "${_actions__home}") _actions__what="a partition for /home (${_actions__part#/dev/}, ${_actions__size}, $(_holds_in_plan "${_actions__part}"))" ;;
                   *) _actions__what="a partition (${_actions__part#/dev/}, ${_actions__size})" ;;
               esac ;;
        esac
        _actions__made="${_actions__made}${_actions__made:+|}${_actions__what}"
    done
    #two to a line: a row is no longer than a screen is wide
    [ -z "${_actions__made}" ] || printf "%s\n" "${_actions__made}" | tr '|' '\n' | awk -v where="$(
        [ -n "${_actions__whole}" ] || printf "%s" " in the free room")" '
        NR % 2 == 1 {held = $0; next} {printf "action\tmake\tCreate %s and %s%s\n", held, $0, where; held = ""}
        END {if (held != "") printf "action\tmake\tCreate %s%s\n", held, where}'
    for _actions__part in $( { _plan format; _plan esp; _plan root; _plan home; } | cut -d' ' -f1 | awk '!seen[$0]++'); do
        [ -z "$(_plan partition "${_actions__part}")" ] || continue
        _is_partition "${_actions__part}" || continue
        case "$(_role "${_actions__part}")" in
            root) _actions__for="minos" ;; home) _actions__for="/home" ;; esp) _actions__for="the boot loader" ;; *) _actions__for="nothing" ;;
        esac
        if [ -n "$(_plan format "${_actions__part}")" ]; then
            _row action erase "Delete everything on $(_part_words "${_actions__part}"): formatted as $(_holds_in_plan "${_actions__part}") for ${_actions__for}"
            _actions__lost="${_actions__lost}${_actions__lost:+, }$(_part_words "${_actions__part}")"
        else
            case "$(_role "${_actions__part}")" in
                root) _row action keep "Keep the files of $(_part_words "${_actions__part}"): minos is copied over them" ;;
                home) _row action keep "Keep $(_part_words "${_actions__part}") as /home: its files stay" ;;
                esp) _row action keep "Add minos to the boot partition ${_actions__part#/dev/}, kept as it is: not formatted" ;;
            esac
        fi
    done
    if [ -n "${_actions__root}" ]; then
        if [ "${firmware}" = "uefi" ]; then
            _row action copy "Copy minos to ${_actions__root#/dev/} and set it to start by UEFI${_actions__esp:+, from ${_actions__esp#/dev/}}"
        else
            _row action copy "Copy minos to ${_actions__root#/dev/} and set $(_disk_of "${_actions__root}" | sed 's|/dev/||') to start by BIOS"
        fi
    fi
    if [ -z "${_actions__lost}" ]; then
        if [ -n "${_actions__whole}" ]; then
            _row loss none "Nothing is deleted: the disk is empty."
            _row button plain "Install on $(_describe_disk "${_actions__whole}" 20)"
        else
            _row loss none "Nothing is deleted: what the disk holds stays as it is."
            if _is_partition "${_actions__root:-none}"; then
                _row button plain "Install on $(_part_words "${_actions__root}" | cut -c1-44)"
            else
                _row button plain "Install on the new partition ${_actions__root#/dev/}"
            fi
        fi
    elif [ -n "${_actions__whole}" ]; then
        _row loss some "Deleted for good: ${_actions__lost}."
        _row button danger "Erase $(_describe_disk "${_actions__whole}" 18) and install"
    else
        _row loss some "Deleted for good: ${_actions__lost}. The rest of the disk is not touched."
        _row button danger "Erase $(for _actions__part in $(_plan format | cut -d' ' -f1); do
            _is_partition "${_actions__part}" && printf "%s, " "${_actions__part#/dev/}"; done | sed 's/, $//' | cut -c1-34) and install"
    fi
}

_review() { #disk => the review verb's rows for DISK
    _check | while IFS= read -r _review__line; do _row problem "${_review__line}"; done
    _is_disk "${1}" || return 0
    _rows "${1}" now
    _rows "${1}" after
    _actions
}

_describe() { #=> the describe verb: plan for people, what is done in order, and what is lost
    _actions | awk -F '\t' '$1 == "action" {printf "%d. %s\n", ++n, $3} $1 == "loss" {loss = $3} END {if (loss != "") print loss}'
}

################################################################################
# The plan the choices make, and what else can be chosen
################################################################################

_choice() { #key => the value of that choice among choices; nothing when it is not said
    for _choice__word in ${choices}; do
        case "${_choice__word}" in "${1}="*) printf "%s" "${_choice__word#*=}"; return 0 ;; esac
    done
}

_room() { #free:START[:MIB] => "start mib" of the free room that starts there, MiB as chosen or all of
    #it; nothing when the disk has no such room
    _room__start="$(printf "%s" "${1}" | cut -d: -f2)"; _room__mib="$(printf "%s" "${1}" | cut -s -d: -f3)"
    printf "%s\n" "${free}" | awk -v start="${_room__start}" -v mib="${_room__mib}" '
        NF == 2 && $1 == start {print $1, (mib != "" && mib + 0 <= $2 ? mib : $2); exit}'
}

_next_number() { #disk taken... => the lowest partition number of DISK that is free, the ones TAKEN aside
    _next_number__disk="${1}"; shift
    _next_number__n=1
    while awk -F '\t' -v disk="${_next_number__disk}" -v n="${_next_number__n}" '$2 == disk && $3 == n {found = 1} END {exit !found}' "${map}" ||
        case " ${*} " in *" ${_next_number__n} "*) true ;; *) false ;; esac; do
        _next_number__n="$((_next_number__n + 1))"
    done
    printf "%s" "${_next_number__n}"
}

_choices_default() { #disk => the choices the engine suggests for DISK: the whole of an empty disk; of one
    #that holds something, free room when it has enough, and else nothing: what is deleted is chosen
    if [ -z "$(_partitions "${1}")" ]; then
        printf "%s" "use=whole"
        return 0
    fi
    _choices_default__need="${root_mib}"
    if [ "${firmware}" = "uefi" ]; then
        awk -F '\t' -v disk="${1}" '$2 == disk && $7 == "esp" {found = 1} END {exit !found}' "${map}" ||
            _choices_default__need="$((root_mib + esp_mib))"
    fi
    _choices_default__room="$(printf "%s\n" "${free}" | awk -v need="${_choices_default__need}" '
        NF == 2 && $2 >= need && $2 > best {best = $2; start = $1} END {if (best) print start}')"
    if [ -n "${_choices_default__room}" ]; then
        printf "%s" "use=parts root=free:${_choices_default__room}"
    else
        printf "%s" "use=parts root=none"
    fi
}

_plan_custom() { #disk => on stdout the plan choices make for DISK; choices is left as the engine took it
    _plan_custom__disk="${1}"
    _plan_custom__use="$(_choice use)"
    #a disk with no partition table can only be taken whole
    [ -n "$(_table_now "${1}")" ] || _plan_custom__use="whole"
    #the file systems chosen, kept from one plan to the next: the default for one this system cannot make
    _plan_custom__roottype="$(_choice roottype)"; _plan_custom__hometype="$(_choice hometype)"
    _is_offered "${_plan_custom__roottype:-none}" || _plan_custom__roottype="$(_fs_default)"
    _is_offered "${_plan_custom__hometype:-none}" || _plan_custom__hometype="$(_fs_default)"
    _plan_custom__types="roottype=${_plan_custom__roottype} hometype=${_plan_custom__hometype}"
    if [ "${_plan_custom__use}" != "parts" ]; then
        _plan_custom__root="$(_choice root)"; _plan_custom__home="$(_choice home)"
        _plan_custom__size="-"; _plan_custom__hsize="-"
        case "${_plan_custom__root}" in new:[1-9]*) _plan_custom__size="${_plan_custom__root#new:}" ;; *) _plan_custom__root="new" ;; esac
        case "${_plan_custom__home}" in new:[1-9]*) _plan_custom__hsize="${_plan_custom__home#new:}" ;; *) _plan_custom__home="none" ;; esac
        choices="use=whole root=${_plan_custom__root} home=${_plan_custom__home} ${_plan_custom__types}"
        _plan_whole "${1}" "${_plan_custom__size}" "${_plan_custom__hsize}" "${_plan_custom__roottype}" "${_plan_custom__hometype}"
        return 0
    fi

    _plan_custom__root="$(_choice root)"; _plan_custom__rootfs="$(_choice rootfs)"
    _plan_custom__home="$(_choice home)"; _plan_custom__homefs="$(_choice homefs)"
    _plan_custom__esp="$(_choice esp)"; _plan_custom__espfs="$(_choice espfs)"
    _plan_custom__table="$(_table_now "${1}")"
    _plan_custom__taken=""; _plan_custom__made=""; _plan_custom__formats=""; _plan_custom__names=""
    #what was chosen and is no longer there is not chosen
    case "${_plan_custom__root}" in
        free:*) [ -n "$(_room "${_plan_custom__root}")" ] || _plan_custom__root="none" ;;
        /dev/*) [ "$(_of "${_plan_custom__root}" 2)" = "${1}" ] && [ "$(_kind_now "${_plan_custom__root}")" = "data" ] || _plan_custom__root="none" ;;
        *) _plan_custom__root="none" ;;
    esac
    case "${_plan_custom__home}" in
        free:*) [ -n "$(_room "${_plan_custom__home}")" ] || _plan_custom__home="none"
                #one new partition to a free room
                [ "$(printf "%s" "${_plan_custom__home}" | cut -d: -f2)" != "$(printf "%s" "${_plan_custom__root}" | cut -s -d: -f2)" ] || _plan_custom__home="none" ;;
        /dev/*) [ "$(_of "${_plan_custom__home}" 2)" = "${1}" ] && [ "$(_kind_now "${_plan_custom__home}")" = "data" ] &&
                    [ "${_plan_custom__home}" != "${_plan_custom__root}" ] || _plan_custom__home="none" ;;
        *) _plan_custom__home="none" ;;
    esac
    [ "${_plan_custom__rootfs}" = "keep" ] && [ "$(_file_system "${_plan_custom__root}")" = "${kept_fs}" ] || _plan_custom__rootfs="format"
    [ "${_plan_custom__homefs}" = "keep" ] && [ "$(_file_system "${_plan_custom__home}")" = "${kept_fs}" ] || _plan_custom__homefs="format"

    #what the firmware starts from, which is the installer's to see to. UEFI: the EFI system partition
    #chosen; or this disk's; or a new one, where this disk has the room; or another disk's. BIOS on a
    #GPT: the partition GRUB needs, the one there or a new one. A new one goes first in the room minos
    #takes, or in the largest free room that holds it
    _plan_custom__boot=""; _plan_custom__newesp=""; _plan_custom__newboot=""; _plan_custom__firm=0
    if [ "${firmware}" = "uefi" ]; then
        case "${_plan_custom__esp}" in
            /dev/*) [ "$(_kind_now "${_plan_custom__esp}")" = "esp" ] || _plan_custom__esp="auto" ;;
            *) _plan_custom__esp="auto" ;;
        esac
        [ "${_plan_custom__espfs}" = "format" ] || _plan_custom__espfs="auto"
        if [ "${_plan_custom__esp}" != "auto" ]; then
            _plan_custom__boot="${_plan_custom__esp}"
        else
            _plan_custom__boot="$(awk -F '\t' -v disk="${1}" '$2 == disk && $7 == "esp" {print $1; exit}' "${map}")"
            [ -n "${_plan_custom__boot}" ] || { _plan_custom__newesp="yes"; _plan_custom__firm="${esp_mib}"; }
        fi
    else
        _plan_custom__esp="auto"; _plan_custom__espfs="auto"
        [ "${_plan_custom__table}" != "gpt" ] ||
            awk -F '\t' -v disk="${1}" '$2 == disk && $7 == "bios-boot" {found = 1} END {exit !found}' "${map}" ||
            { _plan_custom__newboot="yes"; _plan_custom__firm=1; }
    fi
    #nothing is made for the firmware before minos has a place: a plan that only adds a boot partition
    #is no plan
    if [ "${_plan_custom__root}" = "none" ]; then
        _plan_custom__newesp=""; _plan_custom__newboot=""; _plan_custom__firm=0
    fi
    _plan_custom__at=""
    case "${_plan_custom__root}" in
        free:*) # shellcheck disable=SC2046 # the start and the size, two words
                set -- $(_room "${_plan_custom__root}")
                _plan_custom__at="${1}"; _plan_custom__end="$((${1} + ${2}))" ;;
        *) if [ "${_plan_custom__firm}" -gt 0 ]; then
               # shellcheck disable=SC2046 # the start and the size, two words
               set -- $(printf "%s\n" "${free}" | awk -v need="${_plan_custom__firm}" -v home="$(printf "%s" "${_plan_custom__home}" | cut -s -d: -f2)" '
                   NF == 2 && $2 >= need && $1 != home && $2 > best {best = $2; start = $1} END {if (best) print start, best}')
               if [ "${#}" = 2 ]; then _plan_custom__at="${1}"; _plan_custom__end="$((${1} + ${2}))"; fi
           fi ;;
    esac
    if [ -n "${_plan_custom__newesp}" ] && [ -z "${_plan_custom__at}" ] && [ "${_plan_custom__root}" != "none" ]; then
        #no room on this disk for an EFI system partition: another disk's, when there is one
        _plan_custom__newesp=""
        _plan_custom__boot="$(for _plan_custom__other in $(_usable_disks); do
            awk -F '\t' -v disk="${_plan_custom__other}" '$2 == disk && $7 == "esp" {print $1; exit}' "${map}"; done | head -n 1)"
    fi
    _plan_custom__rootpart="${_plan_custom__root}"; _plan_custom__homepart="${_plan_custom__home}"
    if [ -n "${_plan_custom__at}" ]; then
        if [ -n "${_plan_custom__newboot}" ]; then
            # shellcheck disable=SC2086 # the numbers taken, a word each
            _plan_custom__n="$(_next_number "${_plan_custom__disk}" ${_plan_custom__taken})"; _plan_custom__taken="${_plan_custom__taken} ${_plan_custom__n}"
            printf "%s\n" "partition $(_partition_name "${_plan_custom__disk}" "${_plan_custom__n}") 1 bios-boot ${_plan_custom__at}"
            _plan_custom__at="$((_plan_custom__at + 1))"
        fi
        if [ -n "${_plan_custom__newesp}" ]; then
            # shellcheck disable=SC2086 # the numbers taken, a word each
            _plan_custom__n="$(_next_number "${_plan_custom__disk}" ${_plan_custom__taken})"; _plan_custom__taken="${_plan_custom__taken} ${_plan_custom__n}"
            _plan_custom__boot="$(_partition_name "${_plan_custom__disk}" "${_plan_custom__n}")"
            printf "%s\n" "partition ${_plan_custom__boot} ${esp_mib} esp ${_plan_custom__at}"
            _plan_custom__formats="format ${_plan_custom__boot} fat32"
            _plan_custom__at="$((_plan_custom__at + esp_mib))"
        fi
        case "${_plan_custom__root}" in free:*)
            # shellcheck disable=SC2086 # the numbers taken, a word each
            _plan_custom__n="$(_next_number "${_plan_custom__disk}" ${_plan_custom__taken})"; _plan_custom__taken="${_plan_custom__taken} ${_plan_custom__n}"
            _plan_custom__rootpart="$(_partition_name "${_plan_custom__disk}" "${_plan_custom__n}")"
            _plan_custom__size="$(printf "%s" "${_plan_custom__root}" | cut -s -d: -f3)"
            { [ -n "${_plan_custom__size}" ] && [ "$((_plan_custom__at + _plan_custom__size))" -le "${_plan_custom__end}" ]; } ||
                _plan_custom__size="$((_plan_custom__end - _plan_custom__at))"
            printf "%s\n" "partition ${_plan_custom__rootpart} ${_plan_custom__size} linux ${_plan_custom__at}" ;;
        esac
    fi
    case "${_plan_custom__home}" in free:*)
        # shellcheck disable=SC2046 # the start and the size, two words
        set -- $(_room "${_plan_custom__home}")
        # shellcheck disable=SC2086 # the numbers taken, a word each
        _plan_custom__n="$(_next_number "${_plan_custom__disk}" ${_plan_custom__taken})"
        _plan_custom__homepart="$(_partition_name "${_plan_custom__disk}" "${_plan_custom__n}")"
        printf "%s\n" "partition ${_plan_custom__homepart} ${2} linux ${1}" ;;
    esac
    [ -z "${_plan_custom__formats}" ] || printf "%s\n" "${_plan_custom__formats}"
    if [ -n "${_plan_custom__boot}" ] && [ -z "${_plan_custom__formats}" ]; then
        { [ "${_plan_custom__espfs}" != "format" ] && [ "$(_file_system "${_plan_custom__boot}")" = "vfat" ]; } ||
            printf "%s\n" "format ${_plan_custom__boot} fat32"
    fi
    case "${_plan_custom__root}" in
        none) ;;
        free:*) printf "%s\n" "format ${_plan_custom__rootpart} ${_plan_custom__roottype}" ;;
        *) [ "${_plan_custom__rootfs}" = "keep" ] || printf "%s\n" "format ${_plan_custom__rootpart} ${_plan_custom__roottype}" ;;
    esac
    case "${_plan_custom__home}" in
        none) ;;
        free:*) printf "%s\n" "format ${_plan_custom__homepart} ${_plan_custom__hometype}" ;;
        *) [ "${_plan_custom__homefs}" = "keep" ] || printf "%s\n" "format ${_plan_custom__homepart} ${_plan_custom__hometype}" ;;
    esac
    [ -z "${_plan_custom__boot}" ] || printf "%s\n" "esp ${_plan_custom__boot}"
    [ "${_plan_custom__root}" = "none" ] || printf "%s\n" "root ${_plan_custom__rootpart}"
    [ "${_plan_custom__home}" = "none" ] || printf "%s\n" "home ${_plan_custom__homepart}"
    choices="use=parts root=${_plan_custom__root} rootfs=${_plan_custom__rootfs} home=${_plan_custom__home} homefs=${_plan_custom__homefs} esp=${_plan_custom__esp} espfs=${_plan_custom__espfs} ${_plan_custom__types}"
}

_step_mib() { #mib => what + and - change a size of MIB by: a quarter, a half or a whole GiB
    if [ "${1}" -lt 8192 ]; then printf "%s" 256; elif [ "${1}" -lt 65536 ]; then printf "%s" 512; else printf "%s" 1024; fi
}

_fs_says() { #name => the file system NAME for people, in the width of an option: its name, and what it
    #is good at
    printf "%-6s %s%s" "${1}" "$([ "${1}" != "$(_fs_default)" ] || printf "the default; ")" "$(_fs_field "${1}" 4)"
}

_fs_line() { #id partition what => the fs row and the line ID of the file system PARTITION gets for WHAT
    #(minos, /home), and its options: each file system offered; none when it is kept with its files,
    #which keeps its own
    if [ -n "$(_plan partition "${2}")" ]; then
        _row fs "${1}" "${3}: ${2#/dev/}, a new partition of $(_human "$(_mib_in_plan "${2}")")"
    else
        _row fs "${1}" "${3}: $(_part_words "${2}")"
    fi
    _fs_line__fs="$(_holds_in_plan "${2}")"
    if [ -z "$(_plan format "${2}")" ]; then
        _row line "${1}" "Filesystem" "${_fs_line__fs}, kept with its files" "its file system stays with them" off
        return 0
    fi
    _row line "${1}" "Filesystem" "${_fs_line__fs}$([ "${_fs_line__fs}" != "$(_fs_default)" ] || printf ", the default")" \
        "$(_fs_field "${_fs_line__fs}" 4)" new
    for _fs_line__name in $(_fs_offered); do
        _row option "${1}" "${1}=${_fs_line__name}" "$(_fs_says "${_fs_line__name}")" "$([ "${_fs_line__name}" != "${_fs_line__fs}" ] || printf current)"
    done
}

_lines() { #disk => the line, option and size rows: the plan as lines a person changes, from choices
    #and plan
    _lines__disk="${1}"; _lines__total="$(_mib "${1}")"
    _lines__root="$(_plan_one root)"; _lines__home="$(_plan_one home)"; _lines__esp="$(_plan_one esp)"
    _lines__use="$(_choice use)"
    _lines__count="$(_partitions "${1}" | grep -c .)"

    #the disk, when there is another to choose
    if [ "$(_usable_disks | grep -c .)" -gt 1 ]; then
        _row line disk "Disk" "$(_describe_disk "${1}")" "$(_holds_summary "${1}")" plain
        for _lines__other in $(_usable_disks); do
            _row option disk "disk=${_lines__other}" "$(_describe_disk "${_lines__other}"): $(_holds_summary "${_lines__other}")" \
                "$([ "${_lines__other}" != "${1}" ] || printf current)"
        done
    fi

    if [ "${_lines__use}" = "whole" ]; then
        if [ "${_lines__count}" = 0 ]; then
            _row line use "Use" "the whole disk" "it is empty: nothing is deleted" plain
        else
            _row line use "Use" "the whole disk" "everything on it is deleted" erase
        fi
    else
        _row line use "Use" "its partitions and free room" "what you do not choose stays as it is" plain
    fi
    _row option use "use=whole" "the whole disk: $([ "${_lines__count}" = 0 ] && printf "it is empty" || printf "everything on it is deleted")" \
        "$([ "${_lines__use}" != "whole" ] || printf current)"
    [ -z "$(_table_now "${1}")" ] ||
        _row option use "use=parts" "its partitions and free room: what you do not choose stays as it is" \
            "$([ "${_lines__use}" != "parts" ] || printf current)"

    if [ "${_lines__use}" = "whole" ]; then
        if [ "${firmware}" = "uefi" ]; then
            _row line boot "Boot" "a new partition, $(_human "${esp_mib}"), FAT32" "the EFI system partition: UEFI starts minos from it" new
        elif [ "$(_table_of "${1}")" = "gpt" ]; then
            _row line boot "Boot" "a new partition of 1M for GRUB" "BIOS starts a disk of this size through it" new
        else
            _row line boot "Boot" "GRUB at the start of ${1#/dev/}" "this computer starts by BIOS" plain
        fi
        _lines__fixed="$(_made_on "${1}" | awk '$3 != "linux" {sum += $2} END {print sum + 0}')"
        _lines__rootmib="$(_mib_in_plan "${_lines__root}")"
        _lines__homemib=0; [ -z "${_lines__home}" ] || _lines__homemib="$(_mib_in_plan "${_lines__home}")"
        _lines__room="$((_lines__total - 2 - _lines__fixed))"
        _lines__sized="$(_choice root)"
        _row line root "minos" "a new partition, $(_human "${_lines__rootmib}"), $(_holds_in_plan "${_lines__root}")" \
            "$([ "${_lines__sized}" = "new" ] && printf "all the room there is" || printf "a size of its own: + and - change it")" new
        _row option root "root=new" "all the room there is" "$([ "${_lines__sized}" != "new" ] || printf current)"
        _lines__step="$(_step_mib "${_lines__room}")"
        _lines__own="${_lines__rootmib}"
        [ "${_lines__sized}" != "new" ] || _lines__own="$(( (_lines__rootmib * 3 / 4) / _lines__step * _lines__step ))"
        [ "${_lines__own}" -ge "${root_mib}" ] || _lines__own="${root_mib}"
        _row option root "root=new:${_lines__own}" "a size of its own, and the rest of the disk stays free" \
            "$([ "${_lines__sized}" = "new" ] || printf current)"
        [ "${_lines__sized}" = "new" ] ||
            _row size root "root=new:" "${_lines__rootmib}" "${root_mib}" "$((_lines__room - _lines__homemib))" "${_lines__step}"
        _fs_line roottype "${_lines__root}" minos
        if [ -z "${_lines__home}" ]; then
            _row line home "Home" "inside the partition of minos" "your files share its room" plain
        else
            _row line home "Home" "a partition of its own, $(_human "${_lines__homemib}"), $(_holds_in_plan "${_lines__home}")" "+ and - change its size" new
            _lines__most="$((_lines__room - root_mib))"
            [ "${_lines__sized}" = "new" ] || _lines__most="$((_lines__room - _lines__rootmib))"
            _row size home "home=new:" "${_lines__homemib}" "${home_mib}" "${_lines__most}" "${_lines__step}"
            _fs_line hometype "${_lines__home}" /home
        fi
        _row option home "home=none" "inside the partition of minos" "$([ -n "${_lines__home}" ] || printf current)"
        _lines__own="${_lines__homemib}"
        [ "${_lines__own}" -gt 0 ] || _lines__own="$(( (_lines__room / 4) / _lines__step * _lines__step ))"
        if [ "$((_lines__room - _lines__own))" -ge "${root_mib}" ] && [ "${_lines__own}" -ge "${home_mib}" ]; then
            _row option home "home=new:${_lines__own}" "a partition of its own, for your files alone" "$([ -z "${_lines__home}" ] || printf current)"
        fi
        return 0
    fi

    #its partitions and free rooms, in the order of the disk: a line each
    _layout "${1}" now | while read -r _lines__part _lines__mib _lines__start; do
        if [ "${_lines__part}" = "free" ]; then
            _lines__id="free:${_lines__start}"
            if [ -z "$(_room "${_lines__id}")" ]; then
                _row line "${_lines__id}" "free" "$(printf "%7s  %-20s  %s" "$(_human "${_lines__mib}")" "free room" "stays free")" \
                    "it cannot be used: an MBR table holds four partitions, and this one's are taken" off
                continue
            fi
            _lines__made="$(_made_on "${1}" | awk -v from="${_lines__start}" -v to="$((_lines__start + _lines__mib))" 'NF == 4 && $4 >= from && $4 < to {print $1}')"
            _lines__is="left free"; _lines__tone="off"
            for _lines__new in ${_lines__made}; do
                case "$(_role "${_lines__new}")" in
                    root) _lines__is="new for minos, $(_human "$(_mib_in_plan "${_lines__new}")"), $(_holds_in_plan "${_lines__new}")"; _lines__tone="new" ;;
                    home) _lines__is="new for /home, $(_human "$(_mib_in_plan "${_lines__new}")"), $(_holds_in_plan "${_lines__new}")"; _lines__tone="new" ;;
                esac
            done
            _row line "${_lines__id}" "free" "$(printf "%7s  %-20s  %s" "$(_human "${_lines__mib}")" "free room" "${_lines__is}")" - "${_lines__tone}"
            _lines__rootin="$(printf "%s" "$(_choice root)" | cut -s -d: -f2)"; _lines__homein="$(printf "%s" "$(_choice home)" | cut -s -d: -f2)"
            _lines__clear=""
            [ "${_lines__rootin}" != "${_lines__start}" ] || _lines__clear="root=none"
            [ "${_lines__homein}" != "${_lines__start}" ] || _lines__clear="home=none"
            _row option "${_lines__id}" "${_lines__clear:-use=parts}" "leave it free" "$([ -n "${_lines__clear}" ] || printf current)"
            if [ "${_lines__mib}" -ge "${root_mib}" ]; then
                _lines__sized="$(printf "%s" "$(_choice root)" | cut -s -d: -f3)"
                _row option "${_lines__id}" "root=free:${_lines__start}$([ "${_lines__homein}" != "${_lines__start}" ] || printf " home=none")" \
                    "a new partition for minos: all of this room" "$([ "${_lines__rootin}" = "${_lines__start}" ] && [ -z "${_lines__sized}" ] && printf current)"
                _lines__step="$(_step_mib "${_lines__mib}")"
                _lines__own="${_lines__sized:-$(( (_lines__mib * 3 / 4) / _lines__step * _lines__step ))}"
                [ "${_lines__own}" -ge "${root_mib}" ] || _lines__own="${root_mib}"
                _row option "${_lines__id}" "root=free:${_lines__start}:${_lines__own}$([ "${_lines__homein}" != "${_lines__start}" ] || printf " home=none")" \
                    "a new partition for minos of a size of its own: the rest stays free" "$([ "${_lines__rootin}" = "${_lines__start}" ] && [ -n "${_lines__sized}" ] && printf current)"
                if [ "${_lines__rootin}" = "${_lines__start}" ] && [ -n "${_lines__sized}" ]; then
                    _row size "${_lines__id}" "root=free:${_lines__start}:" "$(_mib_in_plan "${_lines__root}")" "${root_mib}" \
                        "$((_lines__mib - $(_made_on "${1}" | awk -v from="${_lines__start}" -v to="$((_lines__start + _lines__mib))" 'NF == 4 && $4 >= from && $4 < to && $3 != "linux" {sum += $2} END {print sum + 0}')))" "${_lines__step}"
                fi
            fi
            [ "${_lines__mib}" -lt "${home_mib}" ] ||
                _row option "${_lines__id}" "home=free:${_lines__start}$([ "${_lines__rootin}" != "${_lines__start}" ] || printf " root=none")" \
                    "a new partition for /home: all of this room" "$([ "${_lines__homein}" != "${_lines__start}" ] || printf current)"
            for _lines__new in ${_lines__made}; do
                case "$(_role "${_lines__new}")" in
                    root) _fs_line roottype "${_lines__new}" minos ;;
                    home) _fs_line hometype "${_lines__new}" /home ;;
                esac
            done
            continue
        fi
        _lines__kind="$(_kind_now "${_lines__part}")"; _lines__fs="$(_file_system "${_lines__part}")"
        _lines__what="$(printf "%7s  %-20s" "$(_human "${_lines__mib}")" "$(_holds "${_lines__part}" | cut -c1-20)")"
        _lines__label="${_lines__part#/dev/}"
        case "${_lines__kind}" in
            data)
                _lines__is="stays as it is"; _lines__tone="plain"; _lines__clear=""
                if [ "${_lines__part}" = "${_lines__root}" ]; then
                    _lines__clear="root=none"
                    if [ -n "$(_plan format "${_lines__part}")" ]; then _lines__is="erased, for minos, $(_holds_in_plan "${_lines__part}")"; _lines__tone="erase"
                    else _lines__is="minos, over its files"; _lines__tone="new"; fi
                elif [ "${_lines__part}" = "${_lines__home}" ]; then
                    _lines__clear="home=none"
                    if [ -n "$(_plan format "${_lines__part}")" ]; then _lines__is="erased, for /home, $(_holds_in_plan "${_lines__part}")"; _lines__tone="erase"
                    else _lines__is="/home, its files kept"; _lines__tone="new"; fi
                fi
                _lines__note="-"
                [ "${_lines__mib}" -ge "${root_mib}" ] || _lines__note="too small for minos, which needs $(_human "${root_mib}")"
                _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  ${_lines__is}" "${_lines__note}" "${_lines__tone}"
                _row option "${_lines__part}" "${_lines__clear:-use=parts}" "leave it as it is" "$([ -n "${_lines__clear}" ] || printf current)"
                _lines__unhome=""; [ "${_lines__part}" != "${_lines__home}" ] || _lines__unhome=" home=none"
                _lines__unroot=""; [ "${_lines__part}" != "${_lines__root}" ] || _lines__unroot=" root=none"
                if [ "${_lines__mib}" -ge "${root_mib}" ]; then
                    _row option "${_lines__part}" "root=${_lines__part} rootfs=format${_lines__unhome}" "erase it, use it for minos" \
                        "$([ "${_lines__part}" = "${_lines__root}" ] && [ -n "$(_plan format "${_lines__part}")" ] && printf current)"
                    [ "${_lines__fs}" != "${kept_fs}" ] ||
                        _row option "${_lines__part}" "root=${_lines__part} rootfs=keep${_lines__unhome}" "copy minos over its files, not formatted" \
                            "$([ "${_lines__part}" = "${_lines__root}" ] && [ -z "$(_plan format "${_lines__part}")" ] && printf current)"
                fi
                if [ "${_lines__mib}" -ge "${home_mib}" ]; then
                    _row option "${_lines__part}" "home=${_lines__part} homefs=format${_lines__unroot}" "erase it, use it for /home" \
                        "$([ "${_lines__part}" = "${_lines__home}" ] && [ -n "$(_plan format "${_lines__part}")" ] && printf current)"
                    [ "${_lines__fs}" != "${kept_fs}" ] ||
                        _row option "${_lines__part}" "home=${_lines__part} homefs=keep${_lines__unroot}" "use it as /home, its files kept" \
                            "$([ "${_lines__part}" = "${_lines__home}" ] && [ -z "$(_plan format "${_lines__part}")" ] && printf current)"
                fi
                if [ "${_lines__part}" = "${_lines__root}" ]; then _fs_line roottype "${_lines__part}" minos
                elif [ "${_lines__part}" = "${_lines__home}" ]; then _fs_line hometype "${_lines__part}" /home; fi ;;
            esp)
                if [ "${firmware}" != "uefi" ]; then
                    _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  stays as it is" "an EFI system partition: not used, this computer starts by BIOS" off
                elif [ "${_lines__part}" = "${_lines__esp}" ]; then
                    if [ -n "$(_plan format "${_lines__part}")" ]; then
                        _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  erased, for the boot loader" "the EFI system partition: UEFI starts minos from it" erase
                    else
                        _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  kept, minos is added to it" "the EFI system partition: UEFI starts minos from it" plain
                    fi
                    [ "${_lines__fs}" != "vfat" ] ||
                        _row option "${_lines__part}" "esp=${_lines__part} espfs=auto" "keep what it holds, add minos to it" "$([ -n "$(_plan format "${_lines__part}")" ] || printf current)"
                    _row option "${_lines__part}" "esp=${_lines__part} espfs=format" "format it: the boot loaders of other systems on it are erased" \
                        "$([ -z "$(_plan format "${_lines__part}")" ] || printf current)"
                else
                    _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  stays as it is" "an EFI system partition, not the one minos starts from" off
                    _row option "${_lines__part}" "use=parts" "leave it as it is" current
                    _row option "${_lines__part}" "esp=${_lines__part} espfs=auto" "start minos from this one" -
                fi ;;
            bios-boot)
                _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  stays as it is" \
                    "$([ "${firmware}" = "bios" ] && printf "GRUB's own partition: BIOS starts the disk through it" || printf "GRUB's own partition, for BIOS: not used")" off ;;
            *)  _row line "${_lines__part}" "${_lines__label}" "${_lines__what}  stays as it is" "it holds the logical partitions" off ;;
        esac
    done

    #how the computer will start, said in a line: the firmware's partitions are the installer's to see to
    if [ "${firmware}" = "uefi" ]; then
        if [ -z "${_lines__esp}" ]; then
            _row line boot "Boot" "nothing to start from yet" "UEFI needs an EFI system partition: $(_human "${esp_mib}") of free room, or the whole disk" erase
        elif [ -n "$(_plan partition "${_lines__esp}")" ]; then
            _row line boot "Boot" "a new partition, ${_lines__esp#/dev/}, $(_human "${esp_mib}"), in the free room" "the EFI system partition: UEFI starts minos from it" new
        else
            _row line boot "Boot" "by UEFI, from ${_lines__esp#/dev/}$([ "$(_disk_of "${_lines__esp}")" = "${1}" ] || printf ", on another disk")" \
                "the installer sees to it: nothing to set by hand" plain
        fi
    else
        _lines__grub="$(_made_on "${1}" | awk '$3 == "bios-boot" {print $1}')"
        if [ -n "${_lines__grub}" ]; then
            _row line boot "Boot" "by BIOS, through a new partition of 1M for GRUB (${_lines__grub#/dev/})" "a gpt disk needs it: the installer makes it" new
        else
            _row line boot "Boot" "by BIOS, GRUB at the start of ${1#/dev/}" "the installer sees to it: nothing to set by hand" plain
        fi
    fi
}

_edit() { #disk file => the edit verb: choices made a plan in FILE, and its rows
    scratch="$(mktemp)" || _die "no temporary file"
    free="$(_free "${1}")"
    _edit__keyboard="$(_choice keyboard)"; _edit__timezone="$(_choice timezone)"
    #with nothing chosen of the disk, the choices the engine suggests; the file systems chosen go with them
    [ -n "$(printf "%s" "${choices}" | sed 's/keyboard=[^ ]*//; s/timezone=[^ ]*//; s/roottype=[^ ]*//; s/hometype=[^ ]*//; s/ //g')" ] ||
        choices="$(_choices_default "${1}") ${choices}"
    _plan_custom "${1}" > "${scratch}"
    #the keyboard the password was typed with, which is no matter of disks: said as it was chosen
    case "${_edit__keyboard}" in
        "") ;;
        *[!a-zA-Z0-9_:-]*) _die "${_edit__keyboard} is no keyboard" ;;
        *) printf "%s\n" "keyboard $(printf "%s" "${_edit__keyboard}" | tr ':' ' ')" >> "${scratch}"
           choices="${choices} keyboard=${_edit__keyboard}" ;;
    esac
    #and the time zone chosen, the same
    if [ -n "${_edit__timezone}" ]; then
        _is_timezone "${_edit__timezone}" || _die "${_edit__timezone} is no time zone this system has"
        printf "%s\n" "timezone ${_edit__timezone}" >> "${scratch}"
        choices="${choices} timezone=${_edit__timezone}"
    fi
    cat "${scratch}" > "${2}" || _die "cannot write ${2}"
    rm -f "${scratch}"
    plan="${2}"
    _row choices "${choices}"
    _row disk "${1}" "$(lsblk -dno SIZE "${1}" | tr -d ' ')" "$(_model "${1}")" "$(_holds_summary "${1}")"
    _lines "${1}"
    _review "${1}"
}

_user_refusal() { #name => why minos takes no user of that name, in a sentence that says what a name is, since
    #nothing else tells the person; nothing when it takes it. A name is what adduser takes of old and no
    #more (lower case letters, digits, - and _, a letter first, 32 characters at most), and the name of no
    #user and of no group the copied system has: adduser makes a group of the user's name, and stops
    #when there is one
    case "${1}" in
        "") printf "%s\n" "The user needs a name: lower case letters, digits, \"-\" and \"_\", a letter first." ;;
        *" "*) printf "%s\n" "\"${1}\" has a space. A user name is one word: lower case letters, digits, \"-\" and \"_\", a letter first." ;;
        *[A-Z]*) printf "%s\n" "\"${1}\" has capital letters. A user name is in lower case: letters, digits, \"-\" and \"_\", a letter first." ;;
        [!a-z]*) printf "%s\n" "\"${1}\" starts with \"$(printf "%.1s" "${1}")\". A user name starts with a lower case letter; then letters, digits, \"-\" and \"_\"." ;;
        *[!a-z0-9_-]*)
            _user_refusal__odd="$(printf "%s" "${1}" | tr -d 'a-z0-9_-' | cut -c1)"
            case "${_user_refusal__odd}" in
                [\ -~]) printf "%s\n" "\"${1}\" has \"${_user_refusal__odd}\" in it. A user name takes only lower case letters, digits, \"-\" and \"_\"." ;;
                *) printf "%s\n" "\"${1}\" has a character a user name does not take: only lower case letters, digits, \"-\" and \"_\"." ;;
            esac ;;
        ?????????????????????????????????*) printf "%s\n" "That name has ${#1} characters. A user name has 32 at most." ;;
        *)  if grep -q "^${1}:" "${passwd}"; then
                printf "%s\n" "${1} is one of the system's own users: choose another name."
            elif grep -q "^${1}:" "${group}"; then
                printf "%s\n" "${1} is the name of one of the system's groups: choose another name."
            fi ;;
    esac
}

_password_refusal() { #password => why minos does not take it; nothing when it does
    case "${1}" in
        "") printf "%s\n" "The password is empty." ;;
    esac
}

################################################################################
# The plan applied
################################################################################

_format() { #partition fat32|FS label => a new file system on it: FAT with dosfstools or, where a system
    #goes without them, with busybox; another with the mkfs of its line in filesystems, its own defaults
    case "${2}" in
        fat32) if command -v mkfs.vfat >/dev/null 2>&1; then
                   mkfs.vfat -F 32 -n EFI "${1}"
               else
                   busybox mkdosfs -F 32 -n EFI "${1}"
               fi ;;
        *) _format__mkfs="$(_fs_field "${2}" 3)"
           [ -n "${_format__mkfs}" ] || { printf "%s\n" "${2} is no file system the engine makes" >&2; return 1; }
           # shellcheck disable=SC2086 # the command and its options, a word each
           ${_format__mkfs} "${3}" "${1}" ;;
    esac
}

_wait_partitions() { #disk names => true once the kernel has the partitions NAMES (a line, in the order of
    #their numbers) on DISK and no other, within 10 s
    _wait_partitions__waited=0
    until [ "$(for _wait_partitions__file in "/sys/block/${1#/dev/}"/*/partition; do
            [ -f "${_wait_partitions__file}" ] || continue
            _wait_partitions__dir="${_wait_partitions__file%/partition}"
            printf "%s /dev/%s\n" "$(cat "${_wait_partitions__file}")" "${_wait_partitions__dir##*/}"
        done | sort -n | cut -d' ' -f2 | tr '\n' ' ')" = "${2}" ]; do
        _wait_partitions__waited="$((_wait_partitions__waited + 1))"
        [ "${_wait_partitions__waited}" -le 10 ] || return 1
        sleep 1
    done
}

_apply() { #=> plan applied from the top, then minos installed for user with password; 0 when it all worked
    _apply__root="$(_plan_one root)"; _apply__esp="$(_plan_one esp)"; _apply__home="$(_plan_one home)"
    _say "the plan, for ${firmware}:"
    grep -v '^[ \t]*\(#\|$\)' "${plan}" | sed 's/^/  /'
    #the swap the live session turned on where the plan writes: on a disk whose table is written, on a
    #partition that gets a file system
    for _apply__swap in $( { _plan table | cut -d' ' -f1; _plan format | cut -d' ' -f1
            for _apply__part in $(_plan partition | cut -d' ' -f1); do _disk_of "${_apply__part}"; printf "\n"; done
        } | sort -u | while read -r _apply__device; do
            [ ! -b "${_apply__device}" ] || lsblk -lnpo NAME,MOUNTPOINT "${_apply__device}"
        done | awk '$2 == "[SWAP]" {print $1}' | sort -u); do
        _say "turning off the swap on ${_apply__swap}"
        swapoff "${_apply__swap}" || { _say "the swap on ${_apply__swap} could not be turned off"; return 1; }
    done
    for _apply__disk in $(_plan table | cut -d' ' -f1); do
        _apply__table="$(_table_of "${_apply__disk}")"
        _say "partitioning ${_apply__disk}: a new ${_apply__table} table"
        #sfdisk's script: a partition a line, "start, size, type, bootable", the start left to sfdisk. An
        #MBR marks the partition BIOS starts from
        {   printf "%s\n" "label: ${_apply__table}"
            _made_on "${_apply__disk}" | while read -r _apply__part _apply__size _apply__type _; do
                case "${_apply__size}" in rest) _apply__size="" ;; *) _apply__size="${_apply__size}M" ;; esac
                case "${_apply__type}" in
                    esp) _apply__type="U" ;;
                    bios-boot) _apply__type="${bios_boot_type}" ;;
                    *) _apply__type="L" ;;
                esac
                if [ "${_apply__table}" = "dos" ] && [ "${_apply__part}" = "${_apply__root}" ]; then
                    printf "%s\n" ",${_apply__size},${_apply__type},*"
                else
                    printf "%s\n" ",${_apply__size},${_apply__type}"
                fi
            done
        } | sfdisk --wipe always --wipe-partitions always "${_apply__disk}" ||
            { _say "${_apply__disk} could not be partitioned: something may be using it"; return 1; }
        udevadm settle
        #the partitions made are the ones the plan names: the kernel's names, read back
        _apply__made="$(_made_on "${_apply__disk}" | cut -d' ' -f1 | tr '\n' ' ')"
        _wait_partitions "${_apply__disk}" "${_apply__made}" ||
            { _say "${_apply__disk} has not the partitions the plan made: ${_apply__made}"; return 1; }
    done
    #partitions added to a table that stays: each one named, with where it starts and its size, and the
    #ones there left as they are (sfdisk --append). Nothing is wiped by sfdisk: the ones added get a file
    #system below, or GRUB
    for _apply__disk in $(_plan partition | cut -d' ' -f1 | while read -r _apply__part; do _disk_of "${_apply__part}"; printf "\n"; done | sort -u); do
        [ -z "$(_table_of "${_apply__disk}")" ] || continue
        _apply__table="$(_table_now "${_apply__disk}")"
        _say "partitioning ${_apply__disk}: $(_made_on "${_apply__disk}" | cut -d' ' -f1 | tr '\n' ' ')added to its ${_apply__table} table"
        _made_on "${_apply__disk}" | while read -r _apply__part _apply__size _apply__type _apply__start; do
            case "${_apply__type}" in
                esp) _apply__type="U" ;;
                bios-boot) _apply__type="${bios_boot_type}" ;;
                *) _apply__type="L" ;;
            esac
            printf "%s\n" "${_apply__part} : start=${_apply__start}MiB, size=${_apply__size}MiB, type=${_apply__type}"
        done | sfdisk --append --wipe never --wipe-partitions never "${_apply__disk}" ||
            { _say "${_apply__disk} could not be partitioned: something may be using it"; return 1; }
        udevadm settle
        _apply__made="$( { _partitions "${_apply__disk}"; _made_on "${_apply__disk}" | cut -d' ' -f1; } |
            while read -r _apply__part; do printf "%s %s\n" "$(_partition_number "${_apply__part}")" "${_apply__part}"; done |
            sort -n | cut -d' ' -f2 | tr '\n' ' ')"
        _wait_partitions "${_apply__disk}" "${_apply__made}" ||
            { _say "${_apply__disk} has not the partitions the plan made: ${_apply__made}"; return 1; }
        #each one where the plan put it, and of its size
        _made_on "${_apply__disk}" | while read -r _apply__part _apply__size _ _apply__start; do
            read -r _apply__sectors < "/sys/class/block/${_apply__part#/dev/}/start"
            [ "${_apply__sectors}" = "$((_apply__start * 2048))" ] && [ "$(_mib "${_apply__part}")" = "${_apply__size}" ] ||
                { _say "${_apply__part} is not where the plan put it: it starts at sector ${_apply__sectors} and has $(_mib "${_apply__part}")M"; exit 1; }
            wipefs -a -q "${_apply__part}"
        done || return 1
    done
    _plan format | while read -r _apply__part _apply__as; do
        _say "formatting ${_apply__part} as ${_apply__as}"
        _apply__label="minos"; [ "${_apply__part}" != "${_apply__home}" ] || _apply__label="home"
        _format "${_apply__part}" "${_apply__as}" "${_apply__label}" || exit 1
    done || { _say "a partition could not be formatted: what mkfs said is above"; return 1; }
    udevadm settle

    #the password goes to setup on its standard input (-), never on its command line; --now: the one
    #confirmation was the interface's, setup does not count its own seconds down
    set -- live desktop "${_apply__root}" "${user}" -
    [ -z "${_apply__home}" ] || set -- "${@}" "${_apply__home}"
    [ -z "${_apply__esp}" ] || set -- "${@}" --esp "${_apply__esp}"
    #the keyboard the password was typed with: the installed system asks for it with the same one
    _apply__keyboard="$(_plan keyboard | head -n 1 | tr ' ' ':')"
    [ -z "${_apply__keyboard}" ] || set -- "${@}" --keyboard "${_apply__keyboard}"
    _apply__timezone="$(_plan timezone | head -n 1)"
    [ -z "${_apply__timezone}" ] || set -- "${@}" --timezone "${_apply__timezone}"
    set -- "${@}" --now
    if [ -n "${try}" ]; then
        _say "try mode: the disk is ready, and minos would now be installed with"
        printf "%s\n" "  sh ${setup} ${*}"
        return 0
    fi
    _say "installing minos on ${_apply__root}: a few minutes"
    #how far the copy is, for an interface: what the partition of minos holds, of what the system weighs
    (   while sleep 2; do
            _apply__used="$(df -m --output=used "${_apply__root}" 2>/dev/null | awk 'NR == 2 {print $1 + 0}')"
            printf "%s %s\n" "${_apply__used:-0}" "${system_mib}" > "${progress}.new" && mv "${progress}.new" "${progress}"
        done ) &
    _apply__sampler="${!}"
    printf "%s\n" "${password}" | sh "${setup}" "${@}"
    _apply__status="${?}"
    kill "${_apply__sampler}" 2>/dev/null; wait "${_apply__sampler}" 2>/dev/null
    [ "${_apply__status}" = 0 ] ||
        _say "minos could not be installed on ${_apply__root}: the disk is not ready to start from"
    return "${_apply__status}"
}

################################################################################
# Main
################################################################################

try=""; firmware=""
while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --try) try="yes"; shift ;;
        --firmware) [ "${#}" -ge 2 ] || _usage; firmware="${2}"; shift 2 ;;
        -*) _usage ;;
        *) break ;;
    esac
done
[ "${#}" -ge 1 ] || _usage
verb="${1}"; shift
case "${firmware}" in ""|uefi|bios) ;; *) _usage ;; esac
#the keyboard is the session's, not a disk's: asked and set by whoever the session is; and the lists of
#time zones and of file systems are anybody's to read
case "${verb}" in
    keyboard)
        case "${1:-}" in
            "") _keyboard_now ;;
            set) { [ "${#}" -ge 2 ] && [ "${#}" -le 3 ]; } || _usage; _keyboard_set "${2}" "${3:-}" || exit 1 ;;
            keys) { [ -n "${DISPLAY:-}" ] && command -v xmodmap >/dev/null 2>&1; } || exit 1; xmodmap -pke || exit 1 ;;
            *) _usage ;;
        esac
        exit 0 ;;
    keyboards) _keyboard_list; exit 0 ;;
    timezone) _timezone_default; printf "\n"; exit 0 ;;
    timezones) _timezone_list; exit 0 ;;
    filesystems) _fs_list; exit 0 ;;
esac
[ "$(id -u)" = 0 ] || _die "runs as root"

missing=""
for tool in lsblk:util-linux findmnt:util-linux blkid:util-linux wipefs:util-linux blockdev:util-linux \
    swapoff:util-linux sfdisk:fdisk mkfs.ext4:e2fsprogs udevadm:udev; do
    command -v "${tool%:*}" >/dev/null 2>&1 || missing="${missing} ${tool%:*} (package ${tool#*:})"
done
command -v mkfs.vfat >/dev/null 2>&1 || busybox mkdosfs 2>&1 | grep -q -i usage ||
    missing="${missing} mkfs.vfat (package dosfstools)"
[ -z "${missing}" ] || _die "cannot run here, it needs:${missing}"

booted="bios"; [ ! -d /sys/firmware/efi ] || booted="uefi"
if [ -n "${try}" ]; then
    firmware="${firmware:-${booted}}"; passwd="/etc/passwd"; group="/etc/group"
    #about what the live system of the 26.04 ISO takes (1566)
    system_mib=1600
elif [ -f "${setup}" ] && [ -f /rofs/etc/passwd ] && [ -f /cdrom/casper/filesystem.size ]; then
    [ -z "${firmware}" ] || _die "--firmware goes with --try: setup installs for the firmware the session started by"
    #the setup this engine runs takes the password on its standard input, starts with no countdown and
    #is told the keyboard and the time zone
    { grep -q -e '--now)' "${setup}" && grep -q -e '--keyboard)' "${setup}" && grep -q -e '--timezone)' "${setup}"; } ||
        _die "the installer on this medium (${setup}) is older than this engine: it takes no --now, no --keyboard or no --timezone. Nothing was written"
    firmware="${booted}"; passwd="/rofs/etc/passwd"; group="/rofs/etc/group"
    system_mib="$(($(cat /cdrom/casper/filesystem.size) / 1048576))"
else
    _die "this is not the live session of the minos ISO (no ${setup}). With --try the installer can be tried here: the disk chosen is partitioned and formatted for real, and minos is not installed"
fi
#a copy of the live system: what it takes, half as much again for what its first boots add (the kernel
#modules and firmware the ISO left out, the logs), and 1G to work in
root_mib="$((system_mib + system_mib / 2 + 1024))"
#the disk the live session runs from, sda when the medium is /dev/sda or /dev/sda1; a CD is no disk
medium="$(findmnt -no SOURCE /cdrom 2>/dev/null)"
if [ -n "${medium}" ]; then
    _medium__disk="$(lsblk -dno PKNAME "${medium}" 2>/dev/null | tr -d ' ')"
    medium="${_medium__disk:-${medium#/dev/}}"
fi
plan=""; user=""; password=""; choices=""; free=""; watched=""
map="$(mktemp)" || _die "no temporary file"
trap 'rm -f "${map}"' EXIT
trap 'exit 130' INT TERM HUP

case "${verb}" in
    facts)
        applying="$(_applying)"
        printf "%s\n" "firmware ${firmware}" "root-mib ${root_mib}" "esp-mib ${esp_mib}" "system-mib ${system_mib}" \
            "medium ${medium:--}" "try ${try:-no}" "log ${log}" "progress ${progress}" "applying ${applying:--}" \
            "timezone $(_timezone_default)" ;;
    disks)
        [ "${#}" -le 1 ] || _usage
        case "${1:-0}" in *[!0-9]*) _usage ;; esac
        watched="${1:-}"
        _scan; _list_disks ;;
    partitions)
        [ "${#}" -le 1 ] || _usage
        [ "${#}" = 0 ] || _is_disk "${1}" || _die "${1} is not a disk"
        _scan; _list_partitions "${1:-}" ;;
    show)
        [ "${#}" = 1 ] || _usage
        _is_disk "${1}" || _die "${1} is not a disk"
        _scan; _show_disk "${1}" ;;
    needs) _show_needs ;;
    plan)
        _scan
        case "${1:-}" in
            whole) [ "${#}" = 2 ] || _usage; _plan_whole "${2}" ;;
            partitions) { [ "${#}" -ge 2 ] && [ "${#}" -le 4 ]; } || _usage; shift; _plan_partitions "${@}" ;;
            *) _usage ;;
        esac ;;
    edit)
        [ "${#}" -ge 2 ] || _usage
        _is_disk "${1}" || _die "${1} is not a disk"
        _edit__disk="${1}"; _edit__file="${2}"; shift 2
        for _edit__word; do
            case "${_edit__word}" in
                use=*|root=*|rootfs=*|roottype=*|home=*|homefs=*|hometype=*|esp=*|espfs=*|keyboard=*|timezone=*) choices="${choices}${choices:+ }${_edit__word}" ;;
                *) _die "${_edit__word} is no choice" ;;
            esac
        done
        _scan; _edit "${_edit__disk}" "${_edit__file}" ;;
    review|check|describe)
        [ "${#}" -ge 1 ] || _usage
        plan="${1}"; [ -f "${plan}" ] || _die "no plan ${plan}"
        _scan
        case "${verb}" in
            describe) _describe ;;
            review)
                _review__disk="${2:-}"
                [ -n "${_review__disk}" ] || _review__disk="$(_plan_one root)"
                [ -z "${_review__disk}" ] || _is_disk "${_review__disk}" || _review__disk="$(_disk_of "${_review__disk}")"
                _review "${_review__disk:-none}" ;;
            check)
                problems="$(_check)"
                [ -z "${problems}" ] || { printf "%s\n" "${problems}"; exit 1; } ;;
        esac ;;
    user)
        [ "${#}" = 1 ] || _usage
        problems="$(_user_refusal "${1}")"
        [ -z "${problems}" ] || { printf "%s\n" "${problems}"; exit 1; } ;;
    password)
        IFS= read -r password || :
        problems="$(_password_refusal "${password}")"
        [ -z "${problems}" ] || { printf "%s\n" "${problems}"; exit 1; } ;;
    apply)
        [ "${#}" = 2 ] || _usage
        plan="${1}"; user="${2}"; [ -f "${plan}" ] || _die "no plan ${plan}"
        IFS= read -r password || :
        [ -z "$(_applying)" ] || _die "an install is running already (process $(_applying)): what it says is in ${log}"
        _scan
        problems="$(_check; _user_refusal "${user}"; _password_refusal "${password}")"
        [ -z "${problems}" ] || { printf "%s\n" "${problems}" >&2; _die "the plan is not applied: nothing was written"; }
        : > "${log}"; rm -f "${status}" "${progress}"
        printf "%s\n" "${$}" > "${pidfile}"
        trap 'rm -f "${map}" "${pidfile}"' EXIT
        trap 'printf "%s\n" 130 > "${status}"; exit 130' INT TERM HUP
        #what is said goes to the terminal and to the log; _apply's exit status leaves the pipe to tee
        #through descriptor 3
        exec 4>&1
        code="$({ { _apply 2>&1; printf "%s" "${?}" >&3; } | tee -a "${log}" >&4; } 3>&1)"
        exec 4>&-
        printf "%s\n" "${code:-1}" > "${status}"
        exit "${code:-1}" ;;
    empty)
        [ "${#}" = 1 ] || _usage
        [ -n "${try}" ] || _die "empty is for --try"
        _is_disk "${1}" || _die "${1} is not a disk"
        _scan
        problems="$(_disk_refusal "${1}")"
        [ -z "${problems}" ] || _die "${1}: ${problems}"
        # shellcheck disable=SC2046 # device names, a word each
        wipefs -a -q $(_partitions "${1}") "${1}" && blockdev --rereadpt "${1}" && udevadm settle ;;
    *) _usage ;;
esac

