# The installer of the minos ISO, tried without building an ISO: the minos desktop box with a second,
# empty disk of 16 GB for minos to go to, and the installer of this folder one key away, in try mode, in
# a window like the one the ISO's live session opens. The box reads the installer from this folder
# (/vagrant) each time it is opened: a change to it shows the next time, with nothing to rebuild.
#
#   vagrant up      then log in (vagrant / vagrant) and press Win+i
#   vagrant ssh     and there: sh /vagrant/minos-installer --try [--firmware uefi|bios]
#
# In try mode the installer partitions and formats the empty disk for real, shows the command that would
# install minos, and stops; it offers to empty the disk again for the next try. The box starts by BIOS:
# the installer makes its plans as for UEFI unless told (f on its first screen, or --firmware bios).
Vagrant.configure("2") do |config|
  config.vm.box     = "minos/desktop-26.04"
  config.vm.box_url = "https://minos.io/vagrant/desktop-26.04.json"
  # no older than this one: Vagrant starts the box it keeps and only announces a newer one, and a box
  # kept from before lacks later fixes of minos' packages. An environment made from an older box stays
  # on it until it is destroyed and made again
  config.vm.box_version = ">= 2026.11.20.2313"

  target = File.join(__dir__, "target.vdi")
  config.vm.provider "virtualbox" do |vb|
    vb.gui    = true
    vb.memory = 2048
    # one processor: VirtualBox on Hyper-V has frozen Linux guests with two in their first seconds
    vb.cpus   = 1
    # the box's disk controller, SATA, has one port, its own disk's: a second one for the empty disk
    vb.customize ["storagectl", :id, "--name", "SATA", "--portcount", 2]
    unless File.exist?(target)
      vb.customize ["createmedium", "disk", "--filename", target, "--size", 16 * 1024]
    end
    vb.customize ["storageattach", :id, "--storagectl", "SATA", "--port", 1, "--device", 0,
                  "--type", "hdd", "--medium", target]
  end

  # Win+i in the box's i3, as in the live session (iso/build writes the same two lines there, for the
  # installer the ISO carries): the installer's terminal floats in the middle of the screen
  config.vm.provision "shell", inline: <<~'SHELL'
    # the installer draws its own screens and needs nothing the box lacks: sfdisk for its engine, which
    # the ISO's live system carries, comes with the box's fdisk
    command -v sfdisk >/dev/null || { apt-get update -q &&
        DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends fdisk; }
    grep -q minos-installer /etc/i3/config || printf '%s\n' '' \
        '#the installer of the minos ISO, in try mode, from /vagrant' \
        'for_window [class="^URxvt$" instance="^minos-installer$"] floating enable, move position center' \
        '#        $Win+i' \
        'bindcode $Win+31 exec sh /vagrant/minos-installer --window --try' >> /etc/i3/config
    # an i3 that is running already reads its configuration again
    for socket in /home/*/.i3/ipc.sock; do
        [ ! -S "${socket}" ] || i3-msg -s "${socket}" reload
    done
  SHELL
end
