#!/bin/sh
#inside a running minos system, as root: what every minos system must show, whatever made it. A box runs
#it from ci/box-check, the ISO's live session from the probe's CD (iso/live-check). One line per check, in
#the format ci/verdict reads; ci/verdict judges these lines the same way for a box and for the ISO.
#usage: probe-common FLAVOUR USER   => FLAVOUR core or desktop, USER the system's user (vagrant, minos)
#       waits up to $NETWORK_WAIT seconds (60) for an address and a name resolved: a session may come up
#       before its lease

flavour="${1:?usage: probe-common FLAVOUR USER}"; user="${2:?}"
_line() { printf "%-34s %s\\n" "${1}" "${2}"; }

_line "minos-${flavour}" "$(dpkg-query -W -f='${Status} ${Version}' "minos-${flavour}" 2>&1)"
_line "release" "$(. /etc/os-release; printf "%s" "${VERSION}")"
#where apt fetches from, each source with its suites, read from both formats of sources with no package list
#needed: Ubuntu's own archive, whatever mirror the system was built from (ci/mirror)
_line "apt sources" "$(apt-get -o Debug::NoLocking=1 update --print-uris 2>/dev/null |
    sed -n "s|^'\(.*/\)dists/\([^/]*\)/InRelease'.*|\1 \2|p" | sort -u |
    awk '$1 != uri {printf "%s%s", (n++ ? "; " : ""), $1; uri = $1} {printf " %s", $2} END {print ""}')"
#the kernel's metapackage: of those dpkg knows of, the one installed
_line "kernel" "$(uname -r) ($(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'linux-image-virtual' 'linux-image-generic' 'linux-image-generic-hwe-*' 2>/dev/null | awk '$1 ~ /^.i/ {printf "%s%s", (n++ ? " " : ""), $2}'))"
#what runs at idle once the boot is over, before these checks start anything: the memory in use, the
#heaviest processes (a script by its name, not its interpreter's), and each service up with the package
#its unit comes from
timeout 120 systemctl is-system-running --wait >/dev/null 2>&1
_line "memory at idle (MB)" "$(free -m | awk '/^Mem:/ {printf "used %d, available %d of %d", $3, $7, $2}'); heaviest: $(ps -e -o rss=,args= --sort=-rss | head -8 | awk '{
    name = $2; if (name ~ /(python|perl)[0-9.]*$/) for (i = 3; i <= NF; i++) if ($i !~ /^-/) { name = $i; break }
    sub(/.*\//, "", name); printf "%s %.1f, ", name, $1 / 1024 }')"
systemctl list-units --type=service --state=running --no-legend --plain 2>/dev/null | awk '{print $1}' |
    while read -r unit; do printf "%s %s\\n" "${unit}" "$(systemctl show -P FragmentPath "${unit}" 2>/dev/null)"; done > /var/tmp/probe-services
#dpkg knows a unit by the path its package ships it at, /lib or /usr/lib: both are asked, in one call
# shellcheck disable=SC2046 # a list of paths
dpkg -S $(awk '$2 != "" {print $2; sub(/^\/usr/, "", $2); print $2}' /var/tmp/probe-services) > /var/tmp/probe-units 2>/dev/null
_line "services running" "$(awk 'FILENAME ~ /probe-units/ {i = index($0, ": "); owner[substr($0, i + 2)] = substr($0, 1, i - 1); next}
    {u = $1; sub(/\.service$/, "", u); f = $2; o = owner[f]; if (o == "") {sub(/^\/usr/, "", f); o = owner[f]}
     printf "%s (%s), ", u, (o == "" ? "no package" : o)}' /var/tmp/probe-units /var/tmp/probe-services | sed 's/, $//')"
rm -f /var/tmp/probe-services /var/tmp/probe-units

#the network: an address, and a name resolved through the system's resolver (Vagrant, apt and the
#installer all need one)
waited=0
while :; do
    address="$(ip -o -4 addr show scope global | awk '{printf "%s %s ", $2, $4}')"
    resolved="$(getent hosts archive.ubuntu.com | awk '{print $1}' | head -n 1)"
    if { [ -n "${address}" ] && [ -n "${resolved}" ]; } || [ "${waited}" -ge "${NETWORK_WAIT:-60}" ]; then break; fi
    sleep 2; waited="$((waited + 2))"
done
_line "network" "${address:-no address }$(grep -o 'net.ifnames=0' /proc/cmdline)"
_line "dns" "archive.ubuntu.com ${resolved:-NOT RESOLVED} after ${waited}s; $(ip -4 route show default | head -n 1 | cut -d' ' -f1-5); $(resolvectl dns 2>/dev/null | tr '\n' ' ' | tr -s ' ' | cut -c1-100)"
_line "sudo without password (${user})" "$(su - "${user}" -c 'sudo -n true' >/dev/null 2>&1 && echo ok || echo FAIL)"

#does this tmux take minos' configuration, the user's copy? A server of its own (-L probe) loads it, says
#what it finds wrong in it, and is killed. The configuration starts minos' plugins in the background, and
#a plugin's script that calls tmux once its server is gone starts a server of its own, which loads the
#configuration and starts the plugins again; that server has no session, so it ends at once, and its
#plugins start the next one: it never stops, and keeps every processor of the system busy from then on.
#So the server is killed when nothing it started runs any more (what it starts carries its socket in
#TMUX; its panes' shells apart, which live as long as it does; a minute at most), and whatever outlives it
#is killed and said, which fails the check as tmux's own words do. It takes the seconds the plugins take
#to load, and two more
_line "tmux -V" "$(tmux -V 2>&1) ($(dpkg -S "$(readlink -f "$(command -v tmux)")" 2>/dev/null | cut -d: -f1))"
tmux_check="$(cat << 'E=O=F'
tmux -f /dev/null -L probe new-session -d && tmux -L probe source-file ~/.tmux.conf
_panes() { tmux -L probe list-panes -a -F '/proc/#{pane_pid}/environ' 2>/dev/null; }
panes="$(_panes)"
socket="$({ tr '\0' '\n' < "$(printf "%s\n" "${panes:-none}" | head -n 1)"; } 2>/dev/null | sed -n 's/^TMUX=\([^,]*\),.*/\1/p')"
_started() { #=> the processes the check's server started that are running, as /proc/PID/environ, a line each
    [ -n "${socket}" ] || return 0
    grep -l -z "^TMUX=${socket}," /proc/[0-9]*/environ 2>/dev/null | grep -v -x -F "${panes:-none}"
}
#nothing running in two looks a second apart: a script's last act may be to ask the server for another
waited=0; quiet=0
while [ "${quiet}" -lt 2 ] && [ "${waited}" -lt 60 ]; do
    sleep 1; waited="$((waited + 1))"; panes="$(_panes)"
    if [ -n "$(_started)" ]; then quiet=0; else quiet="$((quiet + 1))"; fi
done
tmux -L probe kill-server
#the panes' shells end with the server: a few seconds for them, and what is left then is not theirs. tmux
#itself is not asked again: a command of its own could start the server anew
panes=""; waited=0
while [ -n "$(_started)" ] && [ "${waited}" -lt 5 ]; do sleep 1; waited="$((waited + 1))"; done
left="$(_started)"
if [ -n "${left}" ]; then
    printf "%s processes outlived the check's tmux server and were killed, the first: %s\n" "$(printf "%s\n" "${left}" | grep -c .)" \
        "$({ tr '\0' ' ' < "$(printf "%s\n" "${left}" | head -n 1 | sed 's/environ$/cmdline/')"; } 2>/dev/null | cut -c1-70)"
    #each of them may be starting others meanwhile: until a look finds none, ten seconds at most
    rounds=0
    while [ -n "${left}" ] && [ "${rounds}" -lt 50 ]; do
        for process in ${left}; do process="${process#/proc/}"; kill -9 "${process%/environ}" 2>/dev/null; done
        sleep 0.2; rounds="$((rounds + 1))"; left="$(_started)"
    done
fi
E=O=F
)"
_line "tmux source-file ~/.tmux.conf" "$(su - "${user}" -c "${tmux_check}" 2>&1 | head -3 | tr '\n' ' ' | cut -c1-170 | grep . || echo "no errors")"

#the firmware this boot asked the kernel for, and what there is of it
_line "firmware asked for (dmesg)" "$(dmesg 2>/dev/null | grep -iE 'firmware.*(fail|direct-load|not found)|failed to load.*firmware' | head -3 | tr '\n' ' ' | cut -c1-200 | grep . || echo none); $(find /usr/lib/firmware -type f 2>/dev/null | wc -l) files in /usr/lib/firmware"

if [ "${flavour}" = "desktop" ]; then
    _line "i3 $(i3 --version 2>/dev/null | cut -d' ' -f3)" "$(i3 -C -c /etc/i3/config 2>&1 | grep -ciE 'error') config errors"
    _line "display manager" "$(systemctl is-enabled display-manager.service 2>&1) $(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null)"
    #what comes up on this machine's own screen: slim and its Xorg, on the graphics card's driver
    _line "slim, Xorg" "slim $(systemctl is-active slim 2>&1); Xorg $(pgrep -x Xorg >/dev/null && echo up || echo DOWN) on $(for card in /sys/class/drm/card[0-9]; do [ -e "${card}/device/driver" ] && printf "%s " "$(basename "$(readlink "${card}/device/driver")")"; done | grep . || echo "no graphics card")"
fi

_line "boot" "$(systemd-analyze 2>/dev/null | head -1 | cut -c1-120); slowest: $(systemd-analyze blame 2>/dev/null | head -n 4 | tr -s ' ' | sed 's/^ //' | tr '\n' ',' | sed 's/,$//')"
_line "failed units" "$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{printf "%s ", $1}' | grep . || echo none)"
_line "packages installed" "$(dpkg -l | grep -c '^ii')"
_line "disk used" "$(df -m --output=used / | tail -1) MB of $(df -m --output=size / | tail -1) MB"

