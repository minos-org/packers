#!/bin/sh
#publishes the boxes and the ISOs of a run that passed (.github/workflows/boxes.yml, master only) as the
#one release of this repository: the .box and the .sha256 of each box, the .iso and the .sha256 of each
#ISO. The Vagrant catalogs (minos.io/vagrant/BOX.json, written in minos-org/vagrant) are made to name it,
#and only then are the older releases deleted with their tags: only the newest is kept.
#The tag is the day, YYYY.MM.DD, or YYYY.MM.DD.N when the day has a release or a tag already, the smallest
#N that has neither: a tag is never reused, so a release's URL never serves other bytes than a catalog's
#checksum names. So that a failed publish never leaves the repository without a release, nor a catalog
#naming one that is gone, the new one is first a draft under a name of its own (DAY-draft-RUN), given its
#files and checked against them by the digests GitHub computed; then published under its tag, at this
#commit, and read back; then ci/catalog has the catalogs name it and waits until no one can read one that
#names an older release. Only then are the older releases deleted with their tags.
#usage: ci/publish DIR   => DIR holds NAME.box or NAME.iso and NAME.sha256 of each image, in folders or not
#       needs gh and jq, and GH_TOKEN with write access to $GITHUB_REPOSITORY; the tag points at
#       $GITHUB_SHA (the checkout's HEAD when unset); and what ci/catalog needs (VAGRANT_DEPLOY_KEY, git,
#       curl, ssh)
#       DRAFT=1 stops at the checked draft and deletes nothing but the drafts of earlier runs: a test that
#       publishes nothing, and needs nothing of ci/catalog

repo="${GITHUB_REPOSITORY:?usage: GITHUB_REPOSITORY=OWNER/NAME ci/publish DIR}"
dir="${1:?usage: ci/publish DIR}"
target="${GITHUB_SHA:-$(git -C "$(dirname "${0}")" rev-parse HEAD)}"
server="${GITHUB_SERVER_URL:-https://github.com}"
tmp="$(mktemp -d)" || exit 1
trap 'rm -rf "${tmp}"' EXIT

_line() { printf "%-10s %s\\n" "${1}" "${2}"; }
_die() { printf "%s\\n" "publish: ${*}" >&2; exit 1; }

_releases() { #=> every release of the repository as one JSON array in $tmp/releases, drafts included
    gh api --paginate "repos/${repo}/releases?per_page=100" > "${tmp}/pages" &&
        jq -s 'add // []' "${tmp}/pages" > "${tmp}/releases"
}

_assets() { #$1 jq filter of the release => "SHA256 NAME" of its files, as GitHub computed them, by name
    jq -r "[.[] | select(${1})][0].assets[]? | \"\\(.digest // \"no-digest\" | sub(\"^sha256:\"; \"\")) \\(.name)\"" \
        "${tmp}/releases" | sort -k2
}

_delete_draft() { #$1 id, $2 its name => the draft is gone, or says why not
    gh api -X DELETE "repos/${repo}/releases/${1}" > /dev/null ||
        printf "%s\\n" "publish: the draft ${2} (${1}) stays; delete it by hand" >&2
}

#the files: each .box or .iso listed in its .sha256 and matching it, each under GitHub's 2 GiB per file
find "${dir}" -type f \( -name 'minos-*.box' -o -name 'minos-*.iso' -o -name 'minos-*.sha256' \) |
    sort > "${tmp}/files"
[ -s "${tmp}/files" ] || _die "no minos-*.box, .iso or .sha256 in ${dir}"
dupes="$(sed 's|.*/||' "${tmp}/files" | sort | uniq -d | tr '\n' ' ')"
[ -z "${dupes}" ] || _die "the same name twice: ${dupes}"
bad=0
while IFS= read -r file; do
    name="$(basename "${file}")"; size="$(stat -c %s "${file}")"
    if [ "${size}" -ge 2147483648 ]; then
        printf "%s\\n" "publish: ${name} weighs ${size} B; a release's files must be under 2 GiB" >&2; bad=1
    fi
    case "${name}" in
        *.sha256)
            (cd "$(dirname "${file}")" && sha256sum --quiet --strict -c "${name}") ||
                { printf "%s\\n" "publish: ${name} does not match its files" >&2; bad=1; } ;;
        *)
            awk -v f="${name}" '$2 == f {found = 1} END {exit !found}' "${file%.*}.sha256" 2>/dev/null ||
                { printf "%s\\n" "publish: ${name} is not in ${name%.*}.sha256" >&2; bad=1; } ;;
    esac
done < "${tmp}/files"
[ "${bad}" -eq 0 ] || exit 1
#what each file must be once uploaded, "SHA256 NAME": the .box or the .iso as its .sha256 says
while IFS= read -r file; do
    name="$(basename "${file}")"
    case "${name}" in
        *.sha256) printf "%s %s\\n" "$(sha256sum < "${file}" | cut -d' ' -f1)" "${name}" ;;
        *) awk -v f="${name}" '$2 == f {print $1, f}' "${file%.*}.sha256" ;;
    esac
done < "${tmp}/files" | sort -k2 > "${tmp}/local"
_line "files" "$(wc -l < "${tmp}/files") ($(grep -c '\.box$' "${tmp}/files") boxes, $(grep -c '\.iso$' "${tmp}/files") ISOs), checked against their .sha256, each under 2 GiB"

day="$(date -u +%Y.%m.%d)"
draft="${day}-draft-${GITHUB_RUN_ID:-$$}"

#the notes: what someone needs to use minos from these files, nothing about how they are made
{   isos="$(grep '\.iso$' "${tmp}/files" | sed 's|.*/||')"
    if [ -n "${isos}" ]; then
        printf "%s\\n" "ISO: a live minos-desktop, by BIOS or UEFI (Secure Boot too); Win+i installs minos on a disk, with no network. To a USB stick:" "" \
            "    sudo dd if=$(printf "%s\\n" "${isos}" | tail -n 1) of=/dev/sdX bs=4M conv=fsync status=progress" ""
    fi
    printf "%s\\n" "Vagrant, for VirtualBox (core or desktop, 22.04, 24.04 or 26.04):" "" \
        "    vagrant box add https://minos.io/vagrant/core-24.04.json" \
        "    vagrant init minos/core-24.04 && vagrant up" "" \
        "VirtualBox without Vagrant:" "" \
        "    tar xf minos-core-24.04.box && VBoxManage import box.ovf" ""
    printf "%s\\n" "sha256:" ""
    grep '\.sha256$' "${tmp}/files" | while IFS= read -r sums; do sed 's/^/    /' "${sums}"; done
} > "${tmp}/notes"

#the draft with its files, then what GitHub says it holds. Nothing else has been touched yet: a draft that
#fails is deleted, and the release published before stays
set --
while IFS= read -r file; do set -- "${@}" "${file}"; done < "${tmp}/files"
if ! gh release create "${draft}" --repo "${repo}" --draft --target "${target}" --title "${day}" \
        --notes-file "${tmp}/notes" "${@}" > /dev/null; then
    _releases && id="$(jq -r --arg t "${draft}" '.[] | select(.draft and .tag_name == $t) | .id' "${tmp}/releases")" &&
        [ -n "${id}" ] && _delete_draft "${id}" "${draft}"
    _die "the draft ${draft} did not get its files; the releases published before stay"
fi
_releases || _die "cannot read back the draft ${draft}; it stays, and so do the releases published before"
id="$(jq -r --arg t "${draft}" '.[] | select(.draft and .tag_name == $t) | .id' "${tmp}/releases")"
[ -n "${id}" ] || _die "no draft ${draft} among the releases"
_assets ".draft and .tag_name == \"${draft}\"" > "${tmp}/uploaded"
if ! cmp -s "${tmp}/local" "${tmp}/uploaded"; then
    diff "${tmp}/local" "${tmp}/uploaded" >&2
    _delete_draft "${id}" "${draft}"; _die "the draft ${draft} does not hold the files checked here; the releases published before stay"
fi
_line "draft" "${draft}: $(wc -l < "${tmp}/uploaded") files, the digests GitHub computed match"

#the drafts earlier runs left behind
jq -r --arg t "${draft}" '.[] | select(.draft and .tag_name != $t and (.tag_name | test("^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}-draft-"))) | "\(.id) \(.tag_name)"' \
    "${tmp}/releases" | while read -r old name; do
    gh api -X DELETE "repos/${repo}/releases/${old}" > /dev/null || _die "the draft ${name} (${old}) of an earlier run was not deleted"
    _line "deleted" "${name} (a draft of an earlier run)"
done || exit 1
if [ -n "${DRAFT}" ]; then
    _line "kept" "${draft}, a draft: DRAFT is set, nothing is published"
    exit 0
fi

#the tag: the day, or the day with the smallest .N that no release and no tag of this repository has
gh api --paginate "repos/${repo}/git/matching-refs/tags/${day}" --jq '.[].ref | sub("^refs/tags/"; "")' \
    > "${tmp}/taken" || _die "cannot read the tags named by ${day}; the new release stays the draft ${draft}"
jq -r '.[].tag_name' "${tmp}/releases" >> "${tmp}/taken"
tag="${day}"; n=0
while grep -qxF "${tag}" "${tmp}/taken"; do n=$((n + 1)); tag="${day}.${n}"; done

#the draft published under its tag, which GitHub makes at this commit, as the latest release; then read
#back. The releases published before are still there, and the catalogs still name them
gh api -X PATCH "repos/${repo}/releases/${id}" -f tag_name="${tag}" -f target_commitish="${target}" \
    -f name="${tag}" -F draft=false -f make_latest=true > /dev/null ||
    _die "the draft ${draft} was not published as ${tag}; publish it by hand"
_releases || _die "cannot read back the release ${tag}; the releases published before stay"
_assets "(.draft | not) and .tag_name == \"${tag}\"" > "${tmp}/published"
cmp -s "${tmp}/local" "${tmp}/published" || { diff "${tmp}/local" "${tmp}/published" >&2; _die "the release ${tag} does not hold the files checked here; the releases published before stay"; }
#GitHub makes the tag as it publishes; read it a few times before saying it is missing
tagged=""
for wait in 0 5 10 15; do
    sleep "${wait}"
    if tagged="$(gh api "repos/${repo}/git/ref/tags/${tag}" --jq '.object.sha' 2>/dev/null)"; then break; fi
done
[ -n "${tagged}" ] || _die "no tag ${tag} after the publish; the releases published before stay"
[ "${tagged}" = "${target}" ] || _die "the tag ${tag} points at ${tagged}, not at ${target}; the releases published before stay"
_line "published" "${server}/${repo}/releases/tag/${tag} at ${target}, $(wc -l < "${tmp}/published") files, published $(jq -r --arg t "${tag}" '.[] | select(.tag_name == $t) | .published_at' "${tmp}/releases")"

#the catalogs name the new release, and no one can still read one that names an older: only then may those go
sh "$(dirname "${0}")/catalog" "${tag}" ||
    _die "the release ${tag} is published, the older ones stay, and the catalogs still name a release that exists"

#the releases published before, with their tags
jq -r --arg t "${tag}" '.[] | select((.draft | not) and (.prerelease | not) and .tag_name != $t and
        (.tag_name | test("^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}(\\.[0-9]+)?$"))) | .tag_name' "${tmp}/releases" > "${tmp}/older"
while read -r old; do
    gh release delete "${old}" --repo "${repo}" --cleanup-tag --yes > /dev/null ||
        _die "the release ${old} was not deleted; ${tag} is published and the catalogs name it: delete ${old} and its tag by hand"
    _line "deleted" "${old} and its tag"
done < "${tmp}/older"
if _releases; then
    _line "releases" "$(jq -r '[.[] | .tag_name + (if .draft then " (draft)" else "" end)] | join(" ")' "${tmp}/releases")"
else
    printf "%s\\n" "publish: cannot read the releases back; ${tag} is published" >&2
fi

